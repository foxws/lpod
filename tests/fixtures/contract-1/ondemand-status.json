{
    "contract": 1,
    "ondemand": {
        "enabled": true,
        "listening": true,
        "awake": false,
        "port": 8000,
        "local_port": 18000,
        "app_port": 8000,
        "listen": null,
        "idle_timeout": "10min",
        "workers": [
            "stry-horizon"
        ],
        "idle_check": {
            "container": "stry-horizon",
            "user": "docker",
            "command": "php -d variables_order=EGPCS /app/artisan app:idle"
        },
        "schedule": {
            "container": "stry-schedule",
            "at": [
                "*:00",
                "01:00",
                "02:00"
            ],
            "environment": {
                "APP_COMMAND": "php -d variables_order=EGPCS /app/artisan schedule:run",
                "APP_OPTIMIZE": "false"
            }
        }
    }
}
