{
    "contract": 1,
    "proxy": { "installed": true, "running": true },
    "routes": [
        {
            "application": "stry",
            "role": "app",
            "host": "stry.home.arpa",
            "upstream": "systemd-stry:8000",
            "main": true,
            "target": "host.containers.internal:8000"
        },
        {
            "application": "stry",
            "role": "websockets",
            "host": "ws.stry.home.arpa",
            "upstream": "systemd-stry-reverb:6001",
            "main": false,
            "target": "systemd-stry-reverb:6001"
        },
        {
            "application": "immich",
            "role": "app",
            "host": "photos.home.arpa",
            "upstream": "immich-server:2283",
            "main": true,
            "target": "immich-server:2283"
        }
    ]
}
