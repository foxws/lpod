#!/usr/bin/env bash
# A stand-in for podman that answers from the files in LPOD_TEST_HOST and
# logs every call to LPOD_TEST_LOG, so tests can count what lpod asks...

HOST="${LPOD_TEST_HOST:?}"
echo "podman $*" >> "${LPOD_TEST_LOG:?}"

# Prints the containers of inspect.json whose ID or name is one of the
# arguments, and fails like podman when one of them isn't there...
function inspect_containers {
    local FORMAT="$1"
    shift

    # A container is asked for by its name, or its ID or the start of it...
    # shellcheck disable=SC2016
    local MATCHES='. as $container | $wanted | (. == $container.Name) or ($container.Id | startswith($wanted))'

    jq -r --arg format "$FORMAT" "
        \$ARGS.positional as \$all
        | map(select([\$all[] as \$wanted | ${MATCHES}] | any))
        | if \$format == \"\" then . else .[] | \"\\(.Id)\\t\\(.Image)\" end" --args "$@" < "$HOST/inspect.json"

    local NAME
    for NAME in "$@"; do
        if ! jq -e --arg wanted "$NAME" "any(.[]; ${MATCHES})" "$HOST/inspect.json" > /dev/null; then
            echo "Error: no such container ${NAME}" >&2

            return 125
        fi
    done
}

# Runs "exec [--interactive] [--user USER] [--workdir DIR] NAME COMMAND..."
# on this machine instead of in the container. Like podman, it only passes
# stdin on with --interactive, and fails with 125 for the user "ghost"...
function run_exec {
    local INTERACTIVE=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --interactive) INTERACTIVE=true ;;
            --user)
                if [ "$2" == "ghost" ]; then
                    echo "Error: unable to find user ghost: no matching entries in passwd file" >&2

                    return 125
                fi

                shift
                ;;
            --workdir) shift ;;
            *) break ;;
        esac

        shift
    done

    shift

    if [ "$INTERACTIVE" == true ]; then
        "$@"

        return
    fi

    # lpod closes podman's own stdin too, so it never waits on the SSH
    # session's input...
    if [ "$(readlink /proc/self/fd/0)" != /dev/null ]; then
        echo "podman exec: stdin is open" >> "${LPOD_TEST_LOG:?}"
    fi

    "$@" < /dev/null
}

case "$*" in
    "quadlet list --format json") sed "s|@QUADLETS@|${HOST}/quadlets|g" "$HOST/quadlet-list.json" ;;
    "ps --all --format json") cat "$HOST/ps.json" ;;
    "ps --all --quiet") jq -r '.[].Id[0:12]' "$HOST/ps.json" ;;
    "ps --all --format {{.State}}") jq -r '.[].State' "$HOST/ps.json" ;;
    "pod ps --format json") cat "$HOST/pods.json" ;;
    "images --all --format json"|"images --format json") cat "$HOST/images.json" ;;
    "stats --no-stream --format {{json .}}") cat "$HOST/stats.jsonl" ;;
    "auto-update --dry-run --format json") cat "$HOST/auto-update.json" ;;
    "volume inspect --all") cat "$HOST/volumes.json" ;;
    "network ls --format json") cat "$HOST/networks.json" ;;
    "events --stream=false "*) cat "$HOST/events.jsonl" ;;
    "info --format {{.Store.GraphDriverName}}") cat "$HOST/storage-driver" ;;
    "info --format "*) printf '%s\t%s\t%s\n' "${HOST}/storage" "$(cat "$HOST/storage-driver")" netavark ;;
    "quadlet --help") echo "Manage Quadlets" ;;
    "version --format "*) echo "6.2.0" ;;
    "pull --quiet "*missing*) echo "Error: initializing source docker://${*: -1}: manifest unknown" >&2; exit 125 ;;
    "start "*|"stop "*|"restart "*) echo "$2" ;;
    "exec "*) run_exec "${@:2}" ;;
    "pull --quiet "*) cp "$HOST/images-pulled.json" "$HOST/images.json" ;;
    # A prune prints what it removed, kept in LPOD_TEST_HOST/pruned-KIND, and
    # fails like podman when LPOD_TEST_HOST/prune-fails exists...
    "image prune --all --force"|"container prune --force"|"volume prune --force"|"network prune --force")
        if [ -e "$HOST/prune-fails" ]; then
            echo "Error: cannot prune: database is locked" >&2

            exit 125
        fi

        if [ -f "$HOST/pruned-$1" ]; then
            cat "$HOST/pruned-$1"
        fi
        ;;
    # Podman refuses an image a container uses...
    "image rm -- "*|"image rm "[!-]*)
        if jq -e --arg id "${*: -1}" 'any(.[]; (.Id | startswith($id)) and (.Containers // 0) > 0)' "$HOST/images.json" > /dev/null; then
            echo "Error: image used by container: ${*: -1}" >&2

            exit 2
        fi
        ;;
    "quadlet print "*)
        if [ ! -f "$HOST/quadlets/$3" ]; then
            echo "Error: no such quadlet $3" >&2

            exit 125
        fi

        cat "$HOST/quadlets/$3"
        ;;
    # Removing anything else always works, and the log shows what was removed...
    "quadlet rm "*|"volume rm "*|"image rm "*|"secret rm "*|"network rm "*) ;;
    # The secret's value comes on stdin, and is kept to compare...
    "secret create "*) cat > "$HOST/secret-value" ;;
    "cp "*) ;;
    "container inspect --format "*) shift 3; inspect_containers table "$@" ;;
    "container inspect "*) shift 2; inspect_containers "" "$@" ;;
    *) echo "podman stub: unexpected call: $*" >&2; exit 1 ;;
esac
