#!/usr/bin/env bash

# Substituted with the pushed tag by .github/workflows/release.yml when a
# release asset is built; a plain checkout (git clone or "main" raw file)
# keeps this placeholder...
LPOD_VERSION="dev"

# The version of the JSON contract that "--json" output follows. Tools such
# as Pods refuse a contract they don't know, so a breaking change to any
# "--json" payload bumps it...
LPOD_CONTRACT=1

if [ "$1" == "--version" ] || [ "$1" == "-v" ] || { [ "$1" == "version" ] && [ "$2" != "--json" ]; }; then
    echo "lpod ${LPOD_VERSION}"

    exit 0
fi

UNAMEOUT="$(uname -s)"

# Verify operating system is supported...
if [ "$UNAMEOUT" != "Linux" ]; then
    echo "Unsupported operating system [$(uname -s)]. Laravel Podman requires Linux with systemd; macOS and Windows, including WSL, are not supported." >&2

    exit 1
fi

# Determine if stdout is a terminal...
if test -t 1; then
    # Determine if colors are supported...
    ncolors=$(tput colors)

    if test -n "$ncolors" && test "$ncolors" -ge 8; then
        BOLD="$(tput bold)"
        RED="$(tput setaf 1)"
        YELLOW="$(tput setaf 3)"
        GREEN="$(tput setaf 2)"
        NC="$(tput sgr0)"
    fi
fi

# Function that prints the available commands...
function display_help {
    echo "Laravel Podman ${LPOD_VERSION}"
    echo
    echo "${YELLOW}Usage:${NC}" >&2
    echo "  lpod SERVICE COMMAND [options] [arguments]"
    echo
    echo "SERVICE is the name of a Podman Quadlet service (e.g. the application"
    echo "service, or a sibling service such as 'pgsql'). Unknown commands are"
    echo "passed through to the podman binary."
    echo
    echo "${YELLOW}Lifecycle Commands:${NC}"
    echo "  ${GREEN}lpod my-app up${NC}        Start the 'my-app' service"
    echo "  ${GREEN}lpod my-app down${NC}      Stop the 'my-app' service"
    echo "  ${GREEN}lpod my-app restart${NC}   Restart the 'my-app' service"
    echo "  ${GREEN}lpod my-app status${NC}    Show the status of the 'my-app' service"
    echo "  ${GREEN}lpod my-app secrets${NC}   Parse and set the secrets the installed 'my-app' quadlet needs"
    echo
    echo "${YELLOW}Artisan Commands:${NC}"
    echo "  ${GREEN}lpod my-app artisan ...${NC}          Run an Artisan command"
    echo "  ${GREEN}lpod my-app artisan queue:work${NC}"
    echo
    echo "${YELLOW}PHP Commands:${NC}"
    echo "  ${GREEN}lpod my-app php ...${NC}   Run a snippet of PHP code"
    echo "  ${GREEN}lpod my-app php -v${NC}"
    echo
    echo "${YELLOW}Composer Commands:${NC}"
    echo "  ${GREEN}lpod my-app composer ...${NC}                       Run a Composer command"
    echo "  ${GREEN}lpod my-app composer require laravel/sanctum${NC}"
    echo
    echo "${YELLOW}Node Commands:${NC}"
    echo "  ${GREEN}lpod my-app node ...${NC}         Run a Node command"
    echo "  ${GREEN}lpod my-app node --version${NC}"
    echo
    echo "${YELLOW}NPM Commands:${NC}"
    echo "  ${GREEN}lpod my-app npm ...${NC}        Run a npm command"
    echo "  ${GREEN}lpod my-app npx${NC}            Run a npx command"
    echo "  ${GREEN}lpod my-app npm run prod${NC}"
    echo
    echo "${YELLOW}PNPM Commands:${NC}"
    echo "  ${GREEN}lpod my-app pnpm ...${NC}        Run a pnpm command"
    echo "  ${GREEN}lpod my-app pnpx${NC}            Run a pnpx command"
    echo "  ${GREEN}lpod my-app pnpm run prod${NC}"
    echo
    echo "${YELLOW}Yarn Commands:${NC}"
    echo "  ${GREEN}lpod my-app yarn ...${NC}        Run a Yarn command"
    echo "  ${GREEN}lpod my-app yarn run prod${NC}"
    echo
    echo "${YELLOW}Bun Commands:${NC}"
    echo "  ${GREEN}lpod my-app bun ...${NC}        Run a bun command"
    echo "  ${GREEN}lpod my-app bunx${NC}           Run a bunx command"
    echo "  ${GREEN}lpod my-app bun run prod${NC}"
    echo
    echo "${YELLOW}Debugging:${NC}"
    echo "  ${GREEN}lpod my-app debug ...${NC}          Run an Artisan command in debug mode"
    echo "  ${GREEN}lpod my-app debug queue:work${NC}"
    echo "  ${GREEN}lpod my-app xdebug on [MODE]${NC}   Turn Xdebug on for web requests (default mode: debug) and restart"
    echo "  ${GREEN}lpod my-app xdebug off${NC}         Turn Xdebug off again and restart"
    echo "  ${GREEN}lpod my-app xdebug status${NC}      Show whether Xdebug is on"
    echo
    echo "${YELLOW}Running Tests:${NC}"
    echo "  ${GREEN}lpod my-app test${NC}          Run the PHPUnit tests via the Artisan test command"
    echo "  ${GREEN}lpod my-app phpunit ...${NC}   Run PHPUnit"
    echo "  ${GREEN}lpod my-app pest ...${NC}      Run Pest"
    echo "  ${GREEN}lpod my-app pint ...${NC}      Run Pint"
    echo "  ${GREEN}lpod my-app dusk${NC}          Run the Dusk tests (Requires the laravel/dusk package)"
    echo "  ${GREEN}lpod my-app dusk:fails${NC}    Re-run previously failed Dusk tests (Requires the laravel/dusk package)"
    echo
    echo "${YELLOW}Container CLI:${NC}"
    echo "  ${GREEN}lpod my-app shell${NC}        Start a shell session within the service container"
    echo "  ${GREEN}lpod my-app bash${NC}         Alias for 'lpod my-app shell'"
    echo "  ${GREEN}lpod my-app root-shell${NC}   Start a root shell session within the service container"
    echo "  ${GREEN}lpod my-app root-bash${NC}    Alias for 'lpod my-app root-shell'"
    echo "  ${GREEN}lpod my-app tinker${NC}       Start a new Laravel Tinker session"
    echo
    echo "${YELLOW}Binaries:${NC}"
    echo "  ${GREEN}lpod my-app bin ...${NC}   Run Composer binary scripts from the vendor/bin directory"
    echo "  ${GREEN}lpod my-app run ...${NC}   Run a command within the service container"
    echo
    echo "${YELLOW}Other:${NC}"
    echo "  ${GREEN}lpod my-app open${NC}                     Open the application URL in your browser"
    echo "  ${GREEN}lpod proxy export-cert [PATH]${NC}        Export the proxy's local CA certificate (default: ~/proxy.crt)"
    echo
    echo "${YELLOW}Quadlet Management:${NC}"
    echo "  ${GREEN}lpod install PATH${NC}                      Install Quadlet files (podman quadlet install)"
    echo "  ${GREEN}lpod remove NAME${NC}                       Remove an installed quadlet"
    echo "  ${GREEN}lpod uninstall APPLICATION${NC}             Remove an application and all of its quadlets"
    echo "  ${GREEN}lpod list${NC}                               List installed quadlets"
    echo "  ${GREEN}lpod print NAME${NC}                        Print the generated systemd unit for a quadlet"
    echo "  ${GREEN}lpod reload${NC}                             Reload the systemd manager configuration (daemon-reload)"
    echo "  All of the above (except 'reload') accept any extra flags 'podman quadlet' itself takes (e.g. --replace, --application)."
    echo
    echo "${YELLOW}JSON (for tools such as Pods, needs jq):${NC}"
    echo "  ${GREEN}lpod version --json${NC}                     lpod, Podman and systemd versions, the scope and the contract"
    echo "  ${GREEN}lpod apps [--json]${NC}                      Installed applications and their state"
    echo "  ${GREEN}lpod host [--json]${NC}                      CPU, memory, disk, containers and the next auto-update"
    echo "  ${GREEN}lpod secrets [--json]${NC}                   Secrets, the applications using them, and missing ones"
    echo "  ${GREEN}lpod secret create NAME --stdin${NC}         Create a secret from stdin ([--driver file|pass|shell] [--replace])"
    echo "  ${GREEN}lpod APP status|files|logs --json${NC}       An application's details, Quadlet files or journal ([--lines N] [--since T])"
    echo "  ${GREEN}lpod APP up|down|restart --json${NC}         Start, stop or restart an application ([--no-block]; down --force kills it)"
    echo "  ${GREEN}lpod APP secret add NAME --json${NC}         Give an application a secret (--type env|mount --target TARGET)"
    echo "  ${GREEN}lpod APP redeploy --json${NC}                Pull an application's images and restart it ([--no-block])"
    echo "  ${GREEN}lpod APP remove --json${NC}                  Remove an application ([--volumes] [--images] [--secrets])"
    echo "  ${GREEN}lpod APP ondemand enable --json${NC}         Start an application on its first request, and let it sleep when idle (--port P --app-port P, see the docs)"
    echo "  ${GREEN}lpod APP routes set --stdin --json${NC}      Send hostnames to an application through the Pods proxy (also: routes, routes remove)"
    echo "  ${GREEN}lpod APP timers set --stdin --json${NC}      Start containers of an application on a schedule (also: timers, timers remove, timers run NAME)"
    echo "  ${GREEN}lpod proxy routes --json${NC}                The Pods proxy's state and every application's routes"
    echo "  ${GREEN}lpod proxy settings [set --stdin] --json${NC} The Pods proxy's certificates, ports and image"
    echo "  ${GREEN}lpod proxy certificate --json${NC}           The root certificate of the Pods proxy's local CA"
    echo "  ${GREEN}lpod APP ondemand disable|status --json${NC} Run it all the time again, or show its on-demand settings"
    echo "  ${GREEN}lpod containers --json${NC}                  Every container, managed by Quadlet or not"
    echo "  ${GREEN}lpod containers prune --json${NC}            Remove the stopped containers"
    echo "  ${GREEN}lpod pods --json${NC}                        Every pod, with its application, containers and ports"
    echo "  ${GREEN}lpod container NAME ACTION --json${NC}       Inspect, show the logs or stats of, run a command in, start, stop or restart a container"
    echo "  ${GREEN}lpod events --json${NC}                      Recent container and image events ([--since 24h] [--limit N])"
    echo "  ${GREEN}lpod images [prune] --json${NC}              Images, or remove the ones no container uses"
    echo "  ${GREEN}lpod image pull REF|rm ID --json${NC}        Pull or remove an image"
    echo "  ${GREEN}lpod auto-update --dry-run --json${NC}       Check the registries for image updates"
    echo "  ${GREEN}lpod volumes|networks [prune] --json${NC}    Volumes or networks, or remove the unused ones"
    echo "  ${GREEN}lpod volumes sizes --json${NC}               The disk space each named volume uses (walks every file)"
    echo "  ${GREEN}lpod volume|network rm NAME --json${NC}      Remove a volume or network"
    echo "  ${GREEN}lpod volume export NAME --json${NC}          Write a volume to stdout as a tar archive ([--stop] its applications meanwhile)"
    echo "  ${GREEN}lpod journal --json${NC}                     The journal of every Quadlet unit ([--lines N] [--since T|boot] [--priority N])"
    echo "  ${GREEN}lpod quadlet check --stdin --json${NC}       Check Quadlet files with a dry run"
    echo "  ${GREEN}lpod quadlet install APP --stdin --json${NC} Install Quadlet files as an application ([--replace] [--start])"
    echo "  ${GREEN}lpod quadlet fetch URL --ref REF --json${NC} List the files of a Git repository directory ([--path DIR])"
    echo "  ${GREEN}lpod quadlet catalog URL --ref REF --json${NC} The pods.yml of every application directory of a Git repository"
    echo "  ${GREEN}lpod quadlet tags URL --json${NC}           The tags of a Git repository, newest version first"
    echo "  ${GREEN}lpod quadlet head URL --ref BRANCH --json${NC} The newest commit of a branch of a Git repository"
    echo "  ${GREEN}lpod secret rm NAME [--json]${NC}            Remove a secret"
    echo "  ${GREEN}lpod settings [set] --json${NC}              The auto-update timer and lingering, or change them ([--auto-update on|off] [--schedule S] [--rollback on|off] [--linger on|off])"
    echo
    echo "${YELLOW}Troubleshooting:${NC}"
    echo "  ${GREEN}lpod doctor [--json]${NC}            Check the host for what the services need, and how to fix what's missing"
    echo
    echo "${YELLOW}Updating:${NC}"
    echo "  ${GREEN}lpod self-update [VERSION]${NC}      Upgrade lpod in place (latest, a release such as v2.2.0, or a branch such as main) [--json]"
    echo "  ${GREEN}lpod --version${NC}                  Show the installed version"

    exit 1
}

# Parses the "Secret=" directives off an installed quadlet and prompts for
# each one to create it with "podman secret create" (used by
# "lpod SERVICE secrets")...
function cmd_secrets {
    if [ $# -eq 0 ]; then
        echo "Usage: lpod SERVICE secrets [podman secret create flags...]" >&2

        return 1
    fi

    local SERVICE="$1"
    shift
    local EXTRA_ARGS=("$@")

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local UNIT="${SERVICE%.container}.container"
    local CONTENTS

    # Reads the "Secret=" directives straight from the installed unit, so it
    # works off whatever "lpod install" actually installed rather than a
    # rendered ".quadlets" file that may no longer exist on disk...
    if ! CONTENTS="$("$PODMAN" quadlet print "$UNIT" 2>&1)"; then
        echo "${CONTENTS}" >&2
        echo "Could not print the \"${UNIT}\" quadlet. Run \"lpod install\" first." >&2

        return 1
    fi

    # Parse every "Secret=name,type=...,target=..." directive, grouping
    # targets by secret name (the same secret can be needed under several
    # env var/mount names, e.g. a database password used as both
    # POSTGRES_PASSWORD and PGPASSWORD)...
    local -A SECRET_TYPE
    local -A SECRET_TARGETS
    local LINE

    while IFS= read -r LINE; do
        case "$LINE" in
            Secret=*) ;;
            *) continue ;;
        esac

        local -a PARTS
        IFS=',' read -ra PARTS <<< "${LINE#Secret=}"
        local NAME="${PARTS[0]}"
        local TYPE="mount"
        local TARGET="$NAME"
        local PART

        for PART in "${PARTS[@]:1}"; do
            case "$PART" in
                type=*) TYPE="${PART#type=}" ;;
                target=*) TARGET="${PART#target=}" ;;
            esac
        done

        SECRET_TYPE["$NAME"]="$TYPE"

        if [ -n "${SECRET_TARGETS[$NAME]:-}" ]; then
            SECRET_TARGETS["$NAME"]="${SECRET_TARGETS[$NAME]}, ${TARGET}"
        else
            SECRET_TARGETS["$NAME"]="$TARGET"
        fi
    done <<< "$CONTENTS"

    if [ ${#SECRET_TYPE[@]} -eq 0 ]; then
        echo "No secrets found in ${UNIT}."

        return 0
    fi

    local NAME PATH_INPUT VALUE

    for NAME in "${!SECRET_TYPE[@]}"; do
        if [ "${SECRET_TYPE[$NAME]}" = "mount" ]; then
            read -rp "Enter the file path for ${NAME} (${SECRET_TARGETS[$NAME]}) [.env]: " PATH_INPUT
            PATH_INPUT="${PATH_INPUT:-.env}"

            if [ ! -f "$PATH_INPUT" ]; then
                echo "The file ${PATH_INPUT} does not exist." >&2

                return 1
            fi

            "$PODMAN" secret create "$NAME" - "${EXTRA_ARGS[@]}" < "$PATH_INPUT" || return 1
        else
            read -rsp "Enter the value for ${NAME} (${SECRET_TARGETS[$NAME]}), or leave blank to keep the current value: " VALUE
            echo

            if [ -z "$VALUE" ]; then
                echo "Skipping ${NAME} (kept existing value)."

                continue
            fi

            printf '%s' "$VALUE" | "$PODMAN" secret create "$NAME" - "${EXTRA_ARGS[@]}" || return 1
        fi

        echo "Secret ${NAME} set."
    done
}

# Checks whether a unit is active, in the same scope as the Quadlet units...
function unit_is_active {
    "${SYSTEMCTL_CMD[@]}" --quiet is-active "$1"
}

# Re-runs the installer for this copy of lpod, so it upgrades in place
# ("lpod self-update [VERSION|BRANCH] [--json]"). VERSION is a release
# (latest by default), whose downloads the installer verifies against its
# SHA256SUMS; anything else is a branch of the repository, such as main, to
# test what isn't released yet. The installer is downloaded before it runs,
# so a release or branch that doesn't exist fails instead of running an
# empty script. With --json, the installer's output goes to stderr, and the
# new lpod prints its "version --json"...
function cmd_self_update {
    local TARGET="" JSON=false ARG

    for ARG in "$@"; do
        case "$ARG" in
            --json) JSON=true ;;
            -*) echo "Unknown option: $ARG" >&2; return 1 ;;
            *) TARGET="$ARG" ;;
        esac
    done

    TARGET="${TARGET:-latest}"

    local INSTALLER BRANCH=""
    local REPOSITORY="https://github.com/foxws/lpod"

    if [ "$TARGET" == "latest" ]; then
        INSTALLER="${REPOSITORY}/releases/latest/download/install.sh"
    elif [[ "$TARGET" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$ ]]; then
        INSTALLER="${REPOSITORY}/releases/download/v${TARGET#v}/install.sh"
    elif [[ "$TARGET" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]] && [[ "$TARGET" != *..* ]]; then
        BRANCH="$TARGET"
        INSTALLER="https://raw.githubusercontent.com/foxws/lpod/${BRANCH}/install.sh"
    else
        echo "${TARGET} is neither a release (such as v4.0.0) nor a branch." >&2

        return 1
    fi

    local INSTALL_DIR STAGING
    INSTALL_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    STAGING="$(mktemp)" || return 1

    # shellcheck disable=SC2064
    trap "rm -f '${STAGING}'" RETURN

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --retry 3 -o "$STAGING" "$INSTALLER" 2>/dev/null
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O "$STAGING" "$INSTALLER"
    else
        echo "Neither curl nor wget is installed." >&2

        return 1
    fi

    # shellcheck disable=SC2181
    if [ $? -ne 0 ] || [ ! -s "$STAGING" ]; then
        if [ -n "$BRANCH" ]; then
            echo "Could not download lpod from the branch ${BRANCH}: there's no such branch." >&2
        else
            echo "Could not download lpod ${TARGET}: there's no such release." >&2
        fi

        return 1
    fi

    local INSTALL=(env LPOD_INSTALL_DIR="$INSTALL_DIR" LPOD_VERSION="$TARGET" LPOD_BRANCH="$BRANCH" bash "$STAGING")

    if [ "$JSON" == true ]; then
        "${INSTALL[@]}" >&2 < /dev/null || return 1

        "${INSTALL_DIR}/lpod" version --json

        return
    fi

    "${INSTALL[@]}"
}

# Prints a string as a JSON string, escaping what JSON doesn't allow as is...
function json_string {
    local VALUE="$1"

    VALUE="${VALUE//\\/\\\\}"
    VALUE="${VALUE//\"/\\\"}"
    VALUE="${VALUE//$'\n'/\\n}"
    VALUE="${VALUE//$'\r'/\\r}"
    VALUE="${VALUE//$'\t'/\\t}"

    printf '"%s"' "$VALUE"
}

# Prints a doctor check's outcome, with how to fix it on the next line, or
# collects it for "lpod doctor --json"...
function doctor_report {
    local STATUS="$1"
    local ID="$2"
    local MESSAGE="$3"
    local FIX="${4:-}"

    case "$STATUS" in
        warn) DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
        fail) DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)) ;;
    esac

    if [ "$DOCTOR_FORMAT" == "json" ]; then
        if [ "$STATUS" == "ok" ]; then
            FIX=""
        fi

        DOCTOR_CHECKS+=("{\"id\":$(json_string "$ID"),\"status\":$(json_string "$STATUS"),\"message\":$(json_string "$MESSAGE"),\"fix\":$(json_string "$FIX")}")

        return
    fi

    case "$STATUS" in
        ok) echo "  ${GREEN}✓${NC} ${MESSAGE}" ;;
        warn) echo "  ${YELLOW}!${NC} ${MESSAGE}" ;;
        fail) echo "  ${RED}✗${NC} ${MESSAGE}" ;;
    esac

    if [ -n "$FIX" ] && [ "$STATUS" != "ok" ]; then
        local LINE

        while IFS= read -r LINE; do
            echo "      ${LINE}"
        done <<< "$FIX"
    fi
}

# Checks the host for what the services need, and prints how to fix what's
# missing without changing anything itself, since most fixes need root
# (used by "lpod doctor"). Fails when something stops services from running.
# With "--json", prints the outcomes as JSON instead, for tools to read...
function cmd_doctor {
    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local USER_NAME
    USER_NAME="$(id -un)"

    DOCTOR_FORMAT="text"
    DOCTOR_CHECKS=()
    DOCTOR_WARNINGS=0
    DOCTOR_FAILURES=0

    case "${1:-}" in
        "") ;;
        --json) DOCTOR_FORMAT="json" ;;
        *)
            echo "Unknown option: $1. Usage: lpod doctor [--json]" >&2

            return 1
            ;;
    esac

    if [ "$DOCTOR_FORMAT" == "text" ]; then
        echo "${BOLD}lpod ${LPOD_VERSION} doctor${NC}"
        echo
    fi

    # Podman with Quadlet...
    local VERSION

    if ! VERSION="$("$PODMAN" version --format '{{.Client.Version}}' 2>/dev/null)"; then
        doctor_report fail podman "Podman isn't installed, or doesn't run" "Install podman from your distribution's packages."
    elif [ "${VERSION%%.*}" -lt 6 ] 2>/dev/null || ! "$PODMAN" quadlet --help >/dev/null 2>&1; then
        doctor_report fail podman "Podman ${VERSION} is older than 6.0" "Upgrade to Podman 6.0 or newer."
    else
        doctor_report ok podman "Podman ${VERSION} with Quadlet"
    fi

    # The "--json" commands that tools such as Pods run...
    if command -v jq >/dev/null 2>&1; then
        doctor_report ok jq "jq is installed, for the --json commands (contract ${LPOD_CONTRACT})"
    else
        doctor_report warn jq "jq isn't installed, so the --json commands that tools such as Pods run don't work" "Install jq from your distribution's packages."
    fi

    # "quadlet fetch", "catalog", "tags" and "head" read Git repositories...
    if command -v git >/dev/null 2>&1; then
        doctor_report ok git "git is installed, for installing and updating from Git repositories"
    else
        doctor_report warn git "git isn't installed, so applications can't be installed or updated from Git repositories" "Install git from your distribution's packages."
    fi

    # The systemd manager that runs the Quadlet units...
    if "${SYSTEMCTL_CMD[@]}" show-environment >/dev/null 2>&1; then
        doctor_report ok systemd "The systemd ${SYSTEMD_SCOPE} manager is reachable"
    else
        doctor_report fail systemd "The systemd ${SYSTEMD_SCOPE} manager isn't reachable" "Log in through a real session (not \"su\" or \"sudo -u\"), or use \"machinectl shell ${USER_NAME}@\"."
    fi

    if [ "$(id -u)" -ne 0 ]; then
        # Rootless services only start at boot, and keep running after logout, with linger...
        if [ "$(loginctl show-user "$USER_NAME" --property=Linger --value 2>/dev/null)" == "yes" ]; then
            doctor_report ok linger "Linger is on, so services start at boot"
        else
            doctor_report warn linger "Linger is off, so services stop when you log out and don't start at boot" "loginctl enable-linger ${USER_NAME}"
        fi

        # Rootless containers map their users onto subordinate IDs...
        local ID_FILE
        local MISSING_IDS=()

        for ID_FILE in /etc/subuid /etc/subgid; do
            if ! grep -qE "^(${USER_NAME}|$(id -u)):" "$ID_FILE" 2>/dev/null; then
                MISSING_IDS+=("$ID_FILE")
            fi
        done

        if [ ${#MISSING_IDS[@]} -eq 0 ]; then
            doctor_report ok subids "Subordinate user and group IDs are set up"
        else
            doctor_report fail subids "${USER_NAME} has no entry in ${MISSING_IDS[*]}" "sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 ${USER_NAME}
podman system migrate"
        fi

        # The proxy publishes ports 80 and 443, which are privileged by default...
        local PORT_START
        PORT_START="$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null)"

        if [ -z "$PORT_START" ] || [ "$PORT_START" -le 80 ]; then
            doctor_report ok ports "Rootless containers may publish ports 80 and 443"
        else
            doctor_report warn ports "Rootless containers can't publish ports below ${PORT_START}, which the proxy's 80 and 443 are" "echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/99-lpod.conf
sudo sysctl --system"
        fi
    fi

    # The proxy's local CA, which browsers and the host only accept once trusted...
    if [ "$("$PODMAN" container inspect --format '{{.State.Running}}' systemd-proxy 2>/dev/null)" == "true" ] && command -v openssl >/dev/null 2>&1; then
        local CERTIFICATE
        CERTIFICATE="$(mktemp)"

        if "$PODMAN" cp systemd-proxy:/data/caddy/pki/authorities/local/root.crt "$CERTIFICATE" 2>/dev/null; then
            if openssl verify "$CERTIFICATE" >/dev/null 2>&1; then
                doctor_report ok proxy-certificate "The proxy's local certificate is trusted"
            else
                doctor_report warn proxy-certificate "The proxy's local certificate isn't trusted by this host" "lpod proxy export-cert, then add ~/proxy.crt to your trust store:
https://foxws.nl/laravel-podman/proxy#trusting-the-local-certificate"
            fi
        fi

        rm -f "$CERTIFICATE"
    fi

    # The app's host name, read from the ".env" in the current directory...
    local APP_HOST=""

    if [ -f .env ]; then
        APP_HOST="$(sed -nE 's/^APP_URL=["'\'']?([a-z]+:\/\/)?([^:\/"'\'']+).*/\2/p' .env | tail -n 1)"
    fi

    if [ -n "$APP_HOST" ]; then
        if getent hosts "$APP_HOST" >/dev/null 2>&1; then
            doctor_report ok app-url "${APP_HOST} (APP_URL) resolves"
        else
            doctor_report warn app-url "${APP_HOST} (APP_URL) doesn't resolve" "Add it, and its subdomains, to /etc/hosts:
https://foxws.nl/laravel-podman/proxy#dns"
        fi
    fi

    # Services that failed and stay down until someone looks...
    local FAILED
    FAILED="$("${SYSTEMCTL_CMD[@]}" list-units --failed --plain --no-legend --type=service 2>/dev/null | awk '{ print $1 }')"

    if [ -z "$FAILED" ]; then
        doctor_report ok failed-services "No services have failed"
    else
        doctor_report warn failed-services "These services have failed: $(echo "$FAILED" | paste -sd ' ')" "See why with: journalctl ${SYSTEMD_JOURNAL_SCOPE}-u SERVICE -e"
    fi

    if [ "$DOCTOR_FORMAT" == "json" ]; then
        local CHECKS
        CHECKS="$(IFS=,; echo "${DOCTOR_CHECKS[*]}")"

        echo "{\"contract\":${LPOD_CONTRACT},\"lpod\":$(json_string "$LPOD_VERSION"),\"failures\":${DOCTOR_FAILURES},\"warnings\":${DOCTOR_WARNINGS},\"checks\":[${CHECKS}]}"

        [ "$DOCTOR_FAILURES" -eq 0 ]

        return
    fi

    echo

    if [ "$DOCTOR_FAILURES" -gt 0 ]; then
        echo "${DOCTOR_FAILURES} problem(s) and ${DOCTOR_WARNINGS} warning(s) found."

        return 1
    fi

    if [ "$DOCTOR_WARNINGS" -gt 0 ]; then
        echo "No problems, ${DOCTOR_WARNINGS} warning(s) found."
    else
        echo "Everything looks good."
    fi
}

# Where Quadlet looks for the units "podman quadlet install" installs, and
# their drop-ins...
function quadlet_unit_path {
    if [ "$(id -u)" -eq 0 ]; then
        echo "/etc/containers/systemd"
    else
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd"
    fi
}

# Turns Xdebug on (in MODE, default "debug") or off for a service's web
# requests and workers, with a Quadlet drop-in that sets XDEBUG_MODE, then
# restarts the service if it's running (used by "lpod SERVICE xdebug")...
function cmd_xdebug {
    local SERVICE="$1"
    local ACTION="${2:-status}"
    local MODE="${3:-debug}"
    local DROPIN_PATH
    DROPIN_PATH="$(quadlet_unit_path)/${SERVICE}.container.d"
    local DROPIN="${DROPIN_PATH}/lpod-xdebug.conf"

    case "$ACTION" in
        on)
            mkdir -p "$DROPIN_PATH" || return 1
            printf '[Container]\nEnvironment=XDEBUG_MODE=%s\n' "$MODE" > "$DROPIN" || return 1
            ;;

        off)
            rm -f "$DROPIN"
            rmdir "$DROPIN_PATH" 2>/dev/null
            ;;

        status)
            if [ -f "$DROPIN" ]; then
                echo "Xdebug is on for ${SERVICE} ($(sed -n 's/^Environment=XDEBUG_MODE=//p' "$DROPIN"))."
            else
                echo "Xdebug is off for ${SERVICE}."
            fi

            return 0
            ;;

        *)
            echo "Usage: lpod ${SERVICE} xdebug on [MODE]|off|status" >&2

            return 1
            ;;
    esac

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    if unit_is_active "${SERVICE}.service"; then
        "${SYSTEMCTL_CMD[@]}" restart "${SERVICE}.service" || return 1
    fi

    if [ "$ACTION" == "off" ]; then
        echo "Xdebug is off for ${SERVICE}."

        return 0
    fi

    echo "Xdebug is on for ${SERVICE} (${MODE}). Add XDEBUG_TRIGGER (or XDEBUG_SESSION) to a request to start a session."

    if unit_is_active "${SERVICE}.service" && ! "${LPOD_PODMAN_BINARY:-podman}" exec "systemd-${SERVICE}" php -m 2>/dev/null | grep -qi '^xdebug$'; then
        echo "${YELLOW}The ${SERVICE} image has no Xdebug extension.${NC} Update its Containerfile to install it, and rebuild." >&2
    fi
}

# Whether "--json" is one of the arguments...
function json_requested {
    local ARG

    for ARG in "$@"; do
        if [ "$ARG" == "--json" ]; then
            return 0
        fi
    done

    return 1
}

# The "--json" commands build their output with jq...
function require_jq {
    if ! command -v jq >/dev/null 2>&1; then
        echo "lpod needs jq for this command. Install it from your distribution's packages." >&2

        exit 1
    fi
}

# Prints the outcome of a "--json" command that only changes something...
function json_ok {
    echo "{\"contract\":${LPOD_CONTRACT},\"ok\":true}"
}

# Gives "rootless" or "rootful", the scope the Quadlet units run in...
function quadlet_scope {
    if [ "$(id -u)" -eq 0 ]; then
        echo "rootful"
    else
        echo "rootless"
    fi
}

# Prints the installed Quadlets as JSON, each with the application it belongs
# to ("app"), its name without the extension ("base") and its type ("ext").
# A Quadlet installed without an application is an application of its own...
function quadlet_units_json {
    "${LPOD_PODMAN_BINARY:-podman}" quadlet list --format json | jq '
        map(. + {
            base: (.Name | sub("\\.[^.]+$"; "")),
            ext: (.Name | capture("\\.(?<ext>[^.]+)$").ext)
        })
        | map(. + {app: (if (.App // "") == "" then .base else .App end)})'
}

# Prints the source of every Quadlet in UNITS (the JSON of quadlet_units_json)
# as JSON, with its drop-ins appended, since those can add lines such as
# "Secret="...
function quadlet_sources_json {
    local UNITS="$1"
    local NAME UNIT_PATH DROPIN

    while IFS=$'\t' read -r NAME UNIT_PATH; do
        {
            cat "$UNIT_PATH" 2>/dev/null

            for DROPIN in "$(dirname "$UNIT_PATH")/${NAME}.d"/*.conf "$(quadlet_unit_path)/${NAME}.d"/*.conf; do
                if [ -f "$DROPIN" ] && [ "$DROPIN" != "$UNIT_PATH" ]; then
                    echo
                    cat "$DROPIN"
                fi
            done
        } | jq -Rs --arg name "$NAME" '{name: $name, content: .}'
    done < <(jq -r '.[] | [.Name, .Path] | @tsv' <<< "$UNITS") | jq -s 'unique_by(.name)'
}

# Prints the systemd state of the services of UNITS as JSON...
function unit_states_json {
    local UNITS="$1"
    local SERVICES=()
    local SERVICE

    while IFS= read -r SERVICE; do
        SERVICES+=("$SERVICE")
    done < <(jq -r '.[] | select(.ext == "container" or .ext == "pod" or .ext == "kube") | .UnitName' <<< "$UNITS")

    if [ ${#SERVICES[@]} -eq 0 ]; then
        echo "[]"

        return
    fi

    "${SYSTEMCTL_CMD[@]}" show "${SERVICES[@]}" --property=Id,ActiveState,SubState,Result,StateChangeTimestamp --timestamp=unix | jq -Rs '
        split("\n\n")
        | map(split("\n") | map(select(contains("=")) | capture("^(?<key>[^=]+)=(?<value>.*)$")) | from_entries)
        | map(select(.Id != null))'
}

# Prints every container as JSON, with the systemd unit Quadlet runs it as...
function containers_json {
    "${LPOD_PODMAN_BINARY:-podman}" ps --all --format json | jq '
        map({
            name: .Names[0],
            image: .Image,
            state: .State,
            unit: (.Labels.PODMAN_SYSTEMD_UNIT // null),
            infra: (.IsInfra // false)
        })'
}

# Prints the CPU and memory use of the running containers as JSON...
function container_stats_json {
    "${LPOD_PODMAN_BINARY:-podman}" stats --no-stream --format '{{json .}}' 2>/dev/null | jq -s 'map({name: .Name, cpu: .CPU, memory: .MemUsage})'
}

# The jq definitions that turn the collected units, sources, states,
# containers and stats into applications...
read -r -d '' LPOD_APPLICATIONS_JQ <<'JQ'
def source($name): first($sources[] | select(.name == $name) | .content) // "";
def directives($content; $key): $content | split("\n") | map(select(startswith($key + "=")) | ltrimstr($key + "=") | sub("\\s+$"; ""));
def directive($content; $key): directives($content; $key) | last;
def iso: if . == null or . == "" or . == "n/a" then null else (ltrimstr("@") | tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
def status: if . == "active" then "running" elif . == null then "unknown" else . end;
def port: (capture("^((?<ip>.+):)?(?<host>[0-9-]+):(?<container>[0-9-]+)(/(?<protocol>[a-z]+))?$") // null)
    | if . == null then empty else "\(.ip // "0.0.0.0"):\(.host)->\(.container)/\(.protocol // "tcp")" end;
def image($unit): directive(source($unit.Name); "Image") as $image
    | if $image == null then null
      elif ($image | endswith(".build")) then (directive(source($image); "ImageTag") // $image)
      elif ($image | endswith(".image")) then (directive(source($image); "Image") // $image)
      else $image end;
def container_name($unit): directive(source($unit.Name); "ContainerName") // "systemd-\($unit.base)";
def labels($unit): if $unit == null then {} else
    directives(source($unit.Name); "Label")
    | map(select(startswith("io.foxws.pods.") and contains("=")) | capture("^(?<key>[^=]+)=(?<value>.*)$"))
    | from_entries end;
def state($unit): first($states[] | select(.Id == $unit.UnitName)) // {};

def application:
    . as $all
    | ($all | map(select(.ext == "container"))) as $containers
    | ($all | map(select(.ext == "pod"))) as $pods
    | ($all | map(select(.ext == "kube"))) as $kubes
    | (($pods | sort_by(.Name | length) | first)
        // ($kubes | sort_by(.Name | length) | first)
        // ($containers | sort_by(.Name | length) | first)) as $main
    | select($main != null)
    | (if $main.ext == "container" then $main else ($containers | sort_by(.Name | length) | first) end) as $primary
    | ($all | map(.UnitName)) as $services
    | ($ps | map(select(.unit as $unit | any($services[]; . == $unit)) | select(.infra | not))) as $running
    | ($running | map(.name)) as $names
    | ($stats | map(select(.name as $name | any($names[]; . == $name)))) as $usage
    | state($main) as $state
    | {
        name: $main.app,
        unit: $main.UnitName,
        kind: $main.ext,
        status: ($state.ActiveState | status),
        result: ($state.Result // null),
        since: ($state.StateChangeTimestamp | iso),
        image: ((first($running[] | select(.unit == $primary.UnitName) | .image)) // (if $primary == null then null else image($primary) end)),
        pods: (($pods | length) + ($kubes | length)),
        containers: (if $main.ext == "kube" then ($running | length) else ($containers | length) end),
        ports: ([($containers + $pods)[] | directives(source(.Name); "PublishPort")[] | port] | unique),
        memory: (if ($usage | length) > 0 then ($usage | map(.memory) | add) else null end),
        auto_update: (if $primary == null then null else directive(source($primary.Name); "AutoUpdate") end),
        labels: (labels($primary) + labels($main))
    }
    + {
        detail: {
            path: ($main.Path | sub("/[^/]+$"; "")),
            volumes: ($all | map(select(.ext == "volume") | {name: (directive(source(.Name); "VolumeName") // "systemd-\(.base)"), size: null})),
            secrets: ([$containers[] | directives(source(.Name); "Secret")[] | split(",")[0]] | unique),
            items: ($containers | map(
                . as $unit
                | container_name($unit) as $name
                | (first($ps[] | select(.name == $name)) // null) as $container
                | (first($stats[] | select(.name == $name)) // null) as $use
                | {
                    name: $name,
                    image: ($container.image // image($unit)),
                    state: ($container.state // (state($unit).ActiveState | status)),
                    cpu: ($use.cpu // null),
                    memory: ($use.memory // null)
                }))
        },
        services: [$containers[], $pods[], $kubes[] | .UnitName]
    };
JQ

# Prints every application as JSON, with the internal "detail" and "services"
# keys that "lpod APP status|logs" use. Failed applications get the last
# error their main unit logged...
function applications_json {
    local UNITS SOURCES STATES CONTAINERS STATS APPLICATIONS
    UNITS="$(quadlet_units_json)" || return 1
    SOURCES="$(quadlet_sources_json "$UNITS")"
    STATES="$(unit_states_json "$UNITS")"
    CONTAINERS="$(containers_json)"
    STATS="$(container_stats_json)"

    APPLICATIONS="$(jq -n \
        --slurpfile units <(printf '%s' "$UNITS") \
        --slurpfile sources <(printf '%s' "$SOURCES") \
        --slurpfile states <(printf '%s' "$STATES") \
        --slurpfile ps <(printf '%s' "$CONTAINERS") \
        --slurpfile stats <(printf '%s' "${STATS:-[]}") \
        "\$units[0] as \$units | \$sources[0] as \$sources | \$states[0] as \$states | \$ps[0] as \$ps | \$stats[0] as \$stats | ${LPOD_APPLICATIONS_JQ} \$units | group_by(.app) | map(application)")" || return 1

    local UNIT ERRORS="{}"

    while IFS= read -r UNIT; do
        local MESSAGE
        # shellcheck disable=SC2086
        MESSAGE="$(journalctl ${SYSTEMD_JOURNAL_SCOPE}-u "$UNIT" --priority=err --lines=1 --output=cat --no-pager 2>/dev/null | tail -n 1)"
        ERRORS="$(jq --arg unit "$UNIT" --arg message "$MESSAGE" '. + {($unit): (if $message == "" then null else $message end)}' <<< "$ERRORS")"
    done < <(jq -r '.[] | select(.status == "failed") | .unit' <<< "$APPLICATIONS")

    jq --argjson errors "$ERRORS" 'map(if .status == "failed" then . + {error: $errors[.unit]} else . end)' <<< "$APPLICATIONS"
}

# Prints the application NAME as JSON. NAME is an application, or one of its
# Quadlets without the extension (the SERVICE of the other lpod commands)...
function application_json {
    local NAME="$1"
    local UNITS APPLICATION

    UNITS="$(quadlet_units_json)" || return 1
    APPLICATION="$(jq -r --arg name "$NAME" 'first(.[] | select(.app == $name or .base == $name) | .app) // empty' <<< "$UNITS")"

    if [ -z "$APPLICATION" ]; then
        echo "No application or Quadlet named ${NAME} is installed." >&2

        return 1
    fi

    applications_json | jq -e --arg name "$APPLICATION" 'first(.[] | select(.name == $name))' || {
        echo "${APPLICATION} has no container, pod or kube Quadlet." >&2

        return 1
    }
}

# "lpod version --json"...
function cmd_version_json {
    require_jq

    local PODMAN_VERSION SYSTEMD_VERSION
    PODMAN_VERSION="$("${LPOD_PODMAN_BINARY:-podman}" version --format '{{.Client.Version}}' 2>/dev/null)"
    SYSTEMD_VERSION="$(systemctl --version 2>/dev/null | awk 'NR == 1 { print $2 }')"

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --arg lpod "${LPOD_VERSION#v}" \
        --arg podman "$PODMAN_VERSION" \
        --arg systemd "$SYSTEMD_VERSION" \
        --arg scope "$(quadlet_scope)" \
        --arg user "$(id -un)" \
        --arg hostname "$(hostname)" \
        '{contract: $contract, lpod: $lpod, podman: $podman, systemd: $systemd, scope: $scope, user: $user, hostname: $hostname}'
}

# "lpod apps [--json]": the installed applications, with their state...
function cmd_apps {
    require_jq

    local APPLICATIONS
    APPLICATIONS="$(applications_json)" || return 1

    if json_requested "$@"; then
        jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, applications: map(del(.detail, .services))}' <<< "$APPLICATIONS"

        return
    fi

    jq -r '(["APPLICATION", "STATUS", "UNIT", "IMAGE"], (.[] | [.name, .status, .unit, (.image // "")])) | @tsv' <<< "$APPLICATIONS" | column -t -s $'\t'
}

# The PRETTY_NAME of /etc/os-release, e.g. "Fedora Linux 45 (Server Edition)"...
function os_name {
    awk -F= '$1 == "PRETTY_NAME" { gsub(/^"|"$/, "", $2); print $2 }' /etc/os-release 2>/dev/null
}

# PATH with the home directory written as "~"...
function home_path {
    local PATH_NAME="$1"

    if [ "${PATH_NAME#"$HOME"}" != "$PATH_NAME" ]; then
        echo "~${PATH_NAME#"$HOME"}"
    else
        echo "$PATH_NAME"
    fi
}

# "yes" or "no" for whether systemd keeps the user's services running after
# they log out, or nothing as root, where it doesn't apply...
function linger_state {
    if [ "$(id -u)" -eq 0 ]; then
        return
    fi

    loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null
}

# "lpod host [--json]": CPU, memory and disk use, the container counts, and
# when "podman auto-update" runs next...
function cmd_host {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local CPU_USAGE INFO GRAPH_ROOT STORAGE_DRIVER NETWORK_BACKEND DISK CONTAINERS TIMER UNITS STATES

    # Two samples of /proc/stat, a quarter second apart...
    CPU_USAGE="$({ head -n 1 /proc/stat; sleep 0.25; head -n 1 /proc/stat; } | awk '
        { idle = $5 + $6; total = 0; for (i = 2; i <= NF; i++) total += $i }
        NR == 1 { idle1 = idle; total1 = total }
        NR == 2 { if (total - total1 > 0) printf "%.1f", 100 * (1 - (idle - idle1) / (total - total1)); else print 0 }')"

    INFO="$("$PODMAN" info --format '{{.Store.GraphRoot}}{{"\t"}}{{.Store.GraphDriverName}}{{"\t"}}{{.Host.NetworkBackend}}' 2>/dev/null)"
    IFS=$'\t' read -r GRAPH_ROOT STORAGE_DRIVER NETWORK_BACKEND <<< "$INFO"
    DISK="$(df --block-size=1 --output=used,size "${GRAPH_ROOT:-$HOME}" 2>/dev/null | awk 'NR == 2 { print $1, $2 }')"
    CONTAINERS="$("$PODMAN" ps --all --format '{{.State}}' 2>/dev/null | awk '{ total++ } $1 == "running" { running++ } END { print running + 0, total + 0 }')"
    TIMER="$("${SYSTEMCTL_CMD[@]}" show podman-auto-update.timer --property=ActiveState,NextElapseUSecRealtime --timestamp=unix 2>/dev/null)"
    UNITS="$(quadlet_units_json 2>/dev/null)" || UNITS="[]"
    STATES="$(unit_states_json "${UNITS:-[]}" 2>/dev/null)" || STATES="[]"

    local HOST
    HOST="$(jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --argjson cores "$(nproc)" \
        --argjson usage "${CPU_USAGE:-0}" \
        --argjson load "$(awk '{ printf "[%s,%s,%s]", $1, $2, $3 }' /proc/loadavg)" \
        --argjson memory "$(awk '/^MemTotal:/ { total = $2 } /^MemAvailable:/ { available = $2 } /^SwapTotal:/ { swap = $2 } /^SwapFree:/ { swap_free = $2 } END { printf "[%d,%d,%d,%d]", (total - available) * 1024, total * 1024, (swap - swap_free) * 1024, swap * 1024 }' /proc/meminfo)" \
        --arg path "$GRAPH_ROOT" \
        --argjson disk "[$(echo "${DISK:-0 0}" | tr ' ' ',')]" \
        --slurpfile containers <(printf '%s' "[$(echo "$CONTAINERS" | tr ' ' ',')]") \
        --arg timer "$TIMER" \
        --arg os "$(os_name)" \
        --arg kernel "$(uname -r)" \
        --arg booted "$(awk '/^btime / { print $2 }' /proc/stat)" \
        --arg storage_driver "$STORAGE_DRIVER" \
        --arg network_backend "$NETWORK_BACKEND" \
        --arg quadlet_dir "$(home_path "$(quadlet_unit_path)")" \
        --arg linger "$(linger_state)" \
        --slurpfile states <(printf '%s' "${STATES:-[]}") \
        '$containers[0] as $containers | $states[0] as $states
        | ($timer | split("\n") | map(select(contains("=")) | capture("^(?<key>[^=]+)=(?<value>.*)$")) | from_entries) as $timer
        | def nonempty: if . == "" then null else . end;
        {
            contract: $contract,
            cpu: {cores: $cores, usage: $usage, load: $load},
            memory: {used: $memory[0], total: $memory[1], swap_used: $memory[2], swap_total: $memory[3]},
            disk: {path: $path, used: $disk[0], total: $disk[1]},
            containers: {running: $containers[0], total: $containers[1]},
            auto_update: {
                enabled: ($timer.ActiveState == "active"),
                next_run: (($timer.NextElapseUSecRealtime // "") | if . == "" or . == "n/a" then null else (ltrimstr("@") | tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end)
            },
            system: {
                os: ($os | nonempty),
                kernel: ($kernel | nonempty),
                booted_at: ($booted | if . == "" then null else (tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end),
                storage_driver: ($storage_driver | nonempty),
                network_backend: ($network_backend | nonempty),
                quadlet_dir: $quadlet_dir,
                linger: (if $linger == "yes" then true elif $linger == "no" then false else null end)
            },
            units: {
                active: ($states | map(select(.ActiveState == "active")) | length),
                failed: ($states | map(select(.ActiveState == "failed")) | length)
            }
        }')" || return 1

    if json_requested "$@"; then
        echo "$HOST"

        return
    fi

    jq -r '"CPU: \(.cpu.usage)% of \(.cpu.cores) cores",
        "Memory: \(.memory.used / 1073741824 * 10 | floor / 10) of \(.memory.total / 1073741824 * 10 | floor / 10) GiB",
        "Disk: \(.disk.used / 1073741824 * 10 | floor / 10) of \(.disk.total / 1073741824 * 10 | floor / 10) GiB (\(.disk.path))",
        "Containers: \(.containers.running) of \(.containers.total) running",
        "Auto-update: \(if .auto_update.enabled then "next run \(.auto_update.next_run)" else "off" end)"' <<< "$HOST"
}

# "lpod secrets [--json]": the Podman secrets with the applications whose
# Quadlets use them, and the secrets Quadlets use that don't exist...
function cmd_secret_list {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local UNITS SOURCES IDS SECRETS="[]"

    UNITS="$(quadlet_units_json)" || return 1
    SOURCES="$(quadlet_sources_json "$UNITS")"
    mapfile -t IDS < <("$PODMAN" secret ls --quiet)

    if [ ${#IDS[@]} -gt 0 ]; then
        SECRETS="$("$PODMAN" secret inspect "${IDS[@]}" | jq 'map({name: .Spec.Name, driver: .Spec.Driver.Name, updated_at: (.UpdatedAt | sub("\\.[0-9]+"; "") | sub("Z$"; "+00:00"))})')" || return 1
    fi

    local RESULT
    RESULT="$(jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile units <(printf '%s' "$UNITS") \
        --slurpfile sources <(printf '%s' "$SOURCES") \
        --slurpfile secrets <(printf '%s' "$SECRETS") \
        '$units[0] as $units | $sources[0] as $sources | $secrets[0] as $secrets | ($units | map(select(.ext == "container")) | map(.Name as $name | {
            app,
            secrets: [first($sources[] | select(.name == $name) | .content) // "" | split("\n")[] | select(startswith("Secret=")) | ltrimstr("Secret=") | split(",")[0]]
        })) as $uses
        | def used_by($name): [$uses[] | select(any(.secrets[]; . == $name)) | .app] | unique;
        ($secrets | map(.name)) as $existing
        | {
            contract: $contract,
            secrets: ($secrets | sort_by(.name) | map(. + {used_by: used_by(.name)})),
            missing: ([$uses[].secrets[]] | unique | map(select(. as $name | any($existing[]; . == $name) | not)) | map({name: ., used_by: used_by(.)}))
        }')" || return 1

    if json_requested "$@"; then
        echo "$RESULT"

        return
    fi

    jq -r '(["SECRET", "DRIVER", "USED BY"], (.secrets[] | [.name, .driver, (.used_by | join(", "))]), (.missing[] | [.name, "(missing)", (.used_by | join(", "))])) | @tsv' <<< "$RESULT" | column -t -s $'\t'
}

# "lpod secret create NAME [--driver file|pass|shell] [--replace] --stdin [--json]"
# and "lpod secret rm NAME [--json]". "create"
# creates a secret from stdin only, so its value never shows up in the process
# list or the shell history...
function cmd_secret {
    local ACTION="${1:-}"
    shift

    # "lpod secret rm NAME [--json]"...
    if [ "$ACTION" == "rm" ]; then
        if ! [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$ ]]; then
            echo "Usage: lpod secret rm NAME [--json]" >&2

            return 1
        fi

        "${LPOD_PODMAN_BINARY:-podman}" secret rm "$1" > /dev/null || return 1

        if json_requested "$@"; then
            json_ok
        else
            echo "Secret ${1} removed."
        fi

        return
    fi

    if [ "$ACTION" != "create" ] || [ $# -eq 0 ]; then
        echo "Usage: lpod secret create NAME [--driver file|pass|shell] [--replace] --stdin [--json]" >&2

        return 1
    fi

    local NAME="$1"
    shift

    local DRIVER="file"
    local REPLACE=()
    local STDIN=0
    local JSON=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --driver) DRIVER="${2:-}"; shift ;;
            --replace) REPLACE=(--replace) ;;
            --stdin) STDIN=1 ;;
            --json) JSON=1 ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if ! [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$ ]]; then
        echo "Invalid secret name: ${NAME}. Use letters, digits, \".\", \"_\" and \"-\"." >&2

        return 1
    fi

    case "$DRIVER" in
        file|pass|shell) ;;
        *) echo "Unknown driver: ${DRIVER}. Use file, pass or shell." >&2; return 1 ;;
    esac

    if [ "$STDIN" -eq 0 ]; then
        echo "Pass the secret's value on stdin, with --stdin." >&2

        return 1
    fi

    "${LPOD_PODMAN_BINARY:-podman}" secret create --driver "$DRIVER" "${REPLACE[@]}" "$NAME" - >/dev/null || return 1

    if [ "$JSON" -eq 1 ]; then
        json_ok
    else
        echo "Secret ${NAME} created."
    fi
}

# Writes a Quadlet drop-in that gives the main container of an application a
# secret, next to that container's Quadlet (used by "lpod APP secret add")...
function cmd_app_secret_add {
    local APPLICATION="$1"
    local NAME="$2"
    shift 2

    local TYPE="env"
    local TARGET=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --type) TYPE="${2:-}"; shift ;;
            --target) TARGET="${2:-}"; shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if ! [[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,252}$ ]]; then
        echo "Invalid secret name: ${NAME}." >&2

        return 1
    fi

    case "$TYPE" in
        env)
            if ! [[ "$TARGET" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                echo "An env secret needs --target with an environment variable name." >&2

                return 1
            fi
            ;;
        mount)
            if [ -z "$TARGET" ]; then
                TARGET="$NAME"
            fi

            if ! [[ "$TARGET" =~ ^[A-Za-z0-9_./-]+$ ]]; then
                echo "Invalid mount target: ${TARGET}." >&2

                return 1
            fi
            ;;
        *)
            echo "Unknown type: ${TYPE}. Use env or mount." >&2

            return 1
            ;;
    esac

    local UNITS CONTAINER
    UNITS="$(quadlet_units_json)" || return 1
    CONTAINER="$(jq -r --arg app "$APPLICATION" '
        [.[] | select(.app == $app and .ext == "container")] | sort_by(.Name | length) | first | if . == null then empty else [.Name, .Path] | @tsv end' <<< "$UNITS")"

    if [ -z "$CONTAINER" ]; then
        echo "${APPLICATION} has no container Quadlet to add the secret to." >&2

        return 1
    fi

    local UNIT_NAME="${CONTAINER%%$'\t'*}"
    local UNIT_PATH="${CONTAINER#*$'\t'}"
    local DROPIN_PATH
    DROPIN_PATH="$(dirname "$UNIT_PATH")/${UNIT_NAME}.d"

    mkdir -p "$DROPIN_PATH" || return 1
    printf '[Container]\nSecret=%s,type=%s,target=%s\n' "$NAME" "$TYPE" "$TARGET" > "${DROPIN_PATH}/lpod-secret-${NAME}.conf" || return 1
    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    json_ok
}
# The socket "lpod APP ondemand enable" writes for the application APP. It
# also holds the settings it was enabled with, on its "# lpod-ondemand:"
# line, so "status" and "disable" know what was written...
function ondemand_socket_path {
    echo "${SYSTEMD_UNIT_PATH}/${1}-ondemand.socket"
}

# Prints the on-demand settings of the application APP as JSON, or nothing
# when on-demand is off...
function ondemand_settings {
    local SOCKET
    SOCKET="$(ondemand_socket_path "$1")"

    if [ -f "$SOCKET" ]; then
        sed -n 's/^# lpod-ondemand: //p' "$SOCKET" | head -n 1
    fi
}

# Quotes a word for the command line of a systemd unit, where "%" starts a
# specifier and "$" a variable...
function systemd_word {
    local VALUE="$1"

    VALUE="${VALUE//\\/\\\\}"
    VALUE="${VALUE//\"/\\\"}"
    VALUE="${VALUE//%/%%}"
    VALUE="${VALUE//\$/\$\$}"

    printf '"%s"' "$VALUE"
}

# Whether VALUE is a TCP port, for the option NAME...
function valid_port {
    if ! [[ "$2" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$2" -gt 65535 ]; then
        echo "${1} takes a port number." >&2

        return 1
    fi
}

# Prints the systemd calendar time of a "--schedule-at" time ("*:MM" or
# "HH:MM", in UTC), and with "early", the one 30 seconds before it...
function ondemand_calendar {
    local HOUR="${1%%:*}"
    local MINUTE="${1##*:}"
    local SECOND="00"

    if [ "${2:-}" == "early" ]; then
        SECOND="30"
        MINUTE=$((10#$MINUTE - 1))

        if [ "$MINUTE" -lt 0 ]; then
            MINUTE=59

            if [ "$HOUR" != "*" ]; then
                HOUR=$(((10#$HOUR + 23) % 24))
            fi
        fi

        MINUTE="$(printf '%02d' "$MINUTE")"

        if [ "$HOUR" != "*" ]; then
            HOUR="$(printf '%02d' "$HOUR")"
        fi
    fi

    echo "*-*-* ${HOUR}:${MINUTE}:${SECOND} UTC"
}

# Prints the name and path of the container Quadlet NAME (without the
# extension) of the application APP, from UNITS (quadlet_units_json)...
function ondemand_container_unit {
    jq -r --arg app "$2" --arg name "$3" 'first(.[] | select(.app == $app and .ext == "container" and .base == $name) | [.Name, .Path] | @tsv) // empty' <<< "$1"
}

# "lpod APP ondemand enable --port PORT --app-port PORT --json [...]": lets
# a socket start the application on its first request, and its units sleep
# when it's idle. It writes:
#
# - APP-ondemand.socket, listening on PORT (on every address, or with
#   --listen on that address only), and APP-ondemand.service, a
#   systemd-socket-proxyd that starts the app, forwards to it and exits
#   after --idle-timeout without connections;
# - the drop-in lpod-ondemand.conf for the main unit, which publishes the
#   app's port only on 127.0.0.1:LOCAL_PORT, keeps it from starting at boot
#   and lets it stop once the proxy is gone (StopWhenUnneeded=yes);
# - with --worker, APP-idle.service and APP-idle.timer: every minute, once
#   the app is asleep, the scheduler isn't running and the --idle-command
#   (run in --idle-container) succeeds, it stops the workers, so the
#   services they need can sleep too;
# - with --schedule, SCHEDULE.timer and a drop-in that turns the scheduler
#   container into a oneshot started only at the --schedule-at minutes,
#   with --schedule-env lines (such as the command to run). Each start has
#   a wake-up 30 seconds before it, so the services it needs are up in
#   time, and the drop-in then waits for the due minute...
function cmd_app_ondemand_enable {
    local APPLICATION="$1"
    shift

    local PORT="" APP_PORT="" LISTEN="" IDLE_TIMEOUT="10min"
    local IDLE_CONTAINER="" IDLE_USER="" IDLE_COMMAND="" SCHEDULE=""
    local WORKERS=() SCHEDULE_AT=() SCHEDULE_ENV=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --port) PORT="${2:-}"; valid_port "$1" "$PORT" || return 1; shift ;;
            --app-port) APP_PORT="${2:-}"; valid_port "$1" "$APP_PORT" || return 1; shift ;;
            --listen) LISTEN="${2:-}"; shift ;;
            --idle-timeout) IDLE_TIMEOUT="${2:-}"; shift ;;
            --worker) WORKERS+=("${2:-}"); shift ;;
            --idle-container) IDLE_CONTAINER="${2:-}"; shift ;;
            --idle-user) IDLE_USER="${2:-}"; shift ;;
            --idle-command) IDLE_COMMAND="${2:-}"; shift ;;
            --schedule) SCHEDULE="${2:-}"; shift ;;
            --schedule-at) SCHEDULE_AT+=("${2:-}"); shift ;;
            --schedule-env) SCHEDULE_ENV+=("${2:-}"); shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if [ -z "$PORT" ] || [ -z "$APP_PORT" ]; then
        echo "Pass the port the socket listens on (--port) and the one the app listens on in its container (--app-port)." >&2

        return 1
    fi

    # The app gets the socket's port + 10000 on 127.0.0.1, where the proxy
    # forwards to...
    local LOCAL_PORT=$((PORT + 10000))

    if [ "$LOCAL_PORT" -gt 65535 ]; then
        echo "--port must be 55535 or lower, since the app gets that port + 10000 on 127.0.0.1." >&2

        return 1
    fi

    # An IP address, so the socket can stay on this machine (127.0.0.1)...
    local LISTEN_STREAM="$PORT"

    if [ -n "$LISTEN" ]; then
        if [[ "$LISTEN" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
            LISTEN_STREAM="${LISTEN}:${PORT}"
        elif [[ "$LISTEN" =~ ^[0-9A-Fa-f:]+$ ]] && [[ "$LISTEN" == *:* ]]; then
            LISTEN_STREAM="[${LISTEN}]:${PORT}"
        else
            echo "--listen takes an IP address, such as 127.0.0.1." >&2

            return 1
        fi
    fi

    if [ -z "$IDLE_TIMEOUT" ] || [[ "$IDLE_TIMEOUT" =~ [[:space:]] ]] || ! systemd-analyze timespan -- "$IDLE_TIMEOUT" > /dev/null 2>&1; then
        echo "--idle-timeout takes a systemd time span, such as 10min." >&2

        return 1
    fi

    if [ ${#WORKERS[@]} -eq 0 ] && { [ -n "$IDLE_CONTAINER" ] || [ -n "$IDLE_COMMAND" ] || [ -n "$IDLE_USER" ]; }; then
        echo "The idle check stops the workers, so it needs at least one --worker." >&2

        return 1
    fi

    if { [ -n "$IDLE_CONTAINER" ] && [ -z "$IDLE_COMMAND" ]; } || { [ -z "$IDLE_CONTAINER" ] && [ -n "$IDLE_COMMAND" ]; }; then
        echo "--idle-container and --idle-command go together." >&2

        return 1
    fi

    if [ -n "$IDLE_USER" ] && [ -z "$IDLE_CONTAINER" ]; then
        echo "--idle-user needs --idle-container." >&2

        return 1
    fi

    if [ -n "$IDLE_USER" ] && ! [[ "$IDLE_USER" =~ ^[A-Za-z0-9_][A-Za-z0-9_.:-]*$ ]]; then
        echo "Invalid --idle-user: ${IDLE_USER}." >&2

        return 1
    fi

    if [[ "$IDLE_COMMAND" == *$'\n'* ]]; then
        echo "--idle-command takes one line." >&2

        return 1
    fi

    if [ -z "$SCHEDULE" ] && { [ ${#SCHEDULE_AT[@]} -gt 0 ] || [ ${#SCHEDULE_ENV[@]} -gt 0 ]; }; then
        echo "--schedule-at and --schedule-env need --schedule." >&2

        return 1
    fi

    if [ -n "$SCHEDULE" ] && [ ${#SCHEDULE_AT[@]} -eq 0 ]; then
        echo "Pass the minutes the scheduler runs with --schedule-at, such as \"*:00\" (hourly) or 02:00." >&2

        return 1
    fi

    local TIME

    for TIME in "${SCHEDULE_AT[@]}"; do
        if ! [[ "$TIME" =~ ^(\*|[01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
            echo "--schedule-at takes *:MM or HH:MM, not ${TIME}." >&2

            return 1
        fi
    done

    local VARIABLE

    for VARIABLE in "${SCHEDULE_ENV[@]}"; do
        if ! [[ "$VARIABLE" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || [[ "$VARIABLE" == *$'\n'* ]] || [[ "$VARIABLE" == *'$'* ]]; then
            echo "--schedule-env takes KEY=VALUE on one line, without \$: ${VARIABLE}." >&2

            return 1
        fi
    done

    local APP_NAME MAIN_UNIT KIND
    APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"
    MAIN_UNIT="$(jq -r '.unit' <<< "$APPLICATION")"
    KIND="$(jq -r '.kind' <<< "$APPLICATION")"

    if [ "$KIND" == "kube" ]; then
        echo "On-demand needs a container or pod as the main unit, and ${APP_NAME}'s is a kube." >&2

        return 1
    fi

    local UNITS MAIN_PATH
    UNITS="$(quadlet_units_json)" || return 1
    MAIN_PATH="$(jq -r --arg unit "$MAIN_UNIT" 'first(.[] | select(.UnitName == $unit) | .Path) // empty' <<< "$UNITS")"

    local NAME
    local WORKER_SERVICES=()

    for NAME in "${WORKERS[@]}" "$IDLE_CONTAINER" "$SCHEDULE"; do
        if [ -n "$NAME" ] && [ -z "$(ondemand_container_unit "$UNITS" "$APP_NAME" "$NAME")" ]; then
            echo "${APP_NAME} has no container Quadlet named ${NAME}." >&2

            return 1
        fi
    done

    for NAME in "${WORKERS[@]}"; do
        if [ "${NAME}.service" == "$MAIN_UNIT" ] || [ "$NAME" == "$SCHEDULE" ]; then
            echo "${NAME} can't be a worker: the socket starts the app, and the timer the scheduler." >&2

            return 1
        fi

        WORKER_SERVICES+=("${NAME}.service")
    done

    if [ -n "$SCHEDULE" ] && [ "${SCHEDULE}.service" == "$MAIN_UNIT" ]; then
        echo "The scheduler can't be the main unit." >&2

        return 1
    fi

    local SETTINGS
    SETTINGS="$(jq -cn \
        --argjson port "$PORT" \
        --argjson local_port "$LOCAL_PORT" \
        --argjson app_port "$APP_PORT" \
        --arg listen "$LISTEN" \
        --arg idle_timeout "$IDLE_TIMEOUT" \
        --arg idle_container "$IDLE_CONTAINER" \
        --arg idle_user "$IDLE_USER" \
        --arg idle_command "$IDLE_COMMAND" \
        --arg schedule "$SCHEDULE" \
        --args '
        def list($name): $ARGS.positional | map(select(startswith($name + "=")) | ltrimstr($name + "="));
        {
            port: $port,
            local_port: $local_port,
            app_port: $app_port,
            listen: (if $listen == "" then null else $listen end),
            idle_timeout: $idle_timeout,
            workers: list("worker"),
            idle_check: (if $idle_container == "" then null else {container: $idle_container, user: (if $idle_user == "" then null else $idle_user end), command: $idle_command} end),
            schedule: (if $schedule == "" then null else {
                container: $schedule,
                at: list("at"),
                environment: (list("env") | map(capture("^(?<key>[^=]+)=(?<value>.*)$")) | from_entries)
            } end)
        }' \
        "${WORKERS[@]/#/worker=}" "${SCHEDULE_AT[@]/#/at=}" "${SCHEDULE_ENV[@]/#/env=}")" || return 1

    local SYSTEMCTL_LINE="systemctl"

    if [ "$SYSTEMD_SCOPE" == "user" ]; then
        SYSTEMCTL_LINE="systemctl --user"
    fi

    local SOCKET="${APP_NAME}-ondemand.socket"
    local PROXY="${APP_NAME}-ondemand.service"
    local IDLE_TIMER="${APP_NAME}-idle.timer"
    local WANTS=()

    if [ ${#WORKERS[@]} -gt 0 ]; then
        WANTS+=("$IDLE_TIMER")
    fi

    if [ -n "$SCHEDULE" ]; then
        WANTS+=("${SCHEDULE}.timer")
    fi

    local PROXYD
    PROXYD="$(ondemand_proxyd)" || return 1

    # Enabling again replaces what the last enable wrote, which may name
    # another scheduler...
    local PREVIOUS
    PREVIOUS="$(ondemand_settings "$APP_NAME")"

    if [ -n "$PREVIOUS" ]; then
        ondemand_remove "$APP_NAME" "$MAIN_UNIT" "$PREVIOUS" "$UNITS"
    fi

    mkdir -p "$SYSTEMD_UNIT_PATH" || return 1

    {
        echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
        echo "# lpod-ondemand: ${SETTINGS}"
        echo "[Unit]"
        echo "Description=${APP_NAME} on-demand socket"

        if [ ${#WANTS[@]} -gt 0 ]; then
            echo "Wants=${WANTS[*]}"
        fi

        printf '\n[Socket]\nListenStream=%s\n\n[Install]\nWantedBy=sockets.target\n' "$LISTEN_STREAM"
    } > "${SYSTEMD_UNIT_PATH}/${SOCKET}" || return 1

    {
        echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
        echo "[Unit]"
        echo "Description=${APP_NAME} on-demand proxy"
        echo "Requires=${MAIN_UNIT} ${SOCKET}"
        echo "After=${MAIN_UNIT} ${SOCKET}"
        echo
        echo "[Service]"
        echo "ExecStart=${PROXYD} --exit-idle-time=${IDLE_TIMEOUT} 127.0.0.1:${LOCAL_PORT}"
    } > "${SYSTEMD_UNIT_PATH}/${PROXY}" || return 1

    local MAIN_DROPIN
    MAIN_DROPIN="$(dirname "$MAIN_PATH")/$(basename "$MAIN_PATH").d"
    mkdir -p "$MAIN_DROPIN" || return 1

    {
        echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
        echo "[Unit]"
        echo "StopWhenUnneeded=yes"
        echo
        if [ "$KIND" == "pod" ]; then echo "[Pod]"; else echo "[Container]"; fi
        echo "PublishPort="
        echo "PublishPort=127.0.0.1:${LOCAL_PORT}:${APP_PORT}"
        echo
        echo "[Install]"
        echo "WantedBy="
    } > "${MAIN_DROPIN}/lpod-ondemand.conf" || return 1

    # The idle check: the first conditions skip it while the app is awake or
    # the scheduler runs, then the idle command must succeed, and the app
    # must still be asleep, since a request may have woken it meanwhile.
    # The names and the command are arguments of the fixed scripts, never
    # part of them...
    local IDLE_SERVICE="${SYSTEMD_UNIT_PATH}/${APP_NAME}-idle.service"
    local ASLEEP_SCRIPT="'case \"\$\$(${SYSTEMCTL_LINE} is-active \"\$\$1\")\" in inactive|failed) exit 0;; *) exit 1;; esac' sh ${MAIN_UNIT}"

    if [ ${#WORKERS[@]} -gt 0 ]; then
        {
            echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
            echo "[Unit]"
            echo "Description=${APP_NAME} idle check"
            echo
            echo "[Service]"
            echo "Type=oneshot"
            echo "TimeoutStartSec=50"
            echo "ExecCondition=${SYSTEMCTL_LINE} --quiet is-active ${SOCKET}"
            echo "ExecCondition=/bin/sh -c ${ASLEEP_SCRIPT}"

            if [ -n "$SCHEDULE" ]; then
                echo "ExecCondition=/bin/sh -c '! ${SYSTEMCTL_LINE} --quiet is-active \"\$\$1\" || { echo \"The scheduler is still running.\"; exit 1; }' sh ${SCHEDULE}.service"
            fi

            if [ -n "$IDLE_CONTAINER" ]; then
                local PODMAN_PATH CONTAINER_NAME WORD
                local EXEC_WORDS=()
                PODMAN_PATH="$(command -v "${LPOD_PODMAN_BINARY:-podman}")" || return 1

                local IDLE_PATH
                IDLE_PATH="$(ondemand_container_unit "$UNITS" "$APP_NAME" "$IDLE_CONTAINER")"
                IDLE_PATH="${IDLE_PATH#*$'\t'}"
                CONTAINER_NAME="$(sed -n 's/^ContainerName=//p' "$IDLE_PATH" | tail -n 1 | sed 's/[[:space:]]*$//')"
                CONTAINER_NAME="${CONTAINER_NAME:-systemd-${IDLE_CONTAINER}}"

                EXEC_WORDS+=("$(systemd_word "$PODMAN_PATH")" exec)

                if [ -n "$IDLE_USER" ]; then
                    EXEC_WORDS+=(--user "$(systemd_word "$IDLE_USER")")
                fi

                EXEC_WORDS+=("$(systemd_word "$CONTAINER_NAME")")

                # The command is split on whitespace, without quotes...
                local COMMAND_WORDS
                read -ra COMMAND_WORDS <<< "$IDLE_COMMAND"

                for WORD in "${COMMAND_WORDS[@]}"; do
                    EXEC_WORDS+=("$(systemd_word "$WORD")")
                done

                echo "ExecCondition=/bin/sh -c 'unit=\$\$1; shift; ! ${SYSTEMCTL_LINE} --quiet is-active \"\$\$unit\" || \"\$\$@\" || { echo \"${APP_NAME} has work in progress, keeping its workers running.\"; exit 1; }' sh ${IDLE_CONTAINER}.service ${EXEC_WORDS[*]}"
            fi

            echo "ExecCondition=/bin/sh -c ${ASLEEP_SCRIPT}"
            echo "ExecStart=${SYSTEMCTL_LINE} stop --no-block ${WORKER_SERVICES[*]}"
        } > "$IDLE_SERVICE" || return 1

        {
            echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
            echo "[Unit]"
            echo "Description=${APP_NAME} idle check timer"
            echo "PartOf=${SOCKET}"
            echo
            echo "[Timer]"
            echo "OnCalendar=*-*-* *:*:10"
            echo "AccuracySec=15s"
        } > "${SYSTEMD_UNIT_PATH}/${IDLE_TIMER}" || return 1
    fi

    if [ -n "$SCHEDULE" ]; then
        local SCHEDULE_PATH SCHEDULE_DROPIN
        SCHEDULE_PATH="$(ondemand_container_unit "$UNITS" "$APP_NAME" "$SCHEDULE")"
        SCHEDULE_PATH="${SCHEDULE_PATH#*$'\t'}"
        SCHEDULE_DROPIN="$(dirname "$SCHEDULE_PATH")/$(basename "$SCHEDULE_PATH").d"

        # "schedule:run" only runs the tasks due in the minute it starts in,
        # so the timer fires within a second (AccuracySec=1s), never later,
        # and runs missed while the host was off aren't made up at boot...
        {
            echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."
            echo "[Unit]"
            echo "Description=${APP_NAME} schedule timer"
            echo "PartOf=${SOCKET}"
            echo
            echo "[Timer]"
            echo "Unit=${SCHEDULE}.service"

            for TIME in "${SCHEDULE_AT[@]}"; do
                echo "OnCalendar=$(ondemand_calendar "$TIME")"
            done

            for TIME in "${SCHEDULE_AT[@]}"; do
                echo "OnCalendar=$(ondemand_calendar "$TIME" early)"
            done

            echo "AccuracySec=1s"
        } > "${SYSTEMD_UNIT_PATH}/${SCHEDULE}.timer" || return 1

        # The scheduler needs what the app needs (the main unit's Requires=),
        # since it now runs while the app sleeps...
        local REQUIRES
        REQUIRES="$(sed -n 's/^Requires=//p' "$MAIN_PATH" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"

        mkdir -p "$SCHEDULE_DROPIN" || return 1

        {
            echo "# Written by \"lpod ${APP_NAME} ondemand enable\". See \"On-demand\" in lpod's docs/commands.md."

            if [ -n "$REQUIRES" ]; then
                echo "[Unit]"
                echo "Requires=${REQUIRES}"
                echo "After=${REQUIRES}"
                echo
            fi

            if [ ${#SCHEDULE_ENV[@]} -gt 0 ]; then
                echo "[Container]"

                for VARIABLE in "${SCHEDULE_ENV[@]}"; do
                    VARIABLE="${VARIABLE//\\/\\\\}"
                    VARIABLE="${VARIABLE//\"/\\\"}"
                    VARIABLE="${VARIABLE//%/%%}"
                    echo "Environment=\"${VARIABLE}\""
                done

                echo
            fi

            echo "[Service]"
            echo "Type=oneshot"
            echo "Restart=no"
            echo "ExecStartPre=-/bin/sh -c 'trigger=\$\$(${SYSTEMCTL_LINE} show -P LastTriggerUSec --timestamp=unix \"\$\$1\"); trigger=\$\${trigger#@}; case \"\$\$trigger\" in \"\"|*[!0-9]*) exit 0;; esac; [ \$\$((trigger %% 60)) -ge 30 ] || exit 0; wait=\$\$(( (trigger / 60 + 1) * 60 - \$\$(date +%%s) )); [ \"\$\$wait\" -le 0 ] || exec sleep \"\$\$wait\"' sh ${SCHEDULE}.timer"
            echo "TimeoutStartSec=300"
        } > "${SCHEDULE_DROPIN}/lpod-ondemand.conf" || return 1
    fi

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    # The running app still listens where it did, so every unit of the
    # application stops, and the socket starts it again on the first
    # request. A socket that was already listening only pulls in its timers
    # again when it restarts...
    local SERVICES
    mapfile -t SERVICES < <(jq -r '.services[]' <<< "$APPLICATION")

    "${SYSTEMCTL_CMD[@]}" stop "${SERVICES[@]}" 2> /dev/null
    "${SYSTEMCTL_CMD[@]}" enable "$SOCKET" > /dev/null 2>&1 || return 1
    "${SYSTEMCTL_CMD[@]}" start "$SOCKET" || return 1

    if [ ${#WANTS[@]} -gt 0 ]; then
        "${SYSTEMCTL_CMD[@]}" start "${WANTS[@]}" || return 1
    fi

    # The main route of an application behind the Pods proxy goes to its
    # socket while it's on demand, and to its container otherwise...
    if [ -n "$(routes_settings "$APP_NAME")" ]; then
        routes_apply "$APP_NAME" || return 1
    fi

    json_ok
}

# Finds systemd-socket-proxyd, which isn't on the PATH...
function ondemand_proxyd {
    local CANDIDATE

    for CANDIDATE in "${LPOD_SOCKET_PROXYD_BINARY:-}" /usr/lib/systemd/systemd-socket-proxyd /lib/systemd/systemd-socket-proxyd /usr/libexec/systemd/systemd-socket-proxyd; do
        if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then
            echo "$CANDIDATE"

            return
        fi
    done

    echo "systemd-socket-proxyd was not found. Set LPOD_SOCKET_PROXYD_BINARY to its path." >&2

    return 1
}

# Stops and removes the units and drop-ins "lpod APP ondemand enable" wrote
# with SETTINGS, without a daemon-reload...
function ondemand_remove {
    local APP_NAME="$1"
    local MAIN_UNIT="$2"
    local SETTINGS="$3"
    local UNITS="$4"

    local SCHEDULE
    SCHEDULE="$(jq -r '.schedule.container // empty' <<< "$SETTINGS")"

    local REMOVE=("${APP_NAME}-ondemand.socket" "${APP_NAME}-ondemand.service" "${APP_NAME}-idle.timer" "${APP_NAME}-idle.service")

    if [ -n "$SCHEDULE" ]; then
        REMOVE+=("${SCHEDULE}.timer")
    fi

    "${SYSTEMCTL_CMD[@]}" disable --now "${APP_NAME}-ondemand.socket" > /dev/null 2>&1
    "${SYSTEMCTL_CMD[@]}" stop "${REMOVE[@]}" 2> /dev/null

    local NAME

    for NAME in "${REMOVE[@]}"; do
        rm -f "${SYSTEMD_UNIT_PATH:?}/${NAME}"
    done

    local UNIT_PATH

    while IFS= read -r UNIT_PATH; do
        rm -f "${UNIT_PATH}.d/lpod-ondemand.conf"
        rmdir "${UNIT_PATH}.d" 2> /dev/null
    done < <(jq -r --arg app "$APP_NAME" --arg unit "$MAIN_UNIT" --arg schedule "$SCHEDULE" '.[] | select(.app == $app and (.UnitName == $unit or (.ext == "container" and .base == $schedule))) | .Path' <<< "$UNITS")
}

# "lpod APP ondemand disable --json": removes what "enable" wrote, and starts
# the app again, now at boot too...
function cmd_app_ondemand_disable {
    local APPLICATION="$1"

    local APP_NAME MAIN_UNIT SETTINGS
    APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"
    MAIN_UNIT="$(jq -r '.unit' <<< "$APPLICATION")"
    SETTINGS="$(ondemand_settings "$APP_NAME")"

    if [ -z "$SETTINGS" ]; then
        echo "${APP_NAME} isn't on-demand." >&2

        return 1
    fi

    local UNITS
    UNITS="$(quadlet_units_json)" || return 1

    ondemand_remove "$APP_NAME" "$MAIN_UNIT" "$SETTINGS" "$UNITS"

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1
    "${SYSTEMCTL_CMD[@]}" reset-failed "$MAIN_UNIT" 2> /dev/null
    "${SYSTEMCTL_CMD[@]}" --no-block start "$MAIN_UNIT" || return 1

    # The main route of an application behind the Pods proxy goes to its
    # socket while it's on demand, and to its container otherwise...
    if [ -n "$(routes_settings "$APP_NAME")" ]; then
        routes_apply "$APP_NAME" || return 1
    fi

    json_ok
}

# "lpod APP ondemand status --json": whether the application is on-demand,
# whether its socket listens, whether the app is awake, and the settings it
# was enabled with...
function cmd_app_ondemand_status {
    local APPLICATION="$1"

    local APP_NAME MAIN_UNIT SETTINGS
    APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"
    MAIN_UNIT="$(jq -r '.unit' <<< "$APPLICATION")"
    SETTINGS="$(ondemand_settings "$APP_NAME")"

    local LISTENING=false AWAKE=false

    if [ -n "$SETTINGS" ] && unit_is_active "${APP_NAME}-ondemand.socket"; then
        LISTENING=true
    fi

    if unit_is_active "$MAIN_UNIT"; then
        AWAKE=true
    fi

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --argjson settings "${SETTINGS:-null}" \
        --argjson listening "$LISTENING" \
        --argjson awake "$AWAKE" '
        {
            contract: $contract,
            ondemand: ({enabled: ($settings != null), listening: $listening, awake: $awake}
                + ($settings // {port: null, local_port: null, app_port: null, listen: null, idle_timeout: null, workers: [], idle_check: null, schedule: null}))
        }'
}

# Starts or restarts an application's main unit. An on-demand application's
# main unit has StopWhenUnneeded=yes, so started on its own it stops again
# right away: while it sleeps, this starts its proxy instead, which needs the
# app and keeps it up until --idle-timeout passes without connections, as if
# a request had come in. Restarting an awake app restarts the proxy with it...
function app_start_main {
    local ACTION="$1"
    local APP_NAME="$2"
    local MAIN_UNIT="$3"
    shift 3

    if [ -n "$(ondemand_settings "$APP_NAME")" ] && { [ "$ACTION" == "start" ] || ! unit_is_active "$MAIN_UNIT"; }; then
        "${SYSTEMCTL_CMD[@]}" "$@" start "${APP_NAME}-ondemand.service"

        return
    fi

    "${SYSTEMCTL_CMD[@]}" "$@" "$ACTION" "$MAIN_UNIT"
}

# "lpod APP files remove NAME... --json": removes some of an application's
# files, named as "APP files" names them: a Quadlet (whose unit stops) or a
# drop-in next to one. Every name must be one of the application's files, or
# nothing is removed, and lpod's own drop-ins (lpod-*.conf) are left to the
# commands that wrote them...
function app_files_remove {
    local APP_NAME="$1"
    shift

    local NAMES=() ARG

    for ARG in "$@"; do
        case "$ARG" in
            --json) ;;
            -*) echo "Unknown option: $ARG" >&2; return 1 ;;
            *) NAMES+=("$ARG") ;;
        esac
    done

    if [ ${#NAMES[@]} -eq 0 ]; then
        echo "Usage: lpod APP files remove NAME... --json" >&2

        return 1
    fi

    local UNITS
    UNITS="$(quadlet_units_json)" || return 1

    local QUADLETS=() DROPINS=() NAME QUADLET_PATH

    for NAME in "${NAMES[@]}"; do
        if [[ "$NAME" == */* ]]; then
            local QUADLET="${NAME%%.d/*}" DROPIN="${NAME#*.d/}"

            if [[ "$NAME" != "${QUADLET}.d/${DROPIN}" ]] || ! [[ "$DROPIN" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*\.conf$ ]]; then
                echo "${NAME} isn't a file of ${APP_NAME}." >&2

                return 1
            fi

            if [[ "$DROPIN" == lpod-* ]]; then
                echo "${NAME} was written by lpod, so lpod's own command removes it." >&2

                return 1
            fi

            QUADLET_PATH="$(jq -r --arg app "$APP_NAME" --arg name "$QUADLET" 'first(.[] | select(.app == $app and .Name == $name) | .Path) // empty' <<< "$UNITS")"
            local DROPIN_PATH
            DROPIN_PATH="$(dirname "$QUADLET_PATH")/${QUADLET}.d/${DROPIN}"

            if [ -z "$QUADLET_PATH" ] || [ ! -f "$DROPIN_PATH" ] || [ -L "$DROPIN_PATH" ]; then
                echo "${NAME} isn't a file of ${APP_NAME}." >&2

                return 1
            fi

            DROPINS+=("$DROPIN_PATH")
        else
            if ! jq -e --arg app "$APP_NAME" --arg name "$NAME" 'any(.[]; .app == $app and .Name == $name)' <<< "$UNITS" > /dev/null; then
                echo "${NAME} isn't a file of ${APP_NAME}." >&2

                return 1
            fi

            QUADLETS+=("$NAME")
        fi
    done

    if [ ${#DROPINS[@]} -gt 0 ]; then
        rm -f -- "${DROPINS[@]}" || return 1
    fi

    if [ ${#QUADLETS[@]} -gt 0 ]; then
        "${LPOD_PODMAN_BINARY:-podman}" quadlet rm --force "${QUADLETS[@]}" > /dev/null || return 1
    fi

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    printf '%s\n' "${NAMES[@]}" | jq -R . | jq -s --argjson contract "$LPOD_CONTRACT" '{contract: $contract, removed: .}'
}

# Where the Pods proxy (pods-proxy, a Caddy Quadlet) reads the routes of each
# application, and where its drop-ins go...
function proxy_sites_path {
    echo "${HOME}/.config/pods-proxy/sites"
}

function proxy_caddyfile_path {
    echo "${HOME}/.config/pods-proxy/Caddyfile"
}

function proxy_dropin_path {
    echo "$(quadlet_unit_path)/pods-proxy.container.d"
}

# How the proxy's Caddyfile takes routes: "handlers" when it imports
# sites/*.caddy inside a wildcard site (*.home.example.com, with a
# certificate through a DNS challenge), or else "sites", a site per hostname
# from sites/*.Caddyfile...
function proxy_layout {
    if grep -qE '^[[:space:]]*import[[:space:]]+sites/\*\.caddy([[:space:]]|$)' "$(proxy_caddyfile_path)" 2> /dev/null; then
        echo handlers
    else
        echo sites
    fi
}

# The domain of the proxy's wildcard site (home.example.com for
# "*.home.example.com {"), in the handlers layout...
function proxy_wildcard_domain {
    sed -nE 's/^[[:space:]]*\*\.([A-Za-z0-9.-]+)([[:space:]]*,[^{]*)?[[:space:]]*\{[[:space:]]*$/\1/p' "$(proxy_caddyfile_path)" 2> /dev/null | head -n 1 | tr '[:upper:]' '[:lower:]'
}

# The admin address of the proxy's Caddy when it's a unix socket
# ("admin unix//config/admin.sock|0600" gives unix//config/admin.sock), so
# a reload goes through it...
function proxy_admin_address {
    sed -nE 's/^[[:space:]]*admin[[:space:]]+(unix\/[^[:space:]|]+).*/\1/p' "$(proxy_caddyfile_path)" 2> /dev/null | head -n 1
}

# The file an application's routes are written to in the current layout...
function routes_site_path {
    if [ "$(proxy_layout)" == "handlers" ]; then
        echo "$(proxy_sites_path)/${1}.caddy"
    else
        echo "$(proxy_sites_path)/${1}.Caddyfile"
    fi
}

# The routes "APP routes set" stored, as JSON, or nothing. They're read from
# either layout's file, so switching layouts keeps them...
function routes_settings {
    local SITE

    for SITE in "$(proxy_sites_path)/${1}.caddy" "$(proxy_sites_path)/${1}.Caddyfile"; do
        if [ -f "$SITE" ] && grep -q '^# lpod-routes: ' "$SITE"; then
            sed -n 's/^# lpod-routes: //p' "$SITE" | head -n 1

            return
        fi
    done
}

# The routes of APP_NAME with the upstream each one really goes to: the main
# route of an on-demand application goes to its socket on the host, so a
# request wakes it, and a route "via": "main" goes where the main route goes.
# A socket on a loopback address (ondemand enable --listen 127.0.0.1) can't
# be reached from the proxy container, so the main route then goes to the
# container instead: it works while the application is awake, and gets a
# 502 while it sleeps...
function routes_with_targets {
    local APP_NAME="$1" ROUTES="$2"
    local ONDEMAND
    ONDEMAND="$(ondemand_settings "$APP_NAME")"

    jq --argjson ondemand "${ONDEMAND:-null}" '
        (first(.[] | select(.main)) // null) as $main
        | ($ondemand != null and (($ondemand.listen // "") | test("^(127\\.|::1$)"))) as $loopback
        | (if $main == null then null elif $ondemand != null and ($loopback | not) then "host.containers.internal:\($ondemand.port)" else $main.upstream end) as $main_target
        | map(. + {via: (.via // null)})
        | map(. + {target: (if .main or .via == "main" then $main_target else .upstream end)})
    ' <<< "$ROUTES"
}

# Prints the Caddy config of an application's routes: the main route and the
# routes "via" it share one matcher or site, and each other route gets its
# own. Every reverse_proxy keeps WebSockets open for 5 minutes after a
# reload, since lpod reloads Caddy whenever routes change...
function routes_caddy {
    local APP_NAME="$1" LAYOUT="$2" ROUTES="$3"

    routes_with_targets "$APP_NAME" "$ROUTES" | jq -r --arg app "$APP_NAME" --arg layout "$LAYOUT" '
        def proxy($target): "\treverse_proxy \($target) {\n\t\tstream_close_delay 5m\n\t}\n";
        ([.[] | select(.main or .via == "main")]) as $grouped
        | ([.[] | select((.main or .via == "main") | not)]) as $rest
        | ([if ($grouped | length) > 0 then {name: $app, hosts: [$grouped[].host], target: $grouped[0].target, main: true} else empty end]
            + [$rest[] | {name: "\($app)-\(.role)", hosts: [.host], target, main: false}]) as $blocks
        | $blocks[]
        | if $layout == "handlers" then
            "\n@\(.name) host \(.hosts | join(" "))\nhandle @\(.name) {\n" + proxy(.target) + "}"
          else
            "\n" + (.hosts | map("{$PROXY_SCHEME:https}://\(.)") | join(", ")) + " {\n" + (if .main then "\tencode zstd gzip\n" else "" end) + proxy(.target) + "}"
          end
    '
}

# Reloads the proxy's Caddy, through its admin socket when it has one. Caddy
# logs every reload on stderr ("using config from file"), which only matters
# when the reload fails, so that's the only time it's shown...
function proxy_reload {
    local ADDRESS OUTPUT
    ADDRESS="$(proxy_admin_address)"

    if ! OUTPUT="$("${LPOD_PODMAN_BINARY:-podman}" exec systemd-pods-proxy caddy reload --config /etc/caddy/Caddyfile ${ADDRESS:+--address "$ADDRESS"} 2>&1 > /dev/null)"; then
        printf '%s\n' "$OUTPUT" >&2

        return 1
    fi
}

# Writes the routes file of an application in the current layout, or removes
# it when the application has no routes...
function routes_write_site {
    local APP_NAME="$1" ROUTES="$2"

    rm -f "$(proxy_sites_path)/${APP_NAME}.caddy" "$(proxy_sites_path)/${APP_NAME}.Caddyfile"

    if [ -z "$ROUTES" ] || [ "$(jq 'length' <<< "$ROUTES")" -eq 0 ]; then
        return
    fi

    mkdir -p "$(proxy_sites_path)" || return 1

    {
        echo "# Written by \"lpod ${APP_NAME} routes set\". See \"Routes\" in lpod's docs/commands.md."
        echo "# lpod-routes: $(jq -c . <<< "$ROUTES")"
        routes_caddy "$APP_NAME" "$(proxy_layout)" "$ROUTES"
    } > "$(routes_site_path "$APP_NAME")"
}

# Writes the routes file and the network drop-in of an application's stored
# routes (or removes both when it has none), then applies them: a restart of
# the proxy when the networks it joins changed, or else a reload of Caddy,
# which keeps open connections up. A proxy that isn't running picks them up
# when it starts...
function routes_apply {
    local APP_NAME="$1"
    local DROPINS DROPIN ROUTES
    DROPINS="$(proxy_dropin_path)"
    DROPIN="${DROPINS}/lpod-routes-${APP_NAME}.conf"
    ROUTES="$(routes_settings "$APP_NAME")"

    local BEFORE=""

    if [ -f "$DROPIN" ]; then
        BEFORE="$(cat "$DROPIN")"
    fi

    routes_write_site "$APP_NAME" "$ROUTES" || return 1

    if [ -z "$ROUTES" ] || [ "$(jq 'length' <<< "$ROUTES")" -eq 0 ]; then
        rm -f "$DROPIN"
    else
        mkdir -p "$DROPINS" || return 1

        local NETWORKS
        mapfile -t NETWORKS < <(quadlet_units_json | jq -r --arg app "$APP_NAME" '.[] | select(.app == $app and .ext == "network") | .Name' | sort)

        if [ ${#NETWORKS[@]} -gt 0 ]; then
            {
                echo "# Written by \"lpod ${APP_NAME} routes set\": lets the proxy reach ${APP_NAME}'s containers by name."
                echo "[Container]"
                printf 'Network=%s\n' "${NETWORKS[@]}"
            } > "$DROPIN" || return 1
        else
            rm -f "$DROPIN"
        fi
    fi

    local AFTER=""

    if [ -f "$DROPIN" ]; then
        AFTER="$(cat "$DROPIN")"
    fi

    if [ "$BEFORE" != "$AFTER" ]; then
        "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

        if unit_is_active pods-proxy.service; then
            "${SYSTEMCTL_CMD[@]}" --no-block restart pods-proxy.service || return 1
        fi

        return
    fi

    if unit_is_active pods-proxy.service; then
        proxy_reload || return 1
    fi
}

# "lpod APP routes [set --stdin|remove] --json": the hostnames the Pods proxy
# sends to an application. "set" replaces them with {"routes": [{"role",
# "host", "upstream", "main"}]} from stdin, where upstream is a container
# and port (systemd-hello:8000). The first route is the main one unless
# another says "main": true...
function cmd_app_routes {
    local APPLICATION="$1"
    local ACTION="${2:-}"
    shift 2 2> /dev/null || shift

    local APP_NAME
    APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"

    case "$ACTION" in
        --json|"")
            jq -n --argjson contract "$LPOD_CONTRACT" --argjson routes "$(routes_with_targets "$APP_NAME" "$(routes_settings "$APP_NAME" | grep . || echo '[]')")" \
                '{contract: $contract, routes: $routes}'
            ;;

        set)
            local STDIN=false ARG

            for ARG in "$@"; do
                case "$ARG" in
                    --stdin) STDIN=true ;;
                    --json) ;;
                    *) echo "Unknown option: $ARG" >&2; return 1 ;;
                esac
            done

            if [ "$STDIN" != true ]; then
                echo "Pass the routes on stdin, with --stdin." >&2

                return 1
            fi

            local ROUTES PROBLEM
            if ! ROUTES="$(jq -c '.routes // error' 2> /dev/null)"; then
                echo 'Pass {"routes": [{"role": ..., "host": ..., "upstream": ...}]} on stdin.' >&2

                return 1
            fi

            local DOMAIN=""

            if [ "$(proxy_layout)" == "handlers" ]; then
                DOMAIN="$(proxy_wildcard_domain)"
            fi

            PROBLEM="$(jq -r --arg domain "$DOMAIN" '
                def hostname: test("^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$") and (length <= 253);
                if type != "array" then "routes must be a list."
                elif length > 50 then "At most 50 routes."
                else (
                    [.[] | select(
                        ((.role // "") | test("^[a-z][a-z0-9_-]{0,31}$") | not)
                        or ((.host // "") | hostname | not)
                        or ((.upstream // "") | test("^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}:[0-9]{1,5}$") | not)
                    )] | first | if . != null then "Invalid route: role, host (a hostname) and upstream (CONTAINER:PORT) are needed, got \(tojson)." else empty end
                ) // (
                    if ([.[].host | ascii_downcase] | length) != ([.[].host | ascii_downcase] | unique | length) then "Each host can only have one route."
                    elif ([.[].role] | length) != ([.[].role] | unique | length) then "Each role can only have one route."
                    elif ([.[] | select(.main == true)] | length) > 1 then "Only one route can be the main one."
                    elif any(.[]; (.via // null) != null and .via != "main") then "A route can only go via the main one: \"via\": \"main\"."
                    elif any(.[]; .main == true and .via == "main") then "The main route cannot go via itself."
                    elif $domain != "" then (first(.[] | select((.host | ascii_downcase) as $host | ($host | endswith("." + $domain)) and ($host | rtrimstr("." + $domain) | test("^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")) | not)) | "\(.host) is not one label under *.\($domain), which the certificate of the proxy covers.") // empty
                    else empty end
                ) end
            ' <<< "$ROUTES")" || return 1

            if [ -n "$PROBLEM" ]; then
                echo "$PROBLEM" >&2

                return 1
            fi

            ROUTES="$(jq -c '
                (any(.[]; .main == true)) as $chosen
                | to_entries | map(.value + {host: (.value.host | ascii_downcase), main: (if $chosen then .value.main == true else .key == 0 end)})
                | map(if .main then . + {via: null} else . end)
                | map({role, host, upstream, main} + (if (.via // null) == "main" then {via: "main"} else {} end))
            ' <<< "$ROUTES")"

            mkdir -p "$(proxy_sites_path)" || return 1
            printf '# lpod-routes: %s\n' "$ROUTES" > "$(routes_site_path "$APP_NAME")" || return 1
            routes_apply "$APP_NAME" || return 1
            json_ok
            ;;

        remove)
            rm -f "$(proxy_sites_path)/${APP_NAME}.caddy" "$(proxy_sites_path)/${APP_NAME}.Caddyfile"
            routes_apply "$APP_NAME" || return 1
            json_ok
            ;;

        *)
            echo "Usage: lpod APP routes [set --stdin|remove] --json" >&2

            return 1
            ;;
    esac
}

# The timer "lpod APP timers set" writes for the timer NAME of the
# application APP. Its "# lpod-timer:" line holds the settings it was written
# with, so "timers" and "timers remove" know what's there...
function timer_path {
    echo "${SYSTEMD_UNIT_PATH}/${1}-${2}.timer"
}

# Prints the stored settings of every timer of the application APP, as a
# JSON list...
function timers_settings {
    local APP_NAME="$1"
    local FILE

    for FILE in "${SYSTEMD_UNIT_PATH}/${APP_NAME}"-*.timer; do
        if [ -f "$FILE" ]; then
            sed -n 's/^# lpod-timer: //p' "$FILE" | head -n 1
        fi
    done | jq -s --arg app "$APP_NAME" 'map(select(.app == $app) | del(.app)) | sort_by(.name)'
}

# Stops and removes the timers in SETTINGS (a list from timers_settings) of
# the application APP, and the drop-ins they wrote for their containers,
# without a daemon-reload...
function timers_remove {
    local APP_NAME="$1"
    local SETTINGS="$2"
    local UNITS="$3"

    local NAME CONTAINER

    while IFS=$'\t' read -r NAME CONTAINER; do
        "${SYSTEMCTL_CMD[@]}" disable --now "${APP_NAME}-${NAME}.timer" > /dev/null 2>&1
        rm -f "$(timer_path "$APP_NAME" "$NAME")"

        local UNIT_PATH
        UNIT_PATH="$(ondemand_container_unit "$UNITS" "$APP_NAME" "$CONTAINER")"
        UNIT_PATH="${UNIT_PATH#*$'\t'}"

        if [ -n "$UNIT_PATH" ]; then
            rm -f "${UNIT_PATH}.d/lpod-timer.conf"
            rmdir "${UNIT_PATH}.d" 2> /dev/null
        fi
    done < <(jq -r '.[] | [.name, .container] | @tsv' <<< "$SETTINGS")
}

# Prints the timers of the application APP with their state: whether the
# timer is enabled, whether its container runs, and its next and last run...
function timers_with_state {
    local APP_NAME="$1"
    local SETTINGS="$2"

    local STATES=() NAME SERVICE

    while IFS=$'\t' read -r NAME SERVICE; do
        STATES+=("$(jq -n --arg name "$NAME" \
            --arg timer "$("${SYSTEMCTL_CMD[@]}" show "${APP_NAME}-${NAME}.timer" --property=ActiveState,NextElapseUSecRealtime,LastTriggerUSec --timestamp=unix 2> /dev/null)" \
            --arg service "$("${SYSTEMCTL_CMD[@]}" show "$SERVICE" --property=ActiveState,Result 2> /dev/null)" '
            def props: split("\n") | map(select(contains("=")) | capture("^(?<key>[^=]+)=(?<value>.*)$")) | from_entries;
            {name: $name, timer: ($timer | props), service: ($service | props)}')")
    done < <(jq -r '.[] | [.name, .service] | @tsv' <<< "$SETTINGS")

    printf '%s\n' "${STATES[@]}" | jq -s --argjson settings "$SETTINGS" --arg app "$APP_NAME" '
        def iso: if . == null or . == "" or . == "n/a" or . == "0" then null else (ltrimstr("@") | tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
        map({key: .name, value: .}) | from_entries as $states
        | $settings | map(. as $timer | ($states[$timer.name] // {timer: {}, service: {}}) as $state
            | ($state.timer.LastTriggerUSec | iso) as $last
            | {name, unit: "\($app)-\(.name).timer", container, service, on_calendar, persistent, randomized_delay_sec, timeout_start_sec,
                enabled: ($state.timer.ActiveState == "active"),
                running: (($state.service.ActiveState // "") | IN("active", "activating", "reloading")),
                next_run: ($state.timer.NextElapseUSecRealtime | iso),
                last_run: $last,
                last_result: (if $last == null or (($state.service.ActiveState // "") | IN("active", "activating")) then null else ($state.service.Result // null) end)})'
}

# "lpod APP timers [set --stdin|remove|run NAME] --json": the systemd timers
# that start containers of an application on a schedule. "set" replaces them
# with {"timers": [{"name", "container", "on_calendar", "persistent",
# "randomized_delay_sec", "timeout_start_sec"}]} from stdin, where container
# is a container Quadlet of the application (without .container) and the
# other keys are the [Timer] and [Service] directives of the same name. Each
# becomes APP-NAME.timer, which starts the container's service...
function cmd_app_timers {
    local APPLICATION="$1"
    local ACTION="${2:-}"
    shift 2 2> /dev/null || shift

    local APP_NAME
    APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"

    case "$ACTION" in
        --json|"")
            jq -n --argjson contract "$LPOD_CONTRACT" --argjson timers "$(timers_with_state "$APP_NAME" "$(timers_settings "$APP_NAME")")" \
                '{contract: $contract, timers: $timers}'
            ;;

        set)
            local STDIN=false ARG

            for ARG in "$@"; do
                case "$ARG" in
                    --stdin) STDIN=true ;;
                    --json) ;;
                    *) echo "Unknown option: $ARG" >&2; return 1 ;;
                esac
            done

            if [ "$STDIN" != true ]; then
                echo "Pass the timers on stdin, with --stdin." >&2

                return 1
            fi

            local TIMERS PROBLEM
            if ! TIMERS="$(jq -c '.timers // error' 2> /dev/null)"; then
                echo 'Pass {"timers": [{"name": ..., "container": ..., "on_calendar": ...}]} on stdin.' >&2

                return 1
            fi

            local UNITS
            UNITS="$(quadlet_units_json)" || return 1

            PROBLEM="$(jq -r --arg app "$APP_NAME" --argjson units "$UNITS" '
                def span: type == "string" and test("^[0-9A-Za-z. ]{1,32}$");
                ($units | map(select(.app == $app and .ext == "container") | .base)) as $containers
                | if type != "array" then "timers must be a list."
                elif length > 20 then "At most 20 timers."
                else (
                    [.[] | select(
                        type != "object"
                        or ((.name // "") | test("^[a-z0-9][a-z0-9_-]{0,31}$") | not)
                        or ((.container // "") | type != "string")
                        or ((.on_calendar // null) | if type == "string" then [.] else . end | type != "array" or length == 0 or length > 10 or any(.[]; type != "string" or length > 128 or test("[\\r\\n]")))
                        or (has("persistent") and .persistent != null and (.persistent | type != "boolean"))
                        or (has("randomized_delay_sec") and .randomized_delay_sec != null and (.randomized_delay_sec | span | not))
                        or (has("timeout_start_sec") and .timeout_start_sec != null and (.timeout_start_sec | span | not))
                    )] | first | if . != null then "Invalid timer: name, container and on_calendar are needed, got \(tojson)." else empty end
                ) // (
                    first(.[] | select(.container as $container | $containers | index($container) | not) | "\(.container) isn'"'"'t a container Quadlet of \($app).") // empty
                ) // (
                    if ([.[].name] | length) != ([.[].name] | unique | length) then "Each name can only have one timer."
                    elif ([.[].container] | length) != ([.[].container] | unique | length) then "Each container can only have one timer. Give it more than one on_calendar instead."
                    elif any(.[]; .name == "idle") then "idle is taken by the idle check of on-demand."
                    else empty end
                ) end
            ' <<< "$TIMERS")" || return 1

            if [ -n "$PROBLEM" ]; then
                echo "$PROBLEM" >&2

                return 1
            fi

            TIMERS="$(jq -c --arg app "$APP_NAME" --argjson units "$UNITS" '
                map({
                    name,
                    container,
                    service: (.container as $container | first($units[] | select(.app == $app and .ext == "container" and .base == $container) | .UnitName) // "\(.container).service"),
                    on_calendar: (.on_calendar | if type == "string" then [.] else . end),
                    persistent: (.persistent // null),
                    randomized_delay_sec: (.randomized_delay_sec // null),
                    timeout_start_sec: (.timeout_start_sec // null)
                })
            ' <<< "$TIMERS")"

            local CALENDAR SPAN

            while IFS= read -r CALENDAR; do
                if [[ "$CALENDAR" == -* ]] || ! systemd-analyze calendar -- "$CALENDAR" > /dev/null 2>&1; then
                    echo "${CALENDAR} isn't a systemd calendar event (see systemd.time(7))." >&2

                    return 1
                fi
            done < <(jq -r '.[].on_calendar[]' <<< "$TIMERS")

            while IFS= read -r SPAN; do
                if [ "$SPAN" != "infinity" ] && ! systemd-analyze timespan -- "$SPAN" > /dev/null 2>&1; then
                    echo "${SPAN} isn't a systemd time span (see systemd.time(7))." >&2

                    return 1
                fi
            done < <(jq -r '.[] | .randomized_delay_sec, .timeout_start_sec | select(. != null)' <<< "$TIMERS")

            local NAME

            # A timer of another command (such as the on-demand scheduler's)
            # isn't replaced...
            while IFS= read -r NAME; do
                local FILE
                FILE="$(timer_path "$APP_NAME" "$NAME")"

                if [ -f "$FILE" ] && ! grep -q '^# lpod-timer: ' "$FILE"; then
                    echo "${APP_NAME}-${NAME}.timer is already there, and lpod timers didn't write it." >&2

                    return 1
                fi
            done < <(jq -r '.[].name' <<< "$TIMERS")

            timers_remove "$APP_NAME" "$(timers_settings "$APP_NAME")" "$UNITS"

            local TIMER

            while IFS= read -r TIMER; do
                NAME="$(jq -r '.name' <<< "$TIMER")"

                {
                    echo "# Written by \"lpod ${APP_NAME} timers set\". See \"Timers\" in lpod's docs/commands.md."
                    echo "# lpod-timer: $(jq -c --arg app "$APP_NAME" '{app: $app} + .' <<< "$TIMER")"
                    echo "[Unit]"
                    echo "Description=${APP_NAME} ${NAME} timer"
                    echo
                    echo "[Timer]"
                    echo "Unit=$(jq -r '.service' <<< "$TIMER")"
                    jq -r '.on_calendar[] | "OnCalendar=\(.)"' <<< "$TIMER"
                    jq -r 'if .persistent != null then "Persistent=\(.persistent)" else empty end' <<< "$TIMER"
                    jq -r 'if .randomized_delay_sec != null then "RandomizedDelaySec=\(.randomized_delay_sec)" else empty end' <<< "$TIMER"
                    echo
                    echo "[Install]"
                    echo "WantedBy=timers.target"
                } > "$(timer_path "$APP_NAME" "$NAME")" || return 1

                local TIMEOUT
                TIMEOUT="$(jq -r '.timeout_start_sec // empty' <<< "$TIMER")"

                if [ -n "$TIMEOUT" ]; then
                    local UNIT_PATH
                    UNIT_PATH="$(ondemand_container_unit "$UNITS" "$APP_NAME" "$(jq -r '.container' <<< "$TIMER")")"
                    UNIT_PATH="${UNIT_PATH#*$'\t'}"

                    mkdir -p "${UNIT_PATH}.d" || return 1
                    {
                        echo "# Written by \"lpod ${APP_NAME} timers set\". See \"Timers\" in lpod's docs/commands.md."
                        echo "[Service]"
                        echo "TimeoutStartSec=${TIMEOUT}"
                    } > "${UNIT_PATH}.d/lpod-timer.conf" || return 1
                fi
            done < <(jq -c '.[]' <<< "$TIMERS")

            "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

            local ENABLE
            mapfile -t ENABLE < <(jq -r --arg app "$APP_NAME" '.[] | "\($app)-\(.name).timer"' <<< "$TIMERS")

            if [ ${#ENABLE[@]} -gt 0 ]; then
                "${SYSTEMCTL_CMD[@]}" enable "${ENABLE[@]}" > /dev/null 2>&1 || return 1
                "${SYSTEMCTL_CMD[@]}" restart "${ENABLE[@]}" || return 1
            fi

            json_ok
            ;;

        remove)
            local UNITS
            UNITS="$(quadlet_units_json)" || return 1
            timers_remove "$APP_NAME" "$(timers_settings "$APP_NAME")" "$UNITS"
            "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1
            json_ok
            ;;

        run)
            local NAME="${1:-}" SERVICE

            SERVICE="$(timers_settings "$APP_NAME" | jq -r --arg name "$NAME" 'first(.[] | select(.name == $name) | .service) // empty')"

            if [ -z "$NAME" ] || [ -z "$SERVICE" ]; then
                echo "${APP_NAME} has no timer named ${NAME}." >&2

                return 1
            fi

            "${SYSTEMCTL_CMD[@]}" --no-block start "$SERVICE" || return 1
            json_ok
            ;;

        *)
            echo "Usage: lpod APP timers [set --stdin|remove|run NAME] --json" >&2

            return 1
            ;;
    esac
}

# "lpod proxy routes --json": whether the Pods proxy is installed and running,
# and the routes of every application...
function cmd_proxy_json {
    require_jq

    if [ "${1:-}" != "routes" ]; then
        echo "Usage: lpod proxy routes --json" >&2

        return 1
    fi

    local INSTALLED=false RUNNING=false

    if quadlet_units_json | jq -e 'any(.[]; .Name == "pods-proxy.container")' > /dev/null; then
        INSTALLED=true
    fi

    if unit_is_active pods-proxy.service; then
        RUNNING=true
    fi

    local SITE APP_NAME ROUTES ALL=() SEEN=()

    for SITE in "$(proxy_sites_path)"/*.caddy "$(proxy_sites_path)"/*.Caddyfile; do
        [ -f "$SITE" ] || continue
        APP_NAME="$(basename "$SITE")"
        APP_NAME="${APP_NAME%.*}"

        # An application has one routes file, but skip it if both layouts' are there...
        [[ " ${SEEN[*]} " == *" ${APP_NAME} "* ]] && continue
        SEEN+=("$APP_NAME")

        ROUTES="$(routes_settings "$APP_NAME")"
        [ -n "$ROUTES" ] || continue
        ALL+=("$(routes_with_targets "$APP_NAME" "$ROUTES" | jq -c --arg app "$APP_NAME" 'map({application: $app} + .)')")
    done

    printf '%s\n' "${ALL[@]}" | jq -s --argjson contract "$LPOD_CONTRACT" --argjson installed "$INSTALLED" --argjson running "$RUNNING" \
        --arg layout "$(proxy_layout)" --arg domain "$(proxy_wildcard_domain)" \
        '{contract: $contract, proxy: {installed: $installed, running: $running, layout: $layout, domain: (if $layout == "handlers" and $domain != "" then $domain else null end)}, routes: (add // [])}'
}

# The Podman secret that holds the API token of the proxy's DNS provider...
LPOD_PROXY_DNS_SECRET="pods-proxy-dns-token"

# The image of the wildcard mode: Caddy with the DNS plugins, which caddy:2
# doesn't have...
LPOD_PROXY_DNS_IMAGE="ghcr.io/foxws/pods-proxy:main"

# The environment variable a DNS provider's plugin reads its token from...
function proxy_dns_env {
    case "$1" in
        cloudflare) echo CLOUDFLARE_API_TOKEN ;;
    esac
}

# The settings "proxy settings set" stored on the Caddyfile's "# lpod-proxy:"
# line, as JSON, or nothing when lpod didn't write the Caddyfile...
function proxy_stored_settings {
    sed -n 's/^# lpod-proxy: //p' "$(proxy_caddyfile_path)" 2> /dev/null | head -n 1
}

# The proxy's Quadlet and its drop-ins, in the order Quadlet reads them, so
# the last value of a key wins...
function proxy_unit_files {
    local UNITS="$1"
    local UNIT_PATH DROPIN
    UNIT_PATH="$(jq -r 'first(.[] | select(.Name == "pods-proxy.container") | .Path) // empty' <<< "$UNITS")"

    if [ -n "$UNIT_PATH" ] && [ -f "$UNIT_PATH" ]; then
        echo "$UNIT_PATH"
    fi

    for DROPIN in "$(proxy_dropin_path)"/*.conf; do
        if [ -f "$DROPIN" ]; then
            echo "$DROPIN"
        fi
    done
}

# The host port a drop-in publishes the proxy's container PORT on, the last
# one when there are more...
function proxy_published_port {
    local PORT="$1"
    shift

    cat "$@" 2> /dev/null | sed -nE "s/^[[:space:]]*PublishPort=([^:]*:)?([0-9]+):${PORT}(\/tcp)?[[:space:]]*$/\2/p" | tail -n 1
}

# Whether a drop-in other than lpod's own passes ENV as a secret...
function proxy_secret_elsewhere {
    local ENV="$1"
    local DROPIN

    for DROPIN in "$(proxy_dropin_path)"/*.conf; do
        [ -f "$DROPIN" ] || continue
        [[ "$(basename "$DROPIN")" == lpod-* ]] && continue

        if grep -qE "^[[:space:]]*Secret=.*target=${ENV}([,[:space:]]|$)" "$DROPIN"; then
            echo "$DROPIN"

            return
        fi
    done
}

# The settings of a Caddyfile lpod didn't write, as far as they can be read
# from it and the drop-ins, so a form can start from them...
function proxy_detected_settings {
    local FILES=("$@")
    local CADDYFILE MODE="" EMAIL DOMAIN="" PROVIDER RESOLVERS IMAGE
    CADDYFILE="$(proxy_caddyfile_path)"

    if [ -f "$CADDYFILE" ]; then
        if [ "$(proxy_layout)" == "handlers" ]; then
            MODE=wildcard
            DOMAIN="$(proxy_wildcard_domain)"
        elif grep -qE '^[[:space:]]*auto_https[[:space:]]+off' "$CADDYFILE" || cat "${FILES[@]}" 2> /dev/null | grep -qE '^[[:space:]]*Environment=PROXY_SCHEME=http[[:space:]]*$'; then
            MODE=http
        elif grep -qE '^[[:space:]]*(local_certs|cert_issuer[[:space:]]+internal)([[:space:]]|$)' "$CADDYFILE"; then
            MODE=local
        else
            MODE=letsencrypt
        fi
    fi

    EMAIL="$(sed -nE 's/^[[:space:]]*email[[:space:]]+([^[:space:]]+).*/\1/p' "$CADDYFILE" 2> /dev/null | head -n 1)"
    PROVIDER="$(sed -nE 's/^[[:space:]]*acme_dns[[:space:]]+([a-z0-9_]+).*/\1/p' "$CADDYFILE" 2> /dev/null | head -n 1)"
    RESOLVERS="$(sed -nE 's/^[[:space:]]*resolvers[[:space:]]+([^{}]+[^[:space:]{}]).*/\1/p' "$CADDYFILE" 2> /dev/null | head -n 1)"
    IMAGE=""

    if [ ${#FILES[@]} -gt 1 ]; then
        IMAGE="$(cat "${FILES[@]:1}" 2> /dev/null | sed -nE 's/^[[:space:]]*Image=([^[:space:]]+).*/\1/p' | tail -n 1)"
    fi

    # The wildcard mode's own image is no override...
    if [ "$MODE" == "wildcard" ] && [ "$IMAGE" == "$LPOD_PROXY_DNS_IMAGE" ]; then
        IMAGE=""
    fi

    jq -n --arg mode "$MODE" --arg email "$EMAIL" --arg domain "$DOMAIN" --arg provider "$PROVIDER" --arg resolvers "$RESOLVERS" --arg image "$IMAGE" '
        def nullable: if . == "" then null else . end;
        {mode: ($mode | nullable), email: ($email | nullable), domain: ($domain | nullable), dns_provider: ($provider | nullable), resolvers: ($resolvers | nullable), image: ($image | nullable)}'
}

# "lpod proxy settings [set --stdin] --json": how the Pods proxy gets its
# certificates, its ports and its image. "set" writes the Caddyfile and the
# drop-in lpod-proxy.conf from {"mode", "email", "domain", "dns_provider",
# "dns_token", "resolvers", "http_port", "https_port", "image"} on stdin...
function cmd_proxy_settings_json {
    require_jq

    case "${1:-}" in
        --json|"") proxy_settings_show ;;
        set) shift; proxy_settings_set "$@" ;;
        *)
            echo "Usage: lpod proxy settings [set --stdin] --json" >&2

            return 1
            ;;
    esac
}

function proxy_settings_show {
    local UNITS INSTALLED=false RUNNING=false FILES STORED SETTINGS
    UNITS="$(quadlet_units_json)" || return 1

    if jq -e 'any(.[]; .Name == "pods-proxy.container")' > /dev/null <<< "$UNITS"; then
        INSTALLED=true
    fi

    if unit_is_active pods-proxy.service; then
        RUNNING=true
    fi

    mapfile -t FILES < <(proxy_unit_files "$UNITS")
    STORED="$(proxy_stored_settings)"

    if [ -n "$STORED" ]; then
        SETTINGS="$(jq -c '{mode, email, domain, dns_provider, resolvers, image}' <<< "$STORED")"
    else
        SETTINGS="$(proxy_detected_settings "${FILES[@]}")"
    fi

    local PROVIDER ENV TOKEN=false
    PROVIDER="$(jq -r '.dns_provider // empty' <<< "$SETTINGS")"
    ENV="$(proxy_dns_env "${PROVIDER:-cloudflare}")"

    if "${LPOD_PODMAN_BINARY:-podman}" secret exists "$LPOD_PROXY_DNS_SECRET" 2> /dev/null || [ -n "$(proxy_secret_elsewhere "$ENV")" ]; then
        TOKEN=true
    fi

    local PORT_START=""

    if [ "$(quadlet_scope)" == "rootless" ]; then
        PORT_START="$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2> /dev/null)"
    fi

    jq -n --argjson contract "$LPOD_CONTRACT" --argjson installed "$INSTALLED" --argjson running "$RUNNING" \
        --argjson settings "$SETTINGS" --argjson managed "$([ -n "$STORED" ] && echo true || echo false)" --argjson token "$TOKEN" \
        --arg http "$(proxy_published_port 80 "${FILES[@]}")" --arg https "$(proxy_published_port 443 "${FILES[@]}")" \
        --arg scope "$(quadlet_scope)" --arg port_start "$PORT_START" '
        def port: if . == "" then null else tonumber end;
        {
            contract: $contract,
            proxy: {installed: $installed, running: $running},
            settings: ({managed: $managed} + $settings + {http_port: ($http | port), https_port: ($https | port), dns_token: $token}),
            host: {scope: $scope, unprivileged_port_start: ($port_start | port)}
        }'
}

function proxy_settings_set {
    local STDIN=false ARG

    for ARG in "$@"; do
        case "$ARG" in
            --stdin) STDIN=true ;;
            --json) ;;
            *) echo "Unknown option: $ARG" >&2; return 1 ;;
        esac
    done

    if [ "$STDIN" != true ]; then
        echo "Pass the settings on stdin, with --stdin." >&2

        return 1
    fi

    local INPUT PROBLEM
    if ! INPUT="$(jq -c 'if type == "object" then . else error end' 2> /dev/null)"; then
        echo 'Pass {"mode": "letsencrypt", "email": ..., ...} on stdin.' >&2

        return 1
    fi

    PROBLEM="$(jq -r '
        def hostname: type == "string" and test("^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$") and (length <= 253);
        def port: type == "number" and . == floor and . >= 1 and . <= 65535;
        def text($pattern): . == null or (type == "string" and test($pattern));
        if (.mode | IN("letsencrypt", "local", "wildcard", "http") | not) then "mode must be letsencrypt, local, wildcard or http."
        elif (.email // null | text("^[^@[:space:]{}]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$") | not) then "Invalid email address."
        elif .mode == "wildcard" and (.domain | hostname | not) then "The wildcard mode needs a domain with at least two labels, such as home.example.com."
        elif .mode == "wildcard" and .dns_provider != "cloudflare" then "dns_provider must be cloudflare, the DNS plugin in \($image)."
        elif (.resolvers // null | text("^[A-Za-z0-9.:-]+( [A-Za-z0-9.:-]+)*$") | not) then "resolvers must be IP addresses or hostnames, separated by spaces."
        elif (.http_port // 80 | port | not) or (.https_port // 443 | port | not) then "The ports must be numbers from 1 to 65535."
        elif .mode != "http" and (.http_port // 80) == (.https_port // 443) then "The HTTP and HTTPS ports must differ."
        elif (.image // null | text("^[A-Za-z0-9][A-Za-z0-9._/:@-]{0,254}$") | not) then "Invalid image."
        elif (.dns_token // null | text("^[[:graph:]]{1,1024}$") | not) then "Invalid DNS token."
        else empty end
    ' --arg image "$LPOD_PROXY_DNS_IMAGE" <<< "$INPUT")" || return 1

    if [ -n "$PROBLEM" ]; then
        echo "$PROBLEM" >&2

        return 1
    fi

    local SETTINGS TOKEN
    SETTINGS="$(jq -c '{
        mode,
        email: (.email // null),
        domain: (if .mode == "wildcard" then .domain | ascii_downcase else null end),
        dns_provider: (if .mode == "wildcard" then .dns_provider else null end),
        resolvers: (if .mode == "wildcard" then .resolvers // null else null end),
        http_port: (.http_port // 80),
        https_port: (if .mode == "http" then null else .https_port // 443 end),
        image: (.image // null)
    }' <<< "$INPUT")"
    TOKEN="$(jq -r '.dns_token // empty' <<< "$INPUT")"

    local MODE PROVIDER ENV DROPINS DROPIN
    MODE="$(jq -r '.mode' <<< "$SETTINGS")"
    PROVIDER="$(jq -r '.dns_provider // empty' <<< "$SETTINGS")"
    DROPINS="$(proxy_dropin_path)"
    DROPIN="${DROPINS}/lpod-proxy.conf"

    # Ports from another drop-in would be published twice. One that only
    # publishes ports, such as install.sh's install.conf or the README's
    # ports.conf, is replaced by lpod's; any other is left to you...
    local FILE REPLACED=()

    for FILE in "$DROPINS"/*.conf; do
        [ -f "$FILE" ] || continue
        [[ "$(basename "$FILE")" == lpod-* ]] && continue
        grep -qE '^[[:space:]]*PublishPort=' "$FILE" || continue

        if grep -vE '^[[:space:]]*(#.*|;.*|\[Container\]|PublishPort=.*|Environment=PROXY_SCHEME=[a-z]+)?[[:space:]]*$' "$FILE" > /dev/null; then
            echo "${FILE} publishes ports of the proxy too. Remove its PublishPort= lines, since lpod sets them now." >&2

            return 1
        fi

        REPLACED+=("$FILE")
    done

    # The DNS token, kept as a Podman secret unless another drop-in already
    # passes one...
    local SECRET=false ELSEWHERE=""

    if [ "$MODE" == "wildcard" ]; then
        ENV="$(proxy_dns_env "$PROVIDER")"
        ELSEWHERE="$(proxy_secret_elsewhere "$ENV")"

        if [ -n "$TOKEN" ] && [ -n "$ELSEWHERE" ]; then
            echo "${ELSEWHERE} already passes ${ENV} to the proxy. Remove that Secret= line to keep the token in lpod's secret instead." >&2

            return 1
        fi

        if [ -n "$TOKEN" ]; then
            printf '%s' "$TOKEN" | "${LPOD_PODMAN_BINARY:-podman}" secret create --replace "$LPOD_PROXY_DNS_SECRET" - > /dev/null || return 1
            SECRET=true
        elif [ -z "$ELSEWHERE" ]; then
            if ! "${LPOD_PODMAN_BINARY:-podman}" secret exists "$LPOD_PROXY_DNS_SECRET" 2> /dev/null; then
                echo "The DNS challenge needs an API token of ${PROVIDER}: pass dns_token." >&2

                return 1
            fi

            SECRET=true
        fi
    fi

    # A Caddyfile lpod didn't write is kept next to it...
    local CADDYFILE BACKUP=""
    CADDYFILE="$(proxy_caddyfile_path)"

    if [ -f "$CADDYFILE" ] && [ -z "$(proxy_stored_settings)" ]; then
        BACKUP="${CADDYFILE}.$(date -u +%Y%m%d%H%M%S).backup"
        cp -p "$CADDYFILE" "$BACKUP" || return 1
    fi

    mkdir -p "$(dirname "$CADDYFILE")" "$(proxy_sites_path)" "$DROPINS" || return 1
    proxy_caddyfile "$SETTINGS" > "${CADDYFILE}.lpod" && mv "${CADDYFILE}.lpod" "$CADDYFILE" || return 1

    {
        echo "# Written by \"lpod proxy settings set\": the proxy's ports, image and DNS token."
        echo "[Container]"
        jq -r '"PublishPort=\(.http_port):80", (if .https_port != null then "PublishPort=\(.https_port):443", "PublishPort=\(.https_port):443/udp" else empty end)' <<< "$SETTINGS"
        jq -r --arg image "$LPOD_PROXY_DNS_IMAGE" '(.image // (if .mode == "wildcard" then $image else empty end)) | "Image=\(.)"' <<< "$SETTINGS"

        if [ "$MODE" == "http" ]; then
            echo "Environment=PROXY_SCHEME=http"
        fi

        if [ "$SECRET" == true ]; then
            echo "Secret=${LPOD_PROXY_DNS_SECRET},type=env,target=${ENV}"
        fi
    } > "$DROPIN" || return 1

    if [ ${#REPLACED[@]} -gt 0 ]; then
        rm -f "${REPLACED[@]}"
    fi

    # The layout may have changed, so every application's routes are written again...
    local SITE APP_NAME SEEN=()

    for SITE in "$(proxy_sites_path)"/*.caddy "$(proxy_sites_path)"/*.Caddyfile; do
        [ -f "$SITE" ] || continue
        APP_NAME="$(basename "$SITE")"
        APP_NAME="${APP_NAME%.*}"
        [[ " ${SEEN[*]} " == *" ${APP_NAME} "* ]] && continue
        SEEN+=("$APP_NAME")

        local ROUTES
        ROUTES="$(routes_settings "$APP_NAME")"
        [ -n "$ROUTES" ] || continue
        routes_write_site "$APP_NAME" "$ROUTES" || return 1
    done

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    if unit_is_active pods-proxy.service; then
        "${SYSTEMCTL_CMD[@]}" --no-block restart pods-proxy.service || return 1
    fi

    jq -n --argjson contract "$LPOD_CONTRACT" --arg backup "$BACKUP" '{contract: $contract, ok: true, backup: (if $backup == "" then null else $backup end)}'
}

# Prints the proxy's Caddyfile for SETTINGS. Sites in sites/*.Caddyfile work
# in every mode, and the wildcard mode adds one site for *.DOMAIN with the
# routes of sites/*.caddy inside it...
function proxy_caddyfile {
    jq -r --arg env "$(proxy_dns_env "$(jq -r '.dns_provider // empty' <<< "$1")")" '
        "# Written by \"lpod proxy settings set\". See \"Proxy\" in lpod'"'"'s docs/commands.md.",
        "# Saving the settings again replaces this file, so add your own sites in sites/*.Caddyfile.",
        "# lpod-proxy: \(tojson)",
        "{",
        "\tadmin unix//config/admin.sock|0600",
        (if .email != null then "\temail \(.email)" else empty end),
        (if .mode == "local" then "\tlocal_certs" else empty end),
        (if .mode == "http" then "\tauto_https off" else empty end),
        (if .mode == "wildcard" then "\tacme_dns \(.dns_provider) {env.\($env)}" else empty end),
        "\tservers {",
        "\t\ttrusted_proxies static private_ranges",
        "\t}",
        "}",
        "",
        "import sites/*.Caddyfile",
        (if .mode == "wildcard" then
            "",
            "*.\(.domain) {",
            (if .resolvers != null then "\ttls {", "\t\tresolvers \(.resolvers)", "\t}", "" else empty end),
            "\tencode zstd gzip",
            "",
            "\timport sites/*.caddy",
            "",
            "\thandle {",
            "\t\tabort",
            "\t}",
            "}"
        else empty end)
    ' <<< "$1"
}

# "lpod proxy certificate --json": the root certificate of the proxy's local
# certificate authority, which browsers trust once it's installed, or null
# while Caddy hasn't made one (or the proxy isn't running)...
function cmd_proxy_certificate_json {
    require_jq

    local CERTIFICATE="" FINGERPRINT="" EXPIRES=""

    if unit_is_active pods-proxy.service; then
        CERTIFICATE="$("${LPOD_PODMAN_BINARY:-podman}" exec systemd-pods-proxy cat /data/caddy/pki/authorities/local/root.crt 2> /dev/null)" || CERTIFICATE=""
    fi

    if [ -n "$CERTIFICATE" ] && command -v openssl > /dev/null 2>&1; then
        FINGERPRINT="$(openssl x509 -noout -fingerprint -sha256 <<< "$CERTIFICATE" 2> /dev/null | sed 's/^[^=]*=//')"
        EXPIRES="$(openssl x509 -noout -enddate <<< "$CERTIFICATE" 2> /dev/null | sed 's/^notAfter=//')"

        if [ -n "$EXPIRES" ]; then
            EXPIRES="$(date -u -d "$EXPIRES" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null)"
        fi
    fi

    jq -n --argjson contract "$LPOD_CONTRACT" --arg certificate "$CERTIFICATE" --arg fingerprint "$FINGERPRINT" --arg expires "$EXPIRES" '
        def nullable: if . == "" then null else . end;
        {contract: $contract, certificate: (if $certificate == "" then null else $certificate + "\n" end), fingerprint: ($fingerprint | nullable), expires: ($expires | nullable)}'
}

# "lpod APP ondemand enable|disable|status --json"...
function cmd_app_ondemand {
    local APPLICATION="$1"
    local ACTION="${2:-}"
    shift 2 2> /dev/null || shift

    case "$ACTION" in
        enable) cmd_app_ondemand_enable "$APPLICATION" "$@" ;;
        disable) cmd_app_ondemand_disable "$APPLICATION" ;;
        status) cmd_app_ondemand_status "$APPLICATION" ;;
        *)
            echo "Usage: lpod APP ondemand enable|disable|status --json" >&2

            return 1
            ;;
    esac
}


# The "--json" commands of an application: "lpod APP status|files|logs|up|
# down|restart|redeploy|secret add ... --json"...
# Stops the services right away (used by "lpod APP down --force"), for an
# application stuck starting, in a restart loop or slow to shut down. The
# stop is queued first, so Restart= doesn't start a killed service again.
# SIGKILL then ends the processes without waiting for TimeoutStopSec, and
# systemd still runs the units' ExecStopPost=, which removes the
# containers. Once they're down, reset-failed clears the failed state and
# the start limit, so a later "up" isn't refused.
function app_force_stop {
    "${SYSTEMCTL_CMD[@]}" --no-block stop "$@" || return 1
    "${SYSTEMCTL_CMD[@]}" kill --signal=SIGKILL "$@" 2> /dev/null || true

    local TRIES=0

    while [ "$TRIES" -lt 20 ] && "${SYSTEMCTL_CMD[@]}" --quiet is-active "$@" 2> /dev/null; do
        sleep 0.5
        TRIES=$((TRIES + 1))
    done

    "${SYSTEMCTL_CMD[@]}" reset-failed "$@" 2> /dev/null || true
}

function cmd_app_json {
    require_jq

    local NAME="$1"
    local COMMAND="$2"
    shift 2

    local APPLICATION
    APPLICATION="$(application_json "$NAME")" || return 1

    case "$COMMAND" in
        status)
            jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, application: (. + .detail | del(.detail, .services))}' <<< "$APPLICATION"
            ;;

        files)
            if [ "${1:-}" == "remove" ]; then
                shift
                app_files_remove "$(jq -r '.name' <<< "$APPLICATION")" "$@"

                return
            fi

            local UNITS
            UNITS="$(quadlet_units_json)" || return 1

            local FILES=()
            local FILE_NAME FILE_PATH DROPIN

            # shellcheck disable=SC2094
            while IFS=$'\t' read -r FILE_NAME FILE_PATH; do
                FILES+=("$(jq -Rs --arg name "$FILE_NAME" --arg path "$FILE_PATH" '{name: $name, path: $path, content: .}' < "$FILE_PATH")")

                for DROPIN in "$(dirname "$FILE_PATH")/${FILE_NAME}.d"/*.conf; do
                    if [ -f "$DROPIN" ]; then
                        FILES+=("$(jq -Rs --arg name "${FILE_NAME}.d/$(basename "$DROPIN")" --arg path "$DROPIN" '{name: $name, path: $path, content: .}' < "$DROPIN")")
                    fi
                done
            done < <(jq -r --arg app "$(jq -r '.name' <<< "$APPLICATION")" '.[] | select(.app == $app) | [.Name, .Path] | @tsv' <<< "$UNITS")

            printf '%s\n' "${FILES[@]}" | jq -s --argjson contract "$LPOD_CONTRACT" '{contract: $contract, files: .}'
            ;;

        logs)
            local LINES=100
            local SINCE=()

            while [ $# -gt 0 ]; do
                case "$1" in
                    --lines) LINES="${2:-}"; shift ;;
                    --since) SINCE=(--since "${2:-}"); shift ;;
                    --json) ;;
                    *) echo "Unknown option: $1" >&2; return 1 ;;
                esac

                shift
            done

            valid_lines "$LINES" || return 1

            local UNIT_ARGS=()
            local UNIT

            while IFS= read -r UNIT; do
                UNIT_ARGS+=(--unit "$UNIT")
            done < <(jq -r '.services[]' <<< "$APPLICATION")

            local ENTRIES
            ENTRIES="$(journal_entries_json "${UNIT_ARGS[@]}" --lines="$LINES" "${SINCE[@]}")" || return 1

            jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, entries: .}' <<< "$ENTRIES"
            ;;

        up|down|restart)
            local NO_BLOCK=()
            local FORCE=false
            local ARG

            for ARG in "$@"; do
                case "$ARG" in
                    --no-block) NO_BLOCK=(--no-block) ;;
                    --force) FORCE=true ;;
                esac
            done

            if [ "$FORCE" == true ] && [ "$COMMAND" != "down" ]; then
                echo "--force only works with down." >&2

                return 1
            fi

            case "$COMMAND" in
                up) app_start_main start "$(jq -r '.name' <<< "$APPLICATION")" "$(jq -r '.unit' <<< "$APPLICATION")" "${NO_BLOCK[@]}" || return 1 ;;
                restart) app_start_main restart "$(jq -r '.name' <<< "$APPLICATION")" "$(jq -r '.unit' <<< "$APPLICATION")" "${NO_BLOCK[@]}" || return 1 ;;
                # Every service of the application stops, not just the main
                # one, since siblings don't always stop with it...
                down)
                    local SERVICES
                    mapfile -t SERVICES < <(jq -r '.services[]' <<< "$APPLICATION")

                    if [ "$FORCE" == true ]; then
                        app_force_stop "${SERVICES[@]}" || return 1
                    else
                        "${SYSTEMCTL_CMD[@]}" "${NO_BLOCK[@]}" stop "${SERVICES[@]}" || return 1
                    fi
                    ;;
            esac

            json_ok
            ;;

        redeploy)
            local DETACH=false
            local ARG

            for ARG in "$@"; do
                if [ "$ARG" == "--no-block" ]; then
                    DETACH=true
                fi
            done

            local APP_NAME
            APP_NAME="$(jq -r '.name' <<< "$APPLICATION")"

            # Pulling can take minutes, longer than a web request waits, so
            # with "--no-block" a transient unit does the work and logs to the
            # journal as lpod-redeploy-APP...
            if [ "$DETACH" == true ]; then
                local SYSTEMD_RUN=(systemd-run --quiet --collect --no-block)

                if [ "$SYSTEMD_SCOPE" == "user" ]; then
                    SYSTEMD_RUN+=(--user)
                fi

                "${SYSTEMD_RUN[@]}" --unit "lpod-redeploy-$(systemd-escape -- "$APP_NAME")" \
                    "$(realpath "$0")" "$APP_NAME" redeploy --json > /dev/null || return 1

                json_ok

                return
            fi

            local IMAGE

            # Images built on the host ("localhost/...") have no registry to
            # pull from, so only the restart picks up a rebuild...
            while IFS= read -r IMAGE; do
                "${LPOD_PODMAN_BINARY:-podman}" pull --quiet "$IMAGE" > /dev/null || return 1
            done < <(jq -r '[.detail.items[].image | select(. != null and (startswith("localhost/") | not))] | unique[]' <<< "$APPLICATION")

            app_start_main restart "$APP_NAME" "$(jq -r '.unit' <<< "$APPLICATION")" || return 1

            json_ok
            ;;

        remove)
            cmd_app_remove_json "$(jq -r '.name' <<< "$APPLICATION")" "$@"
            ;;

        ondemand)
            cmd_app_ondemand "$APPLICATION" "$@"
            ;;

        routes)
            cmd_app_routes "$APPLICATION" "$@"
            ;;

        timers)
            cmd_app_timers "$APPLICATION" "$@"
            ;;

        secret)
            if [ "${1:-}" != "add" ] || [ -z "${2:-}" ]; then
                echo "Usage: lpod APP secret add NAME --type env|mount --target TARGET --json" >&2

                return 1
            fi

            cmd_app_secret_add "$(jq -r '.name' <<< "$APPLICATION")" "$2" "${@:3}"
            ;;

        *)
            echo "lpod ${NAME} ${COMMAND} has no JSON output." >&2

            return 1
            ;;
    esac
}

# Turns "journalctl --output=json" lines on stdin into contract entries...
read -r -d '' LPOD_JOURNAL_JQ <<'JQ'
map({
    time: (.__REALTIME_TIMESTAMP | tonumber / 1000000 | floor | strftime("%Y-%m-%dT%H:%M:%S+00:00")),
    unit: (((._SYSTEMD_USER_UNIT // ._SYSTEMD_UNIT) as $unit | if $unit == null or $unit == "init.scope" or ($unit | startswith("user@")) then (.USER_UNIT // .UNIT // $unit) else $unit end) // "" | sub("\\.service$"; "")),
    priority: ((.PRIORITY // "6") | tonumber),
    message: ((.MESSAGE // "") | if type == "array" then implode else . end | rtrimstr("\n"))
})
JQ

# Prints the journal entries for the journalctl ARGS as a JSON array...
function journal_entries_json {
    local SCOPE=()

    if [ "$SYSTEMD_SCOPE" == "user" ]; then
        SCOPE=(--user)
    fi

    journalctl "${SCOPE[@]}" "$@" --output=json --no-pager | jq -s "$LPOD_JOURNAL_JQ"
}

# Checks that a "--lines" value is a number from 1 to 99999...
function valid_lines {
    if ! [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]]; then
        echo "--lines takes a number from 1 to 99999." >&2

        return 1
    fi
}

# Checks that NAME is a plain Podman object name, never an option or a path...
function valid_name {
    if ! [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]{0,252}$ ]]; then
        echo "Invalid name: ${1}." >&2

        return 1
    fi
}

# Prints "podman container inspect" of every container as JSON...
function container_inspect_all_json {
    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local IDS

    mapfile -t IDS < <("$PODMAN" ps --all --quiet)

    if [ ${#IDS[@]} -eq 0 ]; then
        echo "[]"

        return
    fi

    "$PODMAN" container inspect "${IDS[@]}"
}

# Prints every container, managed by Quadlet or not, as the contract's
# "containers" list...
function host_containers_json {
    local UNITS PS STATS
    UNITS="$(quadlet_units_json)" || return 1
    PS="$("${LPOD_PODMAN_BINARY:-podman}" ps --all --format json)" || return 1
    STATS="$(container_stats_json)"

    jq -n \
        --slurpfile units <(printf '%s' "$UNITS") \
        --slurpfile ps <(printf '%s' "$PS") \
        --slurpfile stats <(printf '%s' "${STATS:-[]}") '
        $units[0] as $units | $ps[0] as $ps | $stats[0] as $stats |
        def iso: if . == null or . == 0 then null else (tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
        $ps
        | map(select((.IsInfra // false) | not))
        | map(
            . as $container
            | (.Labels.PODMAN_SYSTEMD_UNIT // null) as $unit_name
            | (if $unit_name == null then null else first($units[] | select(.UnitName == $unit_name)) end) as $unit
            | (first($stats[] | select(.name == $container.Names[0])) // null) as $use
            | {
                id: (.Id[0:12]),
                name: .Names[0],
                image: .Image,
                state: .State,
                health: ((.Status // "") | capture("\\((?<health>healthy|unhealthy|starting)\\)").health // null),
                exit_code: (if .State == "exited" then .ExitCode else null end),
                application: ($unit.app // null),
                quadlet: ($unit.Name // null),
                unit: (if $unit == null then null else $unit_name end),
                pod: (if (.PodName // "") == "" then null else .PodName end),
                ports: [(.Ports // [])[] | "\(if (.host_ip // "") == "" then "0.0.0.0" else .host_ip end):\(.host_port)->\(.container_port)/\(.protocol // "tcp")"],
                cpu: (if .State == "running" then ($use.cpu // null) else null end),
                memory: (if .State == "running" then ($use.memory // null) else null end),
                started_at: (if .State == "running" then (.StartedAt | iso) else null end)
            })
        | sort_by(.application == null, .application, .name)'
}

# "lpod containers --json"...
function cmd_containers_json {
    require_jq

    local CONTAINERS
    CONTAINERS="$(host_containers_json)" || return 1

    jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, containers: .}' <<< "$CONTAINERS"
}

# "lpod container NAME inspect|logs|stats|exec|start|stop|restart --json"...
function cmd_container_json {
    require_jq

    local NAME="${1:-}"
    local ACTION="${2:-}"
    shift 2 || true

    valid_name "$NAME" || return 1

    local CONTAINERS SUMMARY
    CONTAINERS="$(host_containers_json)" || return 1
    SUMMARY="$(jq -e --arg name "$NAME" 'first(.[] | select(.name == $name or .id == $name))' <<< "$CONTAINERS")" || {
        echo "No container named ${NAME}." >&2

        return 1
    }

    local UNIT
    UNIT="$(jq -r '.unit // empty' <<< "$SUMMARY")"

    case "$ACTION" in
        inspect)
            local INSPECT SOURCE="" RESTARTS
            INSPECT="$("${LPOD_PODMAN_BINARY:-podman}" container inspect "$NAME")" || return 1

            local QUADLET
            QUADLET="$(jq -r '.quadlet // empty' <<< "$SUMMARY")"

            if [ -n "$QUADLET" ]; then
                local UNITS
                UNITS="$(quadlet_units_json)" || return 1
                SOURCE="$(quadlet_sources_json "$(jq --arg name "$QUADLET" 'map(select(.Name == $name))' <<< "$UNITS")" | jq -r '.[0].content // ""')"
            fi

            if [ -n "$UNIT" ]; then
                RESTARTS="$("${SYSTEMCTL_CMD[@]}" show "$UNIT" --property=NRestarts --value 2>/dev/null)"
            fi

            jq -n \
                --argjson contract "$LPOD_CONTRACT" \
                --slurpfile summary <(printf '%s' "$SUMMARY") \
                --slurpfile inspect <(printf '%s' "$INSPECT") \
                --rawfile source <(printf '%s' "$SOURCE") \
                --arg restarts "${RESTARTS:-}" '
                $summary[0] as $summary | $inspect[0] as $inspect |
                def directives($key): $source | split("\n") | map(select(startswith($key + "=")) | ltrimstr($key + "=") | sub("\\s+$"; ""));
                def time: if . == null or . == "" or (startswith("0001-")) then null else sub("\\.[0-9]+"; "") end;
                def unquote: if (startswith("\"") and endswith("\"")) then .[1:-1] else . end;
                ($inspect[0]) as $c
                | ($c.Config.Healthcheck // null) as $check
                | {
                    contract: $contract,
                    container: ($summary + {
                        created_at: ($c.Created | time),
                        memory_limit: (if ($c.HostConfig.Memory // 0) > 0 then $c.HostConfig.Memory else null end),
                        restart_policy: (if $source != "" then (directives("Restart") | last // "no") else ($c.HostConfig.RestartPolicy.Name // null | if . == "" then null else . end) end),
                        restarts: (if $restarts != "" then ($restarts | tonumber) else ($c.RestartCount // 0) end),
                        user: ($c.Config.User // "" | if . == "" then null else . end),
                        auto_update: ($c.Config.Labels["io.containers.autoupdate"] // null),
                        digest: ($c.ImageDigest // null),
                        health_check: (if $check == null or ($check.Test // []) == [] or $check.Test[0] == "NONE" then null else {
                            command: ($check.Test[1:] | join(" ")),
                            interval: (if ($check.Interval // 0) > 0 then "\($check.Interval / 1000000000 | floor)s" else null end),
                            last_check: (($c.State.Health.Log // []) | last | .End // null | time)
                        } end),
                        mounts: [($c.Mounts // [])[] | {
                            type: .Type,
                            source: (if .Type == "volume" then .Name else .Source end),
                            destination: .Destination,
                            mode: ([if .RW then "rw" else "ro" end] + [(.Options // [])[] | select(. == "Z" or . == "z")] | join(","))
                        }],
                        networks: [($c.NetworkSettings.Networks // {}) | to_entries[] | {name: .key, ip: (.value.IPAddress // "" | if . == "" then null else . end)}],
                        secrets: [directives("Secret")[] | split(",") | {
                            name: .[0],
                            type: ((map(select(startswith("type="))) | first // "type=mount") | ltrimstr("type=")),
                            target: ((map(select(startswith("target="))) | first // null) | if . == null then null else ltrimstr("target=") end)
                        } | .target //= .name],
                        environment: (if $source != "" then
                            [directives("Environment")[] | unquote | capture("^(?<name>[^=]+)=(?<value>.*)$") | {name, value: (.value | unquote)}]
                        else
                            [($c.Config.Env // [])[] | capture("^(?<name>[^=]+)=(?<value>.*)$") | select(.name | IN("PATH", "HOSTNAME", "HOME", "TERM", "container") | not)]
                        end)
                    })
                }'
            ;;

        logs)
            local LINES=200

            while [ $# -gt 0 ]; do
                case "$1" in
                    --lines) LINES="${2:-}"; shift ;;
                    --json) ;;
                    *) echo "Unknown option: $1" >&2; return 1 ;;
                esac

                shift
            done

            valid_lines "$LINES" || return 1

            local ENTRIES

            if [ -n "$UNIT" ]; then
                ENTRIES="$(journal_entries_json --unit "$UNIT" --lines="$LINES")" || return 1
            else
                # Containers outside Quadlet log to Podman, not the journal...
                ENTRIES="$("${LPOD_PODMAN_BINARY:-podman}" logs --timestamps --tail "$LINES" "$NAME" 2>&1 | jq -Rs --arg unit "$NAME" '
                    split("\n") | map(select(. != "")) | map(capture("^(?<time>\\S+)\\s(?<message>.*)$") // {time: null, message: .})
                    | map({time: (.time // "" | sub("\\.[0-9]+"; "")), unit: $unit, priority: 6, message})')" || return 1
            fi

            jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, entries: .}' <<< "$ENTRIES"
            ;;

        stats)
            local STATS
            STATS="$("${LPOD_PODMAN_BINARY:-podman}" stats --no-stream --format '{{json .}}' "$NAME" 2>/dev/null)" || {
                echo "${NAME} isn't running, so it has no stats." >&2

                return 1
            }

            # Totals since the container started; a tool works out the rates
            # from two samples and their sampled_at...
            jq -s --argjson contract "$LPOD_CONTRACT" --arg now "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" '
                first as $s
                | def network($key; $legacy): if ($s.Network // null) != null then ([$s.Network[] | .[$key] // 0] | add // 0) else ($s[$legacy] // null) end;
                {
                    contract: $contract,
                    stats: {
                        cpu: ($s.CPU // null),
                        memory: ($s.MemUsage // null),
                        memory_limit: ($s.MemLimit // null),
                        net_in: network("RxBytes"; "NetInput"),
                        net_out: network("TxBytes"; "NetOutput"),
                        block_in: ($s.BlockInput // null),
                        block_out: ($s.BlockOutput // null),
                        pids: ($s.PIDs // null),
                        sampled_at: $now
                    }
                }' <<< "$STATS"
            ;;

        start|stop|restart)
            # Managed containers go through systemd, so the unit and Quadlet
            # stay in step. Without a unit, Podman acts on the container...
            if [ -n "$UNIT" ]; then
                "${SYSTEMCTL_CMD[@]}" --no-block "$ACTION" "$UNIT" || return 1
            else
                "${LPOD_PODMAN_BINARY:-podman}" "$ACTION" "$NAME" > /dev/null || return 1
            fi

            json_ok
            ;;

        exec)
            local STDIN=false
            local EXEC_ARGS=()

            while [ $# -gt 0 ]; do
                case "$1" in
                    --stdin) STDIN=true ;;
                    --user) EXEC_ARGS+=(--user "${2:-}"); shift ;;
                    --workdir) EXEC_ARGS+=(--workdir "${2:-}"); shift ;;
                    --json) ;;
                    --) shift; break ;;
                    *) echo "Unknown option: $1" >&2; return 1 ;;
                esac

                shift
            done

            if [ $# -eq 0 ]; then
                echo "Usage: lpod container NAME exec [--stdin] [--user USER] [--workdir DIR] --json -- COMMAND [ARG...]" >&2

                return 1
            fi

            if [ "$(jq -r '.state' <<< "$SUMMARY")" != "running" ]; then
                echo "${NAME} isn't running, so nothing can run in it." >&2

                return 1
            fi

            local OUT ERR CODE=0
            OUT="$(mktemp)" && ERR="$(mktemp)" || return 1

            # Without --stdin, the command reads nothing, so it never waits on
            # the SSH session's input...
            if [ "$STDIN" == true ]; then
                "${LPOD_PODMAN_BINARY:-podman}" exec --interactive "${EXEC_ARGS[@]}" "$NAME" "$@" > "$OUT" 2> "$ERR" || CODE=$?
            else
                "${LPOD_PODMAN_BINARY:-podman}" exec "${EXEC_ARGS[@]}" "$NAME" "$@" > "$OUT" 2> "$ERR" < /dev/null || CODE=$?
            fi

            # 125 is Podman's own error, such as an unknown user, not the command's...
            if [ "$CODE" -eq 125 ]; then
                cat "$ERR" >&2
                rm -f "$OUT" "$ERR"

                return 1
            fi

            jq -n \
                --argjson contract "$LPOD_CONTRACT" \
                --argjson code "$CODE" \
                --rawfile stdout <(tail -c 65536 "$OUT") \
                --rawfile stderr <(tail -c 65536 "$ERR") \
                '{contract: $contract, exit_code: $code, stdout: $stdout, stderr: $stderr}'

            rm -f "$OUT" "$ERR"
            ;;

        *)
            echo "Usage: lpod container NAME inspect|logs|stats|exec|start|stop|restart --json" >&2

            return 1
            ;;
    esac
}

# Where "lpod auto-update --dry-run" keeps the images that have an update...
function auto_update_cache {
    echo "${XDG_CACHE_HOME:-$HOME/.cache}/lpod/auto-update.json"
}

# "lpod images --json"...
function cmd_images_json {
    require_jq

    local IMAGES CONTAINERS UPDATES="[]"
    IMAGES="$("${LPOD_PODMAN_BINARY:-podman}" images --all --format json)" || return 1
    CONTAINERS="$(host_containers_json)" || return 1

    if [ -f "$(auto_update_cache)" ]; then
        UPDATES="$(cat "$(auto_update_cache)")"
    fi

    local INSPECT
    INSPECT="$(container_inspect_all_json)" || return 1

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile images <(printf '%s' "$IMAGES") \
        --slurpfile containers <(printf '%s' "$CONTAINERS") \
        --slurpfile inspect <(printf '%s' "$INSPECT") \
        --slurpfile updates <(printf '%s' "${UPDATES:-[]}") '
        $images[0] as $images | $containers[0] as $containers | $inspect[0] as $inspect | $updates[0] as $updates |
        def iso: if . == null then null else (tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
        ($inspect | map({name: .Name, image: .Image, auto_update: (.Config.Labels["io.containers.autoupdate"] // null)})) as $uses
        | {
            contract: $contract,
            images: ($images
                | map(select((.ReadOnly // false) | not))
                | map(
                    . as $image
                    | ((.Names // []) | first // null) as $reference
                    | [$uses[] | select(. as $use | ($use.image // "") != "" and (($image.Id | startswith($use.image)) or ($use.image | startswith($image.Id))))] as $used
                    | ([$used[].name] as $names | [$containers[] | select(.name as $n | $names | index($n)) | .application | select(. != null)] | unique) as $applications
                    | {
                        id: (.Id[0:12]),
                        repository: (if $reference == null then null else ($reference | sub(":[^:/]+$"; "")) end),
                        tag: (if $reference == null then null else ($reference | capture(":(?<tag>[^:/]+)$").tag // "latest") end),
                        size: (.Size // null),
                        created_at: (.Created | iso),
                        used_by: $applications,
                        containers: ($used | length),
                        dangling: ($reference == null),
                        auto_update: (first($used[].auto_update | select(. != null)) // null),
                        update: (if $reference != null and any($updates[]; .Image == $reference and .Updated == "pending")
                            then ($reference | capture(":(?<tag>[^:/]+)$").tag // "latest") else null end)
                    })
                | sort_by(.dangling, .repository, .tag))
        }'
}

# "lpod image pull REF --json" and "lpod image rm ID --json"...
function cmd_image_json {
    require_jq

    local ACTION="${1:-}"
    local TARGET="${2:-}"
    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"

    case "$ACTION" in
        pull)
            if ! [[ "$TARGET" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]]; then
                echo "Invalid image reference: ${TARGET}." >&2

                return 1
            fi

            "$PODMAN" pull --quiet "$TARGET" > /dev/null || return 1
            ;;

        rm)
            if ! [[ "$TARGET" =~ ^[a-f0-9]{12,64}$ ]]; then
                echo "Remove an image by its ID." >&2

                return 1
            fi

            "$PODMAN" image rm "$TARGET" > /dev/null || return 1
            ;;

        *)
            echo "Usage: lpod image pull REF|rm ID --json" >&2

            return 1
            ;;
    esac

    json_ok
}

# Prints the outcome of a prune: the REMOVED names on stdin, and the bytes
# RECLAIMED (or "null" when unknown)...
function prune_result_json {
    local RECLAIMED="$1"

    jq -Rs --argjson contract "$LPOD_CONTRACT" --argjson reclaimed "$RECLAIMED" '{
        contract: $contract,
        removed: (split("\n") | map(select(. != "")) | map(if test("^[a-f0-9]{64}$") then .[0:12] else . end)),
        reclaimed: $reclaimed
    }'
}

# "lpod images prune --json": removes every image no container uses...
function cmd_images_prune_json {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local RECLAIMED
    RECLAIMED="$("$PODMAN" images --format json | jq '[.[] | select((.Containers // 0) == 0 and ((.ReadOnly // false) | not)) | .Size // 0] | add // 0')"

    "$PODMAN" image prune --all --force | prune_result_json "${RECLAIMED:-null}"
}

# "lpod auto-update --dry-run --json": asks the registries which images have
# an update, and keeps the answer for "lpod images"...
function cmd_auto_update_json {
    require_jq

    if [ "${1:-}" != "--dry-run" ]; then
        echo "Usage: lpod auto-update --dry-run --json" >&2

        return 1
    fi

    local RESULT
    RESULT="$("${LPOD_PODMAN_BINARY:-podman}" auto-update --dry-run --format json)" || return 1

    mkdir -p "$(dirname "$(auto_update_cache)")" || return 1
    jq 'if type == "array" then . else [] end' <<< "${RESULT:-[]}" > "$(auto_update_cache)" || return 1

    json_ok
}

# "lpod pods --json": every pod, with the application its Quadlet (or the
# Quadlets of its containers) belong to, its containers and the ports its
# infra container publishes...
function cmd_pods_json {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local PODS PS UNITS
    PODS="$("$PODMAN" pod ps --format json)" || return 1
    PS="$("$PODMAN" ps --all --format json)" || return 1
    UNITS="$(quadlet_units_json 2>/dev/null)" || UNITS="[]"

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile pods <(printf '%s' "${PODS:-[]}") \
        --slurpfile ps <(printf '%s' "${PS:-[]}") \
        --slurpfile units <(printf '%s' "${UNITS:-[]}") '
        $pods[0] as $pods | $ps[0] as $ps | $units[0] as $units
        | def unit($name): if $name == null then null else first($units[] | select(.UnitName == $name)) // null end;
        def time: if . == null or . == "" then null else sub("\\.[0-9]+"; "") end;
        ($pods // [])
        | map(
            . as $pod
            | ($ps // [] | map(select(.Pod == $pod.Id))) as $members
            | (first($members[] | select(.IsInfra // false)) // null) as $infra
            | ($members | map(select((.IsInfra // false) | not))) as $containers
            | unit(($pod.Labels // {}).PODMAN_SYSTEMD_UNIT // ($infra.Labels // {}).PODMAN_SYSTEMD_UNIT // null) as $own
            | (first($containers[] | unit((.Labels // {}).PODMAN_SYSTEMD_UNIT // null) | select(. != null)) // null) as $member
            | {
                id: (.Id[0:12]),
                name: .Name,
                status: ((.Status // "unknown") | ascii_downcase),
                application: (($own // $member).app // null),
                quadlet: ($own.Name // null),
                unit: ($own.UnitName // null),
                containers: ($containers | length),
                running: ($containers | map(select(.State == "running")) | length),
                ports: [($infra.Ports // [])[] | "\(if (.host_ip // "") == "" then "0.0.0.0" else .host_ip end):\(.host_port)->\(.container_port)/\(.protocol // "tcp")"],
                networks: (.Networks // []),
                created_at: (.Created | time)
            })
        | sort_by(.application == null, .application, .name)
        | {contract: $contract, pods: .}'
}

# "lpod containers prune --json": removes every stopped container. Quadlet
# recreates its containers when their units start...
function cmd_containers_prune_json {
    require_jq

    "${LPOD_PODMAN_BINARY:-podman}" container prune --force | prune_result_json null
}

# "lpod events --json [--since DURATION] [--limit N]": what happened to
# containers and images lately, newest first, with the application each
# container belongs to...
function cmd_events_json {
    require_jq

    local WINDOW="24h" LIMIT=50

    while [ $# -gt 0 ]; do
        case "$1" in
            --since) WINDOW="${2:-}"; shift ;;
            --limit) LIMIT="${2:-}"; shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if ! [[ "$WINDOW" =~ ^[0-9]{1,5}[smh]$ ]]; then
        echo "--since takes a duration such as 30m or 24h." >&2

        return 1
    fi

    if ! [[ "$LIMIT" =~ ^[1-9][0-9]{0,2}$ ]]; then
        echo "--limit takes a number from 1 to 999." >&2

        return 1
    fi

    local EVENTS UNITS
    EVENTS="$("${LPOD_PODMAN_BINARY:-podman}" events --stream=false --since "$WINDOW" --filter type=container --filter type=image --format json 2>/dev/null)" || return 1
    UNITS="$(quadlet_units_json 2>/dev/null)" || UNITS="[]"

    jq -s \
        --argjson contract "$LPOD_CONTRACT" \
        --argjson limit "$LIMIT" \
        --slurpfile units <(printf '%s' "${UNITS:-[]}") '
        ($units[0] | map({key: .UnitName, value: .app}) | from_entries) as $apps
        | def iso: if . == null then null else (. / 1000000000 | floor | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
        map(select(
            (.Type == "container" and (.Status | IN("start", "stop", "died", "remove", "restart")))
            or (.Type == "image" and (.Status | IN("pull", "remove")))
        ))
        | map((.Attributes // {}) as $labels | {
            time: (.timeNano // null | iso),
            type: .Type,
            action: .Status,
            name: (if .Type == "image" then (.Name // .ID) else .Name end),
            image: (if .Type == "container" then (.Image // null) else null end),
            application: ($apps[$labels.PODMAN_SYSTEMD_UNIT // ""] // null),
            exit_code: (if .Status == "died" then (.ContainerExitCode // null) else null end)
        })
        | sort_by(.time) | reverse | .[:$limit]
        | {contract: $contract, events: .}' <<< "$EVENTS"
}

# "lpod volumes sizes --json": the disk space each named and anonymous volume
# uses, in bytes. It walks every file of every volume, so it can take a while
# on big ones, which is why "volumes" leaves size null and callers ask for
# this on its own. Volumes backed by a folder, a device or an NFS share (a
# "device" option) are left out: they can be a whole media library, or remote.
# A rootless user's volumes hold files owned by its subordinate IDs, which
# only "podman unshare" can read all of.
function cmd_volumes_sizes_json {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local VOLUMES
    VOLUMES="$("$PODMAN" volume inspect --all)" || return 1

    local LOCAL
    LOCAL="$(jq -c '[.[] | select((.Driver // "local") == "local" and (.Options.device // "") == "" and (.Mountpoint // "") != "") | {name: .Name, path: .Mountpoint}]' <<< "$VOLUMES")" || return 1

    local -a PATHS
    mapfile -t PATHS < <(jq -r '.[].path' <<< "$LOCAL")

    # du still prints the totals it could work out when it can't read some
    # files, and exits non-zero then, so its exit code isn't a failure here.
    local USAGE=""
    if [ ${#PATHS[@]} -gt 0 ]; then
        local DU=(du -s --block-size=1 --)

        if [ "$(id -u)" -ne 0 ]; then
            DU=("$PODMAN" unshare du -s --block-size=1 --)
        fi

        USAGE="$("${DU[@]}" "${PATHS[@]}" 2> /dev/null || true)"
    fi

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --argjson volumes "$LOCAL" \
        --rawfile usage <(printf '%s' "$USAGE") '
        ($usage | split("\n") | map(select(. != "") | capture("^(?<size>[0-9]+)\t(?<path>.+)$")) | map({(.path): (.size | tonumber)}) | add // {}) as $sizes
        | {contract: $contract, sizes: ($volumes | map({name, size: ($sizes[.path] // null)}) | sort_by(.name))}'
}

# "lpod volumes --json"...
function cmd_volumes_json {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local VOLUMES UNITS SOURCES CONTAINERS INSPECT
    VOLUMES="$("$PODMAN" volume inspect --all)" || return 1
    UNITS="$(quadlet_units_json)" || return 1
    SOURCES="$(quadlet_sources_json "$UNITS")"
    CONTAINERS="$(host_containers_json)" || return 1
    INSPECT="$(container_inspect_all_json)" || return 1

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile volumes <(printf '%s' "${VOLUMES:-[]}") \
        --slurpfile units <(printf '%s' "$UNITS") \
        --slurpfile sources <(printf '%s' "$SOURCES") \
        --slurpfile containers <(printf '%s' "$CONTAINERS") \
        --slurpfile inspect <(printf '%s' "$INSPECT") '
        $volumes[0] as $volumes | $units[0] as $units | $sources[0] as $sources | $containers[0] as $containers | $inspect[0] as $inspect |
        def source($name): first($sources[] | select(.name == $name) | .content) // "";
        def directive($content; $key): $content | split("\n") | map(select(startswith($key + "=")) | ltrimstr($key + "=") | sub("\\s+$"; "")) | last;
        def app_of($name): first($containers[] | select(.name == $name) | .application) // null;
        ($units | map(select(.ext == "volume")) | map({name: (directive(source(.Name); "VolumeName") // "systemd-\(.base)"), quadlet: .Name})) as $volume_units
        | ($units | map(select(.ext == "container")) | map(.Name as $quadlet | source(.Name) | split("\n") | map(select(startswith("Volume=")) | ltrimstr("Volume=") | split(":")[0] // "" | select(test("^[A-Za-z0-9][A-Za-z0-9_.-]*$") and (endswith(".volume") | not)) | {name: ., quadlet: $quadlet})) | add // []) as $inline
        | ($inspect | map(.Name as $container | (.Mounts // [])[] | {container: $container, type: .Type, name: .Name, source: .Source})) as $mounts
        | def users(f): [$mounts[] | select(f)] | map(.container) | unique;
        {
            contract: $contract,
            volumes: (
                ($volumes | map(
                    . as $volume
                    | users(.type == "volume" and .name == $volume.Name) as $users
                    | {
                        name: .Name,
                        quadlet: (first($volume_units[] | select(.name == $volume.Name) | .quadlet) // first($inline[] | select(.name == $volume.Name) | .quadlet) // null),
                        driver: (.Driver // "local"),
                        mountpoint: (if (.Options.device // "") != "" then .Options.device else .Mountpoint end),
                        size: null,
                        type: (if .Anonymous // false then "anonymous" elif (.Options.type // "") == "nfs" then "nfs" elif (.Options.device // "") != "" then "device" else "named" end),
                        containers: $users,
                        applications: ([$users[] | app_of(.) | select(. != null)] | unique)
                    }))
                + ([$mounts[] | select(.type == "bind") | .source] | unique | map(
                    . as $path
                    | users(.type == "bind" and .source == $path) as $users
                    | {
                        name: $path,
                        quadlet: null,
                        driver: "local",
                        mountpoint: $path,
                        size: null,
                        type: "bind",
                        containers: $users,
                        applications: ([$users[] | app_of(.) | select(. != null)] | unique)
                    }))
            )
        }'
}

# "lpod volume rm NAME --json", "lpod volume export NAME [--stop] --json"...
function cmd_volume_json {
    require_jq

    if [ "${1:-}" == "export" ]; then
        shift
        volume_export "$@"

        return
    fi

    if [ "${1:-}" != "rm" ]; then
        echo "Usage: lpod volume rm|export NAME --json" >&2

        return 1
    fi

    valid_name "${2:-}" || return 1

    "${LPOD_PODMAN_BINARY:-podman}" volume rm "$2" > /dev/null || return 1

    json_ok
}

# The applications "volume export --stop" stopped, which it starts again on
# its way out, whether the export worked or not...
LPOD_EXPORT_STOPPED=()

function volume_export_restart {
    local APP LPOD_BIN
    LPOD_BIN="$(realpath "$0")"

    for APP in "${LPOD_EXPORT_STOPPED[@]}"; do
        if ! "$LPOD_BIN" "$APP" up --no-block --json > /dev/null 2>&1; then
            echo "Couldn't start ${APP} again." >&2
            LPOD_EXPORT_FAILED=true
        fi
    done

    LPOD_EXPORT_STOPPED=()
}

# "lpod volume export NAME [--stop] --json": writes the contents of the
# volume NAME to stdout as a tar archive ("podman volume export"), and
# nothing else, so a tool can stream it into a file. A volume with a "device"
# option (bind-backed, such as a media library, or NFS) is refused, since its
# archive would be the whole folder or share. With --stop, the applications
# whose running containers use the volume stop first, for a consistent copy,
# and start again afterwards, also when the export fails or the reader goes
# away...
function volume_export {
    local NAME="${1:-}"
    shift || true

    local STOP=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --stop) STOP=true ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    valid_name "$NAME" || return 1

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local VOLUME DEVICE
    VOLUME="$("$PODMAN" volume inspect "$NAME" 2> /dev/null)" || {
        echo "No volume named ${NAME}." >&2

        return 1
    }
    DEVICE="$(jq -r '.[0].Options.device // ""' <<< "$VOLUME")"

    if [ -n "$DEVICE" ]; then
        echo "${NAME} is backed by ${DEVICE}, outside Podman's storage, so lpod doesn't export it. Back that up on the host instead." >&2

        return 1
    fi

    LPOD_EXPORT_FAILED=false

    if [ "$STOP" == true ]; then
        local UNITS RUNNING APP
        UNITS="$(quadlet_units_json)" || return 1
        RUNNING="$("$PODMAN" ps --filter "volume=${NAME}" --format json)" || return 1

        trap volume_export_restart EXIT
        trap 'exit 1' HUP INT TERM PIPE

        while IFS= read -r APP; do
            LPOD_EXPORT_STOPPED+=("$APP")

            if ! "$(realpath "$0")" "$APP" down --json > /dev/null; then
                echo "Couldn't stop ${APP}." >&2

                return 1
            fi
        done < <(jq -r --slurpfile units <(printf '%s' "$UNITS") '
            [.[] | .Labels.PODMAN_SYSTEMD_UNIT // empty | . as $unit | first($units[0][] | select(.UnitName == $unit) | .app) // empty]
            | unique[]' <<< "${RUNNING:-[]}")
    fi

    "$PODMAN" volume export "$NAME" || {
        echo "Couldn't export ${NAME}." >&2
        volume_export_restart

        return 1
    }

    volume_export_restart

    if [ "$LPOD_EXPORT_FAILED" == true ]; then
        return 1
    fi
}

# "lpod volumes prune --json": removes every volume no container uses, with
# its data...
function cmd_volumes_prune_json {
    require_jq

    "${LPOD_PODMAN_BINARY:-podman}" volume prune --force | prune_result_json null
}

# "lpod networks --json"...
function cmd_networks_json {
    require_jq

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local NETWORKS UNITS SOURCES CONTAINERS INSPECT
    NETWORKS="$("$PODMAN" network ls --format json)" || return 1
    UNITS="$(quadlet_units_json)" || return 1
    SOURCES="$(quadlet_sources_json "$UNITS")"
    CONTAINERS="$(host_containers_json)" || return 1
    INSPECT="$(container_inspect_all_json)" || return 1

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile networks <(printf '%s' "$NETWORKS") \
        --slurpfile units <(printf '%s' "$UNITS") \
        --slurpfile sources <(printf '%s' "$SOURCES") \
        --slurpfile containers <(printf '%s' "$CONTAINERS") \
        --slurpfile inspect <(printf '%s' "$INSPECT") '
        $networks[0] as $networks | $units[0] as $units | $sources[0] as $sources | $containers[0] as $containers | $inspect[0] as $inspect |
        def source($name): first($sources[] | select(.name == $name) | .content) // "";
        def directive($content; $key): $content | split("\n") | map(select(startswith($key + "=")) | ltrimstr($key + "=") | sub("\\s+$"; "")) | last;
        def app_of($name): first($containers[] | select(.name == $name) | .application) // null;
        ($units | map(select(.ext == "network")) | map({name: (directive(source(.Name); "NetworkName") // "systemd-\(.base)"), quadlet: .Name})) as $network_units
        | ($units | map(select(.ext == "container" or .ext == "pod")) | map(.app as $app | source(.Name) | split("\n") | map(select(startswith("Network=")) | ltrimstr("Network=") | split(":")[0] | {quadlet: ., app: $app})) | add // []) as $references
        | ($inspect | map(.Name as $container | (.NetworkSettings.Networks // {}) | keys[] | {container: $container, network: .})) as $attached
        | {
            contract: $contract,
            networks: ($networks | map(
                . as $network
                | (first($network_units[] | select(.name == $network.name) | .quadlet) // null) as $quadlet
                | [$attached[] | select(.network == $network.name) | .container] as $users
                | {
                    name: .name,
                    quadlet: $quadlet,
                    driver: (.driver // "bridge"),
                    subnet: ((.subnets // []) | first | .subnet // null),
                    gateway: ((.subnets // []) | first | .gateway // null),
                    dns: (.dns_enabled // false),
                    internal: (.internal // false),
                    ipv6: (.ipv6_enabled // false),
                    containers: ($users | unique | length),
                    applications: ([($users[] | app_of(.)), ($references[] | select(.quadlet == $quadlet or .quadlet == $network.name) | .app)] | map(select(. != null)) | unique),
                    default: (.name == "podman")
                }) | sort_by((.default | not), .name))
        }'
}

