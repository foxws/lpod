# "lpod journal --json [--lines N] [--since TIME|boot] [--priority N]": the
# journal of every unit the installed Quadlets generate, plus the auto-update
# service...
function cmd_journal_json {
    require_jq

    local LINES=500
    local FILTER=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --lines) LINES="${2:-}"; shift ;;
            --since)
                if [ "${2:-}" == "boot" ]; then
                    FILTER+=(--boot)
                else
                    FILTER+=(--since "${2:-}")
                fi
                shift
                ;;
            --priority)
                if ! [[ "${2:-}" =~ ^[0-7]$ ]]; then
                    echo "--priority takes a number from 0 to 7." >&2

                    return 1
                fi
                FILTER+=(--priority "$2")
                shift
                ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    valid_lines "$LINES" || return 1

    local UNITS UNIT_ARGS=(--unit podman-auto-update.service)
    UNITS="$(quadlet_units_json)" || return 1

    local UNIT
    while IFS= read -r UNIT; do
        UNIT_ARGS+=(--unit "$UNIT")
    done < <(jq -r '.[] | .UnitName // empty' <<< "$UNITS")

    local ENTRIES
    ENTRIES="$(journal_entries_json "${UNIT_ARGS[@]}" --lines="$LINES" "${FILTER[@]}")" || return 1

    jq --argjson contract "$LPOD_CONTRACT" '{contract: $contract, entries: .}' <<< "$ENTRIES"
}

# Checks that NAME is a plain Quadlet file name, so a file never lands
# outside the directory it is written to...
function valid_quadlet_file {
    if ! [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}\.(container|pod|volume|network|kube|image|build|env|yaml|yml)$ ]]; then
        echo "Invalid Quadlet file name: ${1}." >&2

        return 1
    fi
}

# Writes the files of a '{"files": [{name, content}]}' document on stdin into
# DIRECTORY...
function write_stdin_files {
    local DIRECTORY="$1"
    local DOCUMENT NAMES NAME

    DOCUMENT="$(cat)"
    mapfile -t NAMES < <(jq -r '.files[]?.name' <<< "$DOCUMENT")

    if [ ${#NAMES[@]} -eq 0 ]; then
        echo 'Pass {"files": [{"name": ..., "content": ...}]} on stdin.' >&2

        return 1
    fi

    for NAME in "${NAMES[@]}"; do
        valid_quadlet_file "$NAME" || return 1
        jq -j --arg name "$NAME" 'first(.files[] | select(.name == $name)) | .content' <<< "$DOCUMENT" > "${DIRECTORY}/${NAME}" || return 1
    done
}

# Finds the Quadlet generator, which "lpod quadlet check" runs with -dryrun...
function quadlet_generator {
    local CANDIDATE

    for CANDIDATE in "${LPOD_QUADLET_BINARY:-}" /usr/libexec/podman/quadlet /usr/lib/podman/quadlet /usr/local/libexec/podman/quadlet; do
        if [ -n "$CANDIDATE" ] && [ -x "$CANDIDATE" ]; then
            echo "$CANDIDATE"

            return
        fi
    done

    echo "The Quadlet generator was not found. Set LPOD_QUADLET_BINARY to its path." >&2

    return 1
}

# "lpod quadlet check|install|fetch|catalog|tags ... --json"...
function cmd_quadlet_json {
    require_jq

    local ACTION="${1:-}"
    shift || true

    case "$ACTION" in
        check) cmd_quadlet_check "$@" ;;
        install) cmd_quadlet_install "$@" ;;
        fetch) cmd_quadlet_fetch "$@" ;;
        catalog) cmd_quadlet_catalog "$@" ;;
        tags) cmd_quadlet_tags "$@" ;;
        head) cmd_quadlet_head "$@" ;;
        *)
            echo "Usage: lpod quadlet check|install|fetch|catalog|tags|head ... --json" >&2

            return 1
            ;;
    esac
}

# "lpod quadlet check --stdin --json": runs the files through the Quadlet
# generator with -dryrun, next to the installed Quadlets they may reference...
function cmd_quadlet_check {
    local GENERATOR WORK
    GENERATOR="$(quadlet_generator)" || return 1
    WORK="$(mktemp -d)" || return 1
    # shellcheck disable=SC2064
    trap "rm -rf '${WORK}'" RETURN

    write_stdin_files "$WORK" || return 1

    local SCOPE_ARGS=()
    if [ "$(id -u)" -ne 0 ]; then
        SCOPE_ARGS=(-user)
    fi

    # The generator logs "Loading source unit file PATH" and "Loading source
    # drop-in file PATH" for every file it reads (Podman 6.1 does so without
    # -v), so those lines aren't problems. A drop-in's path names its unit
    # (hello.container.d/lpod-ondemand.conf), so it would count as one.
    local OUTPUT ERRORS
    OUTPUT="$(QUADLET_UNIT_DIRS="${WORK}:$(quadlet_unit_path)" "$GENERATOR" -dryrun "${SCOPE_ARGS[@]}" 2> "${WORK}/.errors")"
    ERRORS="$(cat "${WORK}/.errors")"

    local NAMES
    NAMES="$(find "$WORK" -maxdepth 1 -type f ! -name '.errors' -printf '%f\n' | jq -R . | jq -s .)"

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --slurpfile names <(printf '%s' "$NAMES") \
        --rawfile output <(printf '%s' "$OUTPUT") \
        --rawfile errors <(printf '%s' "$ERRORS") '
        $names[0] as $names |
        ($names | map(sub("\\.[^.]+$"; ""))) as $bases
        | ($errors | split("\n") | map(select(. != "")) | map(sub("^quadlet-generator\\[[0-9]+\\]: "; "")) | map(select(test("^Loading source (unit|drop-in) file ") | not)) | map(select(. as $line | any($names[]; . as $name | $line | contains($name))))) as $problems
        | ($output | split("\n") | map(capture("^---(?<unit>.+)---$").unit // empty) | map(select(. as $unit | any($bases[]; . as $base | $unit | startswith($base))))) as $units
        | {contract: $contract, valid: ($problems | length == 0), errors: $problems, units: $units}'
}

# "lpod quadlet install APP [--replace] [--start] --stdin --json": installs the
# files as the application APP with "podman quadlet install", then starts its
# units...
function cmd_quadlet_install {
    local APPLICATION="${1:-}"
    shift || true

    if ! [[ "$APPLICATION" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || [[ "$APPLICATION" =~ \.(container|pod|volume|network|kube|image|build)$ ]]; then
        echo "Invalid application name: ${APPLICATION}." >&2

        return 1
    fi

    local REPLACE_FILES=false START=false STDIN=false

    while [ $# -gt 0 ]; do
        case "$1" in
            --replace) REPLACE_FILES=true ;;
            --start) START=true ;;
            --stdin) STDIN=true ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if [ "$STDIN" != true ]; then
        echo "Pass the files on stdin, with --stdin." >&2

        return 1
    fi

    local WORK
    WORK="$(mktemp -d)" || return 1
    # shellcheck disable=SC2064
    trap "rm -rf '${WORK}'" RETURN

    mkdir "${WORK}/${APPLICATION}" || return 1
    write_stdin_files "${WORK}/${APPLICATION}" || return 1

    "${LPOD_PODMAN_BINARY:-podman}" quadlet install --application="$APPLICATION" --replace="$REPLACE_FILES" "${WORK}/${APPLICATION}" > /dev/null || return 1

    if [ "$START" == true ]; then
        local SERVICES
        mapfile -t SERVICES < <(quadlet_units_json | jq -r --arg app "$APPLICATION" '.[] | select(.app == $app and (.ext | IN("container", "pod", "kube", "volume", "network"))) | .UnitName // empty')

        if [ ${#SERVICES[@]} -gt 0 ]; then
            "${SYSTEMCTL_CMD[@]}" --no-block start "${SERVICES[@]}" || return 1
        fi
    fi

    json_ok
}

# Checks the URL, branch or tag and directory of a Git repository that
# "quadlet fetch" and "quadlet catalog" clone, so neither git nor a path
# can be pointed anywhere else.
function check_git_source {
    local REPOSITORY="$1" REFERENCE="$2" DIRECTORY="$3"

    check_git_repository "$REPOSITORY" || return 1

    if ! [[ "$REFERENCE" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || [[ "$REFERENCE" == *..* ]]; then
        echo "Invalid branch or tag: ${REFERENCE}." >&2

        return 1
    fi

    if [ -n "$DIRECTORY" ] && { ! [[ "$DIRECTORY" =~ ^[A-Za-z0-9._-][A-Za-z0-9._/-]*$ ]] || [[ "$DIRECTORY" == *..* ]]; }; then
        echo "Invalid directory: ${DIRECTORY}." >&2

        return 1
    fi

}

# Checks a Git repository URL, so git can't be pointed at a local path or
# another transport, and that git is installed.
function check_git_repository {
    if ! [[ "$1" =~ ^(https://|ssh://|git@)[A-Za-z0-9][A-Za-z0-9._~:/@%+-]*$ ]]; then
        echo "Use an https://, ssh:// or git@ repository URL." >&2

        return 1
    fi

    if ! command -v git > /dev/null 2>&1; then
        echo "lpod needs git to fetch a repository." >&2

        return 1
    fi
}

# Makes a shallow clone of one branch or tag into DESTINATION, without
# prompting for credentials or allowing local and ext:: transports.
function clone_git_source {
    GIT_TERMINAL_PROMPT=0 git -c protocol.ext.allow=never -c protocol.file.allow=never clone --quiet --depth 1 --branch "$2" -- "$1" "$3"
}

# Whether FILE is a pods.yml lpod returns: a regular file of at most 64 KiB.
# A symlink is ignored, so a repository can't make lpod read a file on the
# host.
function is_readable_manifest {
    [ -f "$1" ] && [ ! -L "$1" ] && [ "$(wc -c < "$1")" -le 65536 ]
}

# "lpod quadlet fetch URL --ref REF [--path DIR] --json": prints the files in
# a directory of a Git repository, without installing them, and the nearest
# pods.yml manifest: the one in that directory, or else in a directory above
# it, up to the repository's root. "manifest_path" is the directory it was
# found in ("" for the root), which the paths of its sources are relative to.
function cmd_quadlet_fetch {
    local REPOSITORY="${1:-}"
    shift || true

    local REFERENCE="" DIRECTORY=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --ref) REFERENCE="${2:-}"; shift ;;
            --path) DIRECTORY="${2:-}"; shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    DIRECTORY="${DIRECTORY%/}"

    check_git_source "$REPOSITORY" "$REFERENCE" "$DIRECTORY" || return 1

    local WORK
    WORK="$(mktemp -d)" || return 1
    # shellcheck disable=SC2064
    trap "rm -rf '${WORK}'" RETURN

    clone_git_source "$REPOSITORY" "$REFERENCE" "${WORK}/repository" || return 1

    local SOURCE="${WORK}/repository${DIRECTORY:+/$DIRECTORY}"

    if [ ! -d "$SOURCE" ] || [ -L "$SOURCE" ]; then
        echo "${DIRECTORY} is not a directory in the repository." >&2

        return 1
    fi

    local COMMIT
    COMMIT="$(git -C "${WORK}/repository" rev-parse --short HEAD)"

    local MANIFEST_ARGS=(--argjson manifest null --argjson manifest_path null)
    local LOOKUP="$DIRECTORY"

    while true; do
        if is_readable_manifest "${WORK}/repository${LOOKUP:+/$LOOKUP}/pods.yml"; then
            MANIFEST_ARGS=(--rawfile manifest "${WORK}/repository${LOOKUP:+/$LOOKUP}/pods.yml" --arg manifest_path "$LOOKUP")

            break
        fi

        [ -z "$LOOKUP" ] && break

        if [[ "$LOOKUP" == */* ]]; then
            LOOKUP="${LOOKUP%/*}"
        else
            LOOKUP=""
        fi
    done

    # shellcheck disable=SC2094
    find "$SOURCE" -maxdepth 1 -type f -size -256k ! -name '.*' | sort | head -n 50 | while IFS= read -r FILE; do
        jq -Rs --arg name "$(basename "$FILE")" '{name: $name, content: .}' < "$FILE"
    done | jq -s --argjson contract "$LPOD_CONTRACT" --arg commit "$COMMIT" "${MANIFEST_ARGS[@]}" '{contract: $contract, commit: $commit, manifest: $manifest, manifest_path: $manifest_path, files: .}'
}

# "lpod quadlet catalog URL --ref REF --json": prints the pods.yml of every
# directory at the root of a Git repository that has one, so a tool such as
# Pods can offer each as an application. Up to 200 directories.
function cmd_quadlet_catalog {
    local REPOSITORY="${1:-}"
    shift || true

    local REFERENCE=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --ref) REFERENCE="${2:-}"; shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    check_git_source "$REPOSITORY" "$REFERENCE" "" || return 1

    local WORK
    WORK="$(mktemp -d)" || return 1
    # shellcheck disable=SC2064
    trap "rm -rf '${WORK}'" RETURN

    clone_git_source "$REPOSITORY" "$REFERENCE" "${WORK}/repository" || return 1

    local COMMIT
    COMMIT="$(git -C "${WORK}/repository" rev-parse --short HEAD)"

    find "${WORK}/repository" -mindepth 2 -maxdepth 2 -name pods.yml ! -path '*/.*/*' | sort | head -n 200 | while IFS= read -r FILE; do
        local DIRECTORY
        DIRECTORY="$(dirname "$FILE")"

        if [ -L "$DIRECTORY" ] || ! is_readable_manifest "$FILE"; then
            continue
        fi

        jq -Rs --arg path "$(basename "$DIRECTORY")" '{path: $path, manifest: .}' < "$FILE"
    done | jq -s --argjson contract "$LPOD_CONTRACT" --arg commit "$COMMIT" '{contract: $contract, commit: $commit, applications: .}'
}

# "lpod quadlet head URL --ref BRANCH --json": prints the newest commit of a
# branch of a Git repository, read with "git ls-remote" without cloning, or
# null when the repository has no such branch (such as for a tag)...
function cmd_quadlet_head {
    local REPOSITORY="${1:-}"
    shift || true

    local REFERENCE=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --ref) REFERENCE="${2:-}"; shift ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    if [ -z "$REFERENCE" ]; then
        echo "Pass the branch with --ref." >&2

        return 1
    fi

    check_git_source "$REPOSITORY" "$REFERENCE" "" || return 1

    local COMMIT
    COMMIT="$(GIT_TERMINAL_PROMPT=0 git -c protocol.ext.allow=never -c protocol.file.allow=never ls-remote --heads -- "$REPOSITORY" "refs/heads/${REFERENCE}" | cut -f 1 | head -n 1)" || return 1

    jq -n --argjson contract "$LPOD_CONTRACT" --arg branch "$REFERENCE" --arg commit "$COMMIT" \
        '{contract: $contract, branch: $branch, commit: (if $commit == "" then null else $commit end)}'
}

# "lpod quadlet tags URL --json": prints the tags of a Git repository, newest
# version first, each with the commit it points at, without cloning it. Up to
# 100, so a tool such as Pods can offer to update an application to a newer
# release. Tags that "quadlet fetch --ref" would refuse are left out.
function cmd_quadlet_tags {
    local REPOSITORY="${1:-}"
    shift || true

    while [ $# -gt 0 ]; do
        case "$1" in
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    check_git_repository "$REPOSITORY" || return 1

    local REFS
    REFS="$(GIT_TERMINAL_PROMPT=0 git -c protocol.ext.allow=never -c protocol.file.allow=never ls-remote --tags -- "$REPOSITORY")" || return 1

    # An annotated tag is listed twice: as the tag object, and peeled
    # ("TAG^{}") as the commit it points at, which is the one to keep. The
    # sort key turns the first "-" into "~", which "sort -V" puts before the
    # release itself, so v1.2.0-rc.1 comes after v1.2.0...
    local LINES
    LINES="$(awk -F'\t' '
        { name = $2; sub(/^refs\/tags\//, "", name) }
        name ~ /\^\{\}$/ { sub(/\^\{\}$/, "", name); peeled[name] = $1; next }
        { commit[name] = $1 }
        END { for (name in commit) print name "\t" (name in peeled ? peeled[name] : commit[name]) }
    ' <<< "$REFS" | grep -E '^[A-Za-z0-9][A-Za-z0-9._/-]*'$'\t' | grep -v '\.\.' \
        | awk -F'\t' '{ key = $1; sub(/-/, "~", key); print key "\t" $0 }' \
        | sort -t $'\t' -k1,1 -V -r | cut -f 2- | head -n 100)"

    jq -Rn --argjson contract "$LPOD_CONTRACT" '
        {contract: $contract, tags: [inputs | select(. != "") | split("\t") | {name: .[0], commit: .[1][0:7]}]}
    ' <<< "$LINES"
}

# "lpod APP remove [--volumes] [--images] [--secrets] --json": stops the
# application and removes its Quadlets, plus the data it owns when asked.
# Images and secrets that other applications use stay...
function cmd_app_remove_json {
    local APPLICATION="$1"
    shift

    local VOLUMES=false IMAGES=false SECRETS=false ARG

    for ARG in "$@"; do
        case "$ARG" in
            --volumes) VOLUMES=true ;;
            --images) IMAGES=true ;;
            --secrets) SECRETS=true ;;
            --json) ;;
            *) echo "Unknown option: $ARG" >&2; return 1 ;;
        esac
    done

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local UNITS SOURCES MINE
    UNITS="$(quadlet_units_json)" || return 1
    SOURCES="$(quadlet_sources_json "$UNITS")"
    MINE="$(jq --arg app "$APPLICATION" 'map(select(.app == $app))' <<< "$UNITS")"

    if [ "$(jq 'length' <<< "$MINE")" -eq 0 ]; then
        echo "No application named ${APPLICATION} is installed." >&2

        return 1
    fi

    local OWNED
    OWNED="$(jq -n --arg app "$APPLICATION" --slurpfile units <(printf '%s' "$UNITS") --slurpfile sources <(printf '%s' "$SOURCES") '
        $units[0] as $units | $sources[0] as $sources |
        def source($name): first($sources[] | select(.name == $name) | .content) // "";
        def directives($content; $key): $content | split("\n") | map(select(startswith($key + "=")) | ltrimstr($key + "=") | sub("\\s+$"; ""));
        def directive($content; $key): directives($content; $key) | last;
        def uses($unit; $key): directives(source($unit.Name); $key);
        ($units | map(select(.app == $app))) as $mine
        | ($units | map(select(.app != $app))) as $others
        | {
            volumes: ([$mine[] | select(.ext == "volume") | directive(source(.Name); "VolumeName") // "systemd-\(.base)"]
                + [$mine[] | select(.ext == "container") | uses(.; "Volume")[] | split(":")[0] // "" | select(test("^[A-Za-z0-9][A-Za-z0-9_.-]*$") and (endswith(".volume") | not))]) | unique,
            images: ([$mine[] | select(.ext == "container") | uses(.; "Image")[] | select(endswith(".build") or endswith(".image") | not)] | unique
                | map(select(. as $image | [$others[] | select(.ext == "container") | uses(.; "Image")[]] | index($image) | not))),
            secrets: ([$mine[] | select(.ext == "container") | uses(.; "Secret")[] | split(",")[0] // empty] | unique
                | map(select(. as $secret | [$others[] | select(.ext == "container") | uses(.; "Secret")[] | split(",")[0] // empty] | index($secret) | not)))
        }')"

    # Its timers go first, while their containers' drop-ins are still known...
    timers_remove "$APPLICATION" "$(timers_settings "$APPLICATION")" "$UNITS"

    # An application installed with --application is removed as a whole;
    # a lone Quadlet by its file name...
    if jq -e --arg app "$APPLICATION" 'any(.[]; (.App // "") == $app)' <<< "$MINE" > /dev/null; then
        "$PODMAN" quadlet rm --force --recursive "$APPLICATION" > /dev/null || return 1
    else
        local NAMES
        mapfile -t NAMES < <(jq -r '.[].Name' <<< "$MINE")
        "$PODMAN" quadlet rm --force "${NAMES[@]}" > /dev/null || return 1
    fi

    local ITEM

    if [ "$VOLUMES" == true ]; then
        while IFS= read -r ITEM; do
            "$PODMAN" volume rm --force "$ITEM" > /dev/null 2>&1 || true
        done < <(jq -r '.volumes[]' <<< "$OWNED")
    fi

    if [ "$IMAGES" == true ]; then
        while IFS= read -r ITEM; do
            "$PODMAN" image rm "$ITEM" > /dev/null 2>&1 || true
        done < <(jq -r '.images[]' <<< "$OWNED")
    fi

    if [ "$SECRETS" == true ]; then
        while IFS= read -r ITEM; do
            "$PODMAN" secret rm "$ITEM" > /dev/null 2>&1 || true
        done < <(jq -r '.secrets[]' <<< "$OWNED")
    fi

    json_ok
}

# Use the system-wide systemd manager when running as root, otherwise the
# per-user manager backing rootless Quadlet services...
if [ "$(id -u)" -eq 0 ]; then
    SYSTEMCTL_CMD=(systemctl)
    SYSTEMD_UNIT_PATH="/etc/systemd/system"
    SYSTEMD_SCOPE="system"
    SYSTEMD_JOURNAL_SCOPE=""
else
    SYSTEMCTL_CMD=(systemctl --user)
    SYSTEMD_UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    SYSTEMD_SCOPE="user"
    SYSTEMD_JOURNAL_SCOPE="--user "
fi

# Show help when no service, or an explicit help flag, is given...
if [ $# -eq 0 ] || [ "$1" == "help" ] || [ "$1" == "-h" ] || [ "$1" == "-help" ] || [ "$1" == "--help" ]; then
    display_help
fi

# The drop-ins "lpod settings set" writes for the podman-auto-update timer
# and service...
function auto_update_dropin {
    echo "${SYSTEMD_UNIT_PATH}/podman-auto-update.${1}.d/lpod-${2}.conf"
}

# "lpod settings --json": the podman-auto-update timer, whether a failed
# update rolls back, lingering and the Quadlet directory...
function cmd_settings_show_json {
    local TIMER
    TIMER="$("${SYSTEMCTL_CMD[@]}" show podman-auto-update.timer --property=ActiveState,NextElapseUSecRealtime,LastTriggerUSec,TimersCalendar --timestamp=unix 2>/dev/null)"

    local ROLLBACK=true

    if [ -f "$(auto_update_dropin service rollback)" ]; then
        ROLLBACK=false
    fi

    jq -n \
        --argjson contract "$LPOD_CONTRACT" \
        --arg timer "$TIMER" \
        --argjson rollback "$ROLLBACK" \
        --arg linger "$(linger_state)" \
        --arg quadlet_dir "$(home_path "$(quadlet_unit_path)")" '
        def iso: if . == null or . == "" or . == "n/a" or . == "0" then null else (ltrimstr("@") | tonumber | strftime("%Y-%m-%dT%H:%M:%S+00:00")) end;
        ($timer | split("\n") | map(select(contains("=")) | capture("^(?<key>[^=]+)=(?<value>.*)$")) | from_entries) as $timer
        | {
            contract: $contract,
            settings: {
                auto_update: {
                    enabled: ($timer.ActiveState == "active"),
                    schedule: ([($timer.TimersCalendar // "") | capture("OnCalendar=(?<schedule>[^;]+?)\\s*;")] | first | .schedule // "daily"),
                    rollback: $rollback,
                    next_run: ($timer.NextElapseUSecRealtime | iso),
                    last_run: ($timer.LastTriggerUSec | iso)
                },
                linger: (if $linger == "yes" then true elif $linger == "no" then false else null end),
                quadlet_dir: $quadlet_dir
            }
        }'
}

# Whether VALUE is "on" or "off", for the option NAME...
function valid_switch {
    if [ "$2" != "on" ] && [ "$2" != "off" ]; then
        echo "${1} takes on or off." >&2

        return 1
    fi
}

# "lpod settings set --json [--auto-update on|off] [--schedule ONCALENDAR]
# [--rollback on|off] [--linger on|off]": changes only the settings given...
function cmd_settings_set_json {
    local AUTO_UPDATE="" SCHEDULE="" ROLLBACK="" LINGER=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --auto-update) AUTO_UPDATE="${2:-}"; valid_switch "$1" "$AUTO_UPDATE" || return 1; shift ;;
            --rollback) ROLLBACK="${2:-}"; valid_switch "$1" "$ROLLBACK" || return 1; shift ;;
            --linger) LINGER="${2:-}"; valid_switch "$1" "$LINGER" || return 1; shift ;;
            --schedule)
                SCHEDULE="${2:-}"

                # The schedule goes into a unit file, so it's one line that
                # systemd itself accepts as an OnCalendar expression...
                if [ -z "$SCHEDULE" ] || [[ "$SCHEDULE" == -* ]] || [[ "$SCHEDULE" == *$'\n'* ]] || ! systemd-analyze calendar -- "$SCHEDULE" >/dev/null 2>&1; then
                    echo "--schedule takes a systemd OnCalendar expression, such as daily or \"Mon..Fri 04:00\"." >&2

                    return 1
                fi

                shift
                ;;
            --json) ;;
            *) echo "Unknown option: $1" >&2; return 1 ;;
        esac

        shift
    done

    local RELOAD=false DROPIN

    if [ -n "$SCHEDULE" ]; then
        DROPIN="$(auto_update_dropin timer schedule)"
        mkdir -p "$(dirname "$DROPIN")" || return 1
        printf '[Timer]\nOnCalendar=\nOnCalendar=%s\n' "$SCHEDULE" > "$DROPIN" || return 1
        RELOAD=true
    fi

    if [ "$ROLLBACK" == "off" ]; then
        local PODMAN_PATH
        PODMAN_PATH="$(command -v "${LPOD_PODMAN_BINARY:-podman}")" || return 1

        DROPIN="$(auto_update_dropin service rollback)"
        mkdir -p "$(dirname "$DROPIN")" || return 1
        printf '[Service]\nExecStart=\nExecStart=%s auto-update --rollback=false\n' "$PODMAN_PATH" > "$DROPIN" || return 1
        RELOAD=true
    elif [ "$ROLLBACK" == "on" ] && [ -f "$(auto_update_dropin service rollback)" ]; then
        rm -f "$(auto_update_dropin service rollback)" || return 1
        RELOAD=true
    fi

    if [ "$RELOAD" == true ]; then
        "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1
    fi

    if [ "$AUTO_UPDATE" == "on" ]; then
        "${SYSTEMCTL_CMD[@]}" enable --now podman-auto-update.timer >/dev/null 2>&1 || return 1

        # A running timer only picks up a new schedule when it restarts...
        if [ -n "$SCHEDULE" ]; then
            "${SYSTEMCTL_CMD[@]}" restart podman-auto-update.timer || return 1
        fi
    elif [ "$AUTO_UPDATE" == "off" ]; then
        "${SYSTEMCTL_CMD[@]}" disable --now podman-auto-update.timer >/dev/null 2>&1 || return 1
    fi

    # Lingering is a per-user setting, so it doesn't apply as root...
    if [ -n "$LINGER" ] && [ "$(id -u)" -ne 0 ]; then
        if [ "$LINGER" == "on" ]; then
            loginctl enable-linger "$(id -un)" || return 1
        else
            loginctl disable-linger "$(id -un)" || return 1
        fi
    fi

    json_ok
}

# "lpod settings [set ...] --json"...
function cmd_settings_json {
    require_jq

    if [ "${1:-}" == "set" ]; then
        shift
        cmd_settings_set_json "$@"

        return
    fi

    cmd_settings_show_json
}

# Quadlet management commands operate on Quadlet files or installed unit
# names, not a running service, so they're handled before the SERVICE/COMMAND
# split below...
case "$1" in
    install)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet install "$@"
        ;;

    remove)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet rm "$@"
        ;;

    uninstall)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet rm --recursive "$@"
        ;;

    list)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet list "$@"
        ;;

    print)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet print "$@"
        ;;

    reload)
        shift
        exec "${SYSTEMCTL_CMD[@]}" daemon-reload "$@"
        ;;

    doctor)
        shift
        cmd_doctor "$@"
        exit $?
        ;;

    self-update)
        shift
        cmd_self_update "$@"
        exit $?
        ;;

    version)
        cmd_version_json
        exit $?
        ;;

    apps)
        shift
        cmd_apps "$@"
        exit $?
        ;;

    host)
        shift
        cmd_host "$@"
        exit $?
        ;;

    secrets)
        shift
        cmd_secret_list "$@"
        exit $?
        ;;

    secret)
        shift
        cmd_secret "$@"
        exit $?
        ;;
esac

# The actions of an application's "--json" commands below...
LPOD_APP_ACTIONS="status|files|logs|up|down|restart|redeploy|remove|secret|ondemand|routes"

# Whether "$1 $2" is an application command for an application named like a
# host listing, such as Pods' own "pods": "lpod pods status --json"...
function app_named_like_listing {
    [[ "${1:-}" =~ ^(containers|images|volumes|networks|journal|events|settings|pods)$ ]] && [[ "${2:-}" =~ ^(${LPOD_APP_ACTIONS})$ ]]
}

# The host resources of the JSON contract. They only answer with "--json", so
# the same words stay free as service names for the commands below...
if json_requested "$@" && ! app_named_like_listing "$@"; then
    case "$1" in
        containers)
            if [ "${2:-}" == "prune" ]; then cmd_containers_prune_json; else shift; cmd_containers_json "$@"; fi
            exit $?
            ;;
        container) shift; cmd_container_json "$@"; exit $? ;;
        images)
            if [ "${2:-}" == "prune" ]; then cmd_images_prune_json; else cmd_images_json; fi
            exit $?
            ;;
        image) shift; cmd_image_json "$@"; exit $? ;;
        auto-update) shift; cmd_auto_update_json "$@"; exit $? ;;
        volumes)
            case "${2:-}" in
                prune) cmd_volumes_prune_json ;;
                sizes) cmd_volumes_sizes_json ;;
                *) cmd_volumes_json ;;
            esac
            exit $?
            ;;
        volume) shift; cmd_volume_json "$@"; exit $? ;;
        networks)
            if [ "${2:-}" == "prune" ]; then cmd_networks_prune_json; else cmd_networks_json; fi
            exit $?
            ;;
        network) shift; cmd_network_json "$@"; exit $? ;;
        journal) shift; cmd_journal_json "$@"; exit $? ;;
        quadlet) shift; cmd_quadlet_json "$@"; exit $? ;;
        settings) shift; cmd_settings_json "$@"; exit $? ;;
        events) shift; cmd_events_json "$@"; exit $? ;;
        pods) cmd_pods_json; exit $? ;;
        # Only "proxy routes", "settings" and "certificate", so an application named proxy keeps its other commands.
        proxy)
            case "${2:-}" in
                routes) shift; cmd_proxy_json "$@"; exit $? ;;
                settings) shift 2; cmd_proxy_settings_json "$@"; exit $? ;;
                certificate) cmd_proxy_certificate_json; exit $? ;;
            esac
            ;;
    esac
fi

# An application's "--json" commands take an application name, and run
# before the ".env" of the current directory is sourced, since tools such as
# Pods run them over SSH from the home directory...
if [ $# -ge 2 ] && json_requested "$@"; then
    case "$2" in
        status|files|logs|up|down|restart|redeploy|remove|secret|ondemand|routes|timers)
            cmd_app_json "$@"
            exit $?
            ;;
    esac
fi

SERVICE="$1"
shift

if [ $# -eq 0 ]; then
    echo "${BOLD}Missing command.${NC} Usage: lpod ${SERVICE} COMMAND [options] [arguments]" >&2

    exit 1
fi

# Source the ".env" file so Laravel's environment variables are available...
# shellcheck source=/dev/null
if [ -n "$APP_ENV" ] && [ -f ./.env."$APP_ENV" ]; then
  source ./.env."$APP_ENV";
elif [ -f ./.env ]; then
  source ./.env;
fi

# Define environment variables...
export APP_PORT=${APP_PORT:-80}
export APP_USER=${APP_USER-"$(id -u)"}
export LPOD_PODMAN_BINARY=${LPOD_PODMAN_BINARY:-"podman"}

# AI agent environment variables to forward into containers...
AGENT_ENV_VARS=(
    AI_AGENT
    CLAUDECODE
    CLAUDE_CODE
    CLAUDE_CODE_IS_COWORK
    CURSOR_TRACE_ID
    CURSOR_AGENT
    GEMINI_CLI
    CODEX_SANDBOX
    CODEX_CI
    CODEX_THREAD_ID
    AUGMENT_AGENT
    OPENCODE_CLIENT
    OPENCODE
    AMP_CURRENT_THREAD_ID
    REPL_ID
    ANTIGRAVITY_AGENT
    COPILOT_MODEL
    COPILOT_ALLOW_ALL
    COPILOT_GITHUB_TOKEN
    COPILOT_CLI
    PI_CODING_AGENT
    KIRO_AGENT_PATH
)

function forward_agent_env() {
    for VAR in "${AGENT_ENV_VARS[@]}"; do
        if [ -n "${!VAR:-}" ]; then
            ARGS+=(-e "${VAR}=${!VAR}")
        fi
    done
}

# Quadlet installs a Podman container named "systemd-<unit>" for every
# "<unit>.service" it manages, to avoid clashing with unmanaged containers...
CONTAINER="systemd-${SERVICE}"

# Determine whether to allocate a pseudo-tty for "podman exec"...
if test -t 0 && test -t 1; then
    TTY_ARGS=(-it)
else
    TTY_ARGS=(-i)
fi

# Only force a user with "-u" when APP_USER is set; otherwise let the image's
# own default user apply...
APP_USER_ARGS=()
if [ -n "$APP_USER" ]; then
    APP_USER_ARGS=(-u "$APP_USER")
fi

COMMAND="$1"
shift

ARGS=()

case "$COMMAND" in
    # Start, stop, restart, and inspect the Quadlet-managed systemd service...
    up)
        exec "${SYSTEMCTL_CMD[@]}" start "${SERVICE}.service"
        ;;

    down)
        exec "${SYSTEMCTL_CMD[@]}" stop "${SERVICE}.service"
        ;;

    restart)
        exec "${SYSTEMCTL_CMD[@]}" restart "${SERVICE}.service"
        ;;

    status)
        exec "${SYSTEMCTL_CMD[@]}" status "${SERVICE}.service"
        ;;

    # Parse and set the secrets an installed quadlet needs...
    secrets)
        cmd_secrets "$SERVICE" "$@"
        exit $?
        ;;

    # Proxy PHP commands to the "php" binary on the service container...
    php)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php)
        ;;

    # Proxy vendor binary commands on the service container...
    bin)
        CMD="$1"
        shift
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" "./vendor/bin/${CMD}")
        ;;

    # Proxy arbitrary commands on the service container...
    run)
        CMD="$1"
        shift
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" "$CMD")
        ;;

    # Proxy Composer commands to the "composer" binary on the service container...
    composer)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" composer)
        ;;

    # Proxy Artisan commands to the "artisan" binary on the service container...
    artisan|art|a)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan)
        ;;

    # Proxy the "debug" command to "php artisan" on the service container with xdebug enabled...
    debug)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "XDEBUG_MODE=${XDEBUG_MODE:-debug}" -e XDEBUG_TRIGGER=1 "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan)
        ;;

    # Turn Xdebug on or off for the service's requests and workers...
    xdebug)
        cmd_xdebug "$SERVICE" "$@"
        exit $?
        ;;

    # Proxy the "test" command to the "php artisan test" Artisan command...
    test)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan test)
        ;;

    # Proxy the "phpunit" command to "php vendor/bin/phpunit"...
    phpunit)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/phpunit)
        ;;

    # Proxy the "pest" command to "php vendor/bin/pest"...
    pest)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/pest)
        ;;

    # Proxy the "pint" command to "php vendor/bin/pint"...
    pint)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/pint)
        ;;

    # Proxy the "dusk" command to the "php artisan dusk" Artisan command...
    dusk)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "APP_URL=http://${CONTAINER}" -e "DUSK_DRIVER_URL=http://selenium:4444/wd/hub" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan dusk)
        ;;

    # Proxy the "dusk:fails" command to the "php artisan dusk:fails" Artisan command...
    dusk:fails)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "APP_URL=http://${CONTAINER}" -e "DUSK_DRIVER_URL=http://selenium:4444/wd/hub" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan dusk:fails)
        ;;

    # Initiate a Laravel Tinker session within the service container...
    tinker)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan tinker)
        ;;

    # Proxy Node commands to the "node" binary on the service container...
    node)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" node)
        ;;

    # Proxy NPM commands to the "npm" binary on the service container...
    npm)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" npm)
        ;;

    # Proxy NPX commands to the "npx" binary on the service container...
    npx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" npx)
        ;;

    # Proxy PNPM commands to the "pnpm" binary on the service container...
    pnpm)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" pnpm)
        ;;

    # Proxy PNPX commands to the "pnpx" binary on the service container...
    pnpx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" pnpx)
        ;;

    # Proxy Yarn commands to the "yarn" binary on the service container...
    yarn)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" yarn)
        ;;

    # Proxy Bun commands to the "bun" binary on the service container...
    bun)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bun)
        ;;

    # Proxy Bun X commands to the "bunx" binary on the service container...
    bunx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bunx)
        ;;

    # Initiate a Bash shell within the service container...
    shell|bash)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bash)
        ;;

    # Initiate a root user Bash shell within the service container...
    root-shell|root-bash)
        ARGS+=(exec -u root "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bash)
        ;;

    # Open the application URL in the browser...
    open)
        if ! command -v xdg-open &>/dev/null; then
            echo "xdg-open is not available. Exiting." >&2

            exit 1
        fi

        if [[ -n "$APP_PORT" && "$APP_PORT" != "80" ]]; then
            FULL_URL="${APP_URL}:${APP_PORT}"
        else
            FULL_URL="$APP_URL"
        fi

        exec xdg-open "$FULL_URL"
        ;;

    # Export the proxy's local CA certificate for trusting on the host...
    export-cert)
        OUT="${1:-$HOME/${SERVICE}.crt}"
        exec "${LPOD_PODMAN_BINARY}" cp "${CONTAINER}:/data/caddy/pki/authorities/local/root.crt" "$OUT"
        ;;

    # Unknown commands are passed through to the podman binary...
    *)
        exec "${LPOD_PODMAN_BINARY}" "$COMMAND" "$@"
        ;;
esac

# Forward the host terminal's color capability to container commands...
if [ "${ARGS[0]:-}" == "exec" ] && [ -n "${COLORTERM:-}" ]; then
    ARGS=(exec -e "COLORTERM=${COLORTERM}" "${ARGS[@]:1}")
fi

exec "${LPOD_PODMAN_BINARY}" "${ARGS[@]}" "$@"
