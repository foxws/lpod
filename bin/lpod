#!/usr/bin/env bash

# Substituted with the pushed tag by .github/workflows/release.yml when a
# release asset is built; a plain checkout (git clone or "main" raw file)
# keeps this placeholder...
LPOD_VERSION="dev"

if [ "$1" == "--version" ] || [ "$1" == "-v" ] || [ "$1" == "version" ]; then
    echo "lpod ${LPOD_VERSION}"

    exit 0
fi

UNAMEOUT="$(uname -s)"

# Verify operating system is supported...
if [ "$UNAMEOUT" != "Linux" ]; then
    echo "Unsupported operating system [$(uname -s)]. Laravel Podman requires Linux with systemd; macOS and Windows, including WSL, are not supported." >&2

    exit 1
fi

# Determine if stdout is a terminal...
if test -t 1; then
    # Determine if colors are supported...
    ncolors=$(tput colors)

    if test -n "$ncolors" && test "$ncolors" -ge 8; then
        BOLD="$(tput bold)"
        RED="$(tput setaf 1)"
        YELLOW="$(tput setaf 3)"
        GREEN="$(tput setaf 2)"
        NC="$(tput sgr0)"
    fi
fi

# Function that prints the available commands...
function display_help {
    echo "Laravel Podman ${LPOD_VERSION}"
    echo
    echo "${YELLOW}Usage:${NC}" >&2
    echo "  lpod SERVICE COMMAND [options] [arguments]"
    echo
    echo "SERVICE is the name of a Podman Quadlet service (e.g. the application"
    echo "service, or a sibling service such as 'pgsql'). Unknown commands are"
    echo "passed through to the podman binary."
    echo
    echo "${YELLOW}Lifecycle Commands:${NC}"
    echo "  ${GREEN}lpod my-app up${NC}        Start the 'my-app' service"
    echo "  ${GREEN}lpod my-app down${NC}      Stop the 'my-app' service"
    echo "  ${GREEN}lpod my-app restart${NC}   Restart the 'my-app' service"
    echo "  ${GREEN}lpod my-app status${NC}    Show the status of the 'my-app' service"
    echo "  ${GREEN}lpod my-app secrets${NC}   Parse and set the secrets the installed 'my-app' quadlet needs"
    echo
    echo "${YELLOW}Artisan Commands:${NC}"
    echo "  ${GREEN}lpod my-app artisan ...${NC}          Run an Artisan command"
    echo "  ${GREEN}lpod my-app artisan queue:work${NC}"
    echo
    echo "${YELLOW}PHP Commands:${NC}"
    echo "  ${GREEN}lpod my-app php ...${NC}   Run a snippet of PHP code"
    echo "  ${GREEN}lpod my-app php -v${NC}"
    echo
    echo "${YELLOW}Composer Commands:${NC}"
    echo "  ${GREEN}lpod my-app composer ...${NC}                       Run a Composer command"
    echo "  ${GREEN}lpod my-app composer require laravel/sanctum${NC}"
    echo
    echo "${YELLOW}Node Commands:${NC}"
    echo "  ${GREEN}lpod my-app node ...${NC}         Run a Node command"
    echo "  ${GREEN}lpod my-app node --version${NC}"
    echo
    echo "${YELLOW}NPM Commands:${NC}"
    echo "  ${GREEN}lpod my-app npm ...${NC}        Run a npm command"
    echo "  ${GREEN}lpod my-app npx${NC}            Run a npx command"
    echo "  ${GREEN}lpod my-app npm run prod${NC}"
    echo
    echo "${YELLOW}PNPM Commands:${NC}"
    echo "  ${GREEN}lpod my-app pnpm ...${NC}        Run a pnpm command"
    echo "  ${GREEN}lpod my-app pnpx${NC}            Run a pnpx command"
    echo "  ${GREEN}lpod my-app pnpm run prod${NC}"
    echo
    echo "${YELLOW}Yarn Commands:${NC}"
    echo "  ${GREEN}lpod my-app yarn ...${NC}        Run a Yarn command"
    echo "  ${GREEN}lpod my-app yarn run prod${NC}"
    echo
    echo "${YELLOW}Bun Commands:${NC}"
    echo "  ${GREEN}lpod my-app bun ...${NC}        Run a bun command"
    echo "  ${GREEN}lpod my-app bunx${NC}           Run a bunx command"
    echo "  ${GREEN}lpod my-app bun run prod${NC}"
    echo
    echo "${YELLOW}Debugging:${NC}"
    echo "  ${GREEN}lpod my-app debug ...${NC}          Run an Artisan command in debug mode"
    echo "  ${GREEN}lpod my-app debug queue:work${NC}"
    echo "  ${GREEN}lpod my-app xdebug on [MODE]${NC}   Turn Xdebug on for web requests (default mode: debug) and restart"
    echo "  ${GREEN}lpod my-app xdebug off${NC}         Turn Xdebug off again and restart"
    echo "  ${GREEN}lpod my-app xdebug status${NC}      Show whether Xdebug is on"
    echo
    echo "${YELLOW}Running Tests:${NC}"
    echo "  ${GREEN}lpod my-app test${NC}          Run the PHPUnit tests via the Artisan test command"
    echo "  ${GREEN}lpod my-app phpunit ...${NC}   Run PHPUnit"
    echo "  ${GREEN}lpod my-app pest ...${NC}      Run Pest"
    echo "  ${GREEN}lpod my-app pint ...${NC}      Run Pint"
    echo "  ${GREEN}lpod my-app dusk${NC}          Run the Dusk tests (Requires the laravel/dusk package)"
    echo "  ${GREEN}lpod my-app dusk:fails${NC}    Re-run previously failed Dusk tests (Requires the laravel/dusk package)"
    echo
    echo "${YELLOW}Container CLI:${NC}"
    echo "  ${GREEN}lpod my-app shell${NC}        Start a shell session within the service container"
    echo "  ${GREEN}lpod my-app bash${NC}         Alias for 'lpod my-app shell'"
    echo "  ${GREEN}lpod my-app root-shell${NC}   Start a root shell session within the service container"
    echo "  ${GREEN}lpod my-app root-bash${NC}    Alias for 'lpod my-app root-shell'"
    echo "  ${GREEN}lpod my-app tinker${NC}       Start a new Laravel Tinker session"
    echo
    echo "${YELLOW}Binaries:${NC}"
    echo "  ${GREEN}lpod my-app bin ...${NC}   Run Composer binary scripts from the vendor/bin directory"
    echo "  ${GREEN}lpod my-app run ...${NC}   Run a command within the service container"
    echo
    echo "${YELLOW}Other:${NC}"
    echo "  ${GREEN}lpod my-app open${NC}                     Open the application URL in your browser"
    echo "  ${GREEN}lpod my-app artisan podman:publish${NC}   Publish the Podman container runtime files"
    echo "  ${GREEN}lpod proxy export-cert [PATH]${NC}        Export the proxy's local CA certificate (default: ~/proxy.crt)"
    echo
    echo "${YELLOW}Quadlet Management:${NC}"
    echo "  ${GREEN}lpod setup ...${NC}                         Alias for 'lpod-setup' (render presets without PHP on the host)"
    echo "  ${GREEN}lpod install PRESET/SERVICE.quadlets${NC}   Install a rendered quadlet (e.g. from 'podman:generate')"
    echo "  ${GREEN}lpod install PRESET/UNIT.socket${NC}        Install and enable a rendered systemd socket or timer (e.g. on-demand services)"
    echo "  ${GREEN}lpod remove NAME${NC}                       Remove an installed quadlet, socket or timer"
    echo "  ${GREEN}lpod uninstall APPLICATION${NC}             Remove an application and all of its quadlets"
    echo "  ${GREEN}lpod list${NC}                               List installed quadlets"
    echo "  ${GREEN}lpod print NAME${NC}                        Print the generated systemd unit for a quadlet"
    echo "  ${GREEN}lpod reload${NC}                             Reload the systemd manager configuration (daemon-reload)"
    echo "  All of the above (except 'reload') accept any extra flags 'podman quadlet' itself takes (e.g. --replace, --application)."
    echo
    echo "${YELLOW}On-demand Idle Check:${NC}"
    echo "  ${GREEN}lpod idle enable APPLICATION${NC}    Stop the queue workers and scheduler timer once the sleeping app has no work left"
    echo "  ${GREEN}lpod idle disable APPLICATION${NC}   Stop running the idle check for the application"
    echo "  ${GREEN}lpod idle APPLICATION${NC}           Run the idle check once"
    echo "  ${GREEN}lpod idle setup${NC}                 Write the lpod-idle@ systemd templates (the installer runs this)"
    echo
    echo "${YELLOW}Troubleshooting:${NC}"
    echo "  ${GREEN}lpod doctor${NC}                     Check the host for what the services need, and how to fix what's missing"
    echo
    echo "${YELLOW}Updating:${NC}"
    echo "  ${GREEN}lpod self-update [VERSION]${NC}      Upgrade lpod and lpod-setup in place (latest, or e.g. v2.2.0)"
    echo "  ${GREEN}lpod --version${NC}                  Show the installed version"

    exit 1
}

# Parses the "Secret=" directives off an installed quadlet and prompts for
# each one to create it with "podman secret create" (used by
# "lpod SERVICE secrets")...
function cmd_secrets {
    if [ $# -eq 0 ]; then
        echo "Usage: lpod SERVICE secrets [podman secret create flags...]" >&2

        return 1
    fi

    local SERVICE="$1"
    shift
    local EXTRA_ARGS=("$@")

    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local UNIT="${SERVICE%.container}.container"
    local CONTENTS

    # Reads the "Secret=" directives straight from the installed unit, so it
    # works off whatever "lpod install" actually installed rather than a
    # rendered ".quadlets" file that may no longer exist on disk...
    if ! CONTENTS="$("$PODMAN" quadlet print "$UNIT" 2>&1)"; then
        echo "${CONTENTS}" >&2
        echo "Could not print the \"${UNIT}\" quadlet. Run \"lpod install\" first." >&2

        return 1
    fi

    # Parse every "Secret=name,type=...,target=..." directive, grouping
    # targets by secret name (the same secret can be needed under several
    # env var/mount names, e.g. a database password used as both
    # POSTGRES_PASSWORD and PGPASSWORD)...
    local -A SECRET_TYPE
    local -A SECRET_TARGETS
    local LINE

    while IFS= read -r LINE; do
        case "$LINE" in
            Secret=*) ;;
            *) continue ;;
        esac

        local -a PARTS
        IFS=',' read -ra PARTS <<< "${LINE#Secret=}"
        local NAME="${PARTS[0]}"
        local TYPE="mount"
        local TARGET="$NAME"
        local PART

        for PART in "${PARTS[@]:1}"; do
            case "$PART" in
                type=*) TYPE="${PART#type=}" ;;
                target=*) TARGET="${PART#target=}" ;;
            esac
        done

        SECRET_TYPE["$NAME"]="$TYPE"

        if [ -n "${SECRET_TARGETS[$NAME]:-}" ]; then
            SECRET_TARGETS["$NAME"]="${SECRET_TARGETS[$NAME]}, ${TARGET}"
        else
            SECRET_TARGETS["$NAME"]="$TARGET"
        fi
    done <<< "$CONTENTS"

    if [ ${#SECRET_TYPE[@]} -eq 0 ]; then
        echo "No secrets found in ${UNIT}."

        return 0
    fi

    local NAME PATH_INPUT VALUE

    for NAME in "${!SECRET_TYPE[@]}"; do
        if [ "${SECRET_TYPE[$NAME]}" = "mount" ]; then
            read -rp "Enter the file path for ${NAME} (${SECRET_TARGETS[$NAME]}) [.env]: " PATH_INPUT
            PATH_INPUT="${PATH_INPUT:-.env}"

            if [ ! -f "$PATH_INPUT" ]; then
                echo "The file ${PATH_INPUT} does not exist." >&2

                return 1
            fi

            "$PODMAN" secret create "$NAME" - "${EXTRA_ARGS[@]}" < "$PATH_INPUT" || return 1
        else
            read -rsp "Enter the value for ${NAME} (${SECRET_TARGETS[$NAME]}), or leave blank to keep the current value: " VALUE
            echo

            if [ -z "$VALUE" ]; then
                echo "Skipping ${NAME} (kept existing value)."

                continue
            fi

            printf '%s' "$VALUE" | "$PODMAN" secret create "$NAME" - "${EXTRA_ARGS[@]}" || return 1
        fi

        echo "Secret ${NAME} set."
    done
}

# Installs a plain systemd unit rendered next to the quadlets, such as an
# on-demand ".socket" or a ".timer" (used by "lpod install"). Quadlet only
# handles container units, and "podman quadlet install" would put these
# where systemd never loads them. The ".service" of the same name, if
# rendered, is installed with it. Then the unit is enabled and started...
function cmd_install_unit {
    local SOURCE="${LPOD_PUBLISH_PATH}/$1"
    shift

    local REPLACE=0
    local ARG

    for ARG in "$@"; do
        if [ "$ARG" == "--replace" ]; then
            REPLACE=1
        fi
    done

    if [ ! -f "$SOURCE" ]; then
        echo "The file ${SOURCE} does not exist." >&2

        return 1
    fi

    local FILES=("$SOURCE")

    if [ -f "${SOURCE%.*}.service" ]; then
        FILES+=("${SOURCE%.*}.service")
    fi

    local FILE

    for FILE in "${FILES[@]}"; do
        if [ -e "${SYSTEMD_UNIT_PATH}/$(basename "$FILE")" ] && [ "$REPLACE" -eq 0 ]; then
            echo "${SYSTEMD_UNIT_PATH}/$(basename "$FILE") already exists. Use --replace to overwrite it." >&2

            return 1
        fi
    done

    mkdir -p "$SYSTEMD_UNIT_PATH" || return 1
    cp "${FILES[@]}" "$SYSTEMD_UNIT_PATH/" || return 1

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1
    "${SYSTEMCTL_CMD[@]}" enable --now "$(basename "$SOURCE")"
}

# Stops, disables and removes a unit installed by "cmd_install_unit", along
# with the ".service" of the same name if it was installed with it (used by
# "lpod remove")...
function cmd_remove_unit {
    local UNIT="$1"
    local FILE="${SYSTEMD_UNIT_PATH}/${UNIT}"

    if [ ! -f "$FILE" ]; then
        echo "The unit ${UNIT} is not installed in ${SYSTEMD_UNIT_PATH}." >&2

        return 1
    fi

    "${SYSTEMCTL_CMD[@]}" disable --now "$UNIT" || return 1

    local SERVICE="${UNIT%.*}.service"

    if [ -f "${SYSTEMD_UNIT_PATH}/${SERVICE}" ]; then
        "${SYSTEMCTL_CMD[@]}" stop "$SERVICE"
        rm -f "${SYSTEMD_UNIT_PATH}/${SERVICE}"
    fi

    rm -f "$FILE"

    "${SYSTEMCTL_CMD[@]}" daemon-reload
}

# Writes the "lpod-idle@.timer" and "lpod-idle@.service" templates, one
# instance per on-demand application (used by "lpod idle setup"). The
# service runs this script by its resolved path, since systemd's PATH
# doesn't include "~/.local/bin"...
function cmd_idle_setup {
    local LPOD_PATH
    LPOD_PATH="$(readlink -f "${BASH_SOURCE[0]}")"

    mkdir -p "$SYSTEMD_UNIT_PATH" || return 1

    cat > "${SYSTEMD_UNIT_PATH}/lpod-idle@.timer" <<'EOF' || return 1
[Unit]
Description=lpod idle check for %i

[Timer]
OnCalendar=*-*-* *:*:30
AccuracySec=1s

[Install]
WantedBy=timers.target
EOF

    cat > "${SYSTEMD_UNIT_PATH}/lpod-idle@.service" <<EOF || return 1
[Unit]
Description=lpod idle check for %i

[Service]
Type=oneshot
TimeoutStartSec=50
ExecStart="${LPOD_PATH}" idle %i
EOF

    "${SYSTEMCTL_CMD[@]}" daemon-reload
}

# Checks whether a unit is active, in the same scope as the Quadlet units...
function unit_is_active {
    "${SYSTEMCTL_CMD[@]}" --quiet is-active "$1"
}

# Checks whether a unit is running or on its way up. "is-active" fails while
# a unit is still "activating", e.g. an app waiting for its health check...
function unit_is_awake {
    case "$("${SYSTEMCTL_CMD[@]}" is-active "$1")" in
        inactive | failed) return 1 ;;
        *) return 0 ;;
    esac
}

# Stops an on-demand application's queue workers and scheduler timer once
# it's asleep and has no work in progress, so the services they keep awake
# can sleep too (used by "lpod idle APPLICATION", which "lpod-idle@.service"
# runs every minute). The app's "Wants=" line starts them again on the next
# request. "LPOD_IDLE_WORKERS" adds workers beyond "queue" and "horizon",
# e.g. from a drop-in: Environment=LPOD_IDLE_WORKERS=imports...
function cmd_idle {
    local APPLICATION="$1"
    local WORKERS=(queue horizon)
    local WORKER

    # shellcheck disable=SC2206
    WORKERS+=(${LPOD_IDLE_WORKERS:-})

    # Only on-demand applications sleep; without the socket, the app runs all the time...
    if ! unit_is_active "${APPLICATION}-ondemand.socket"; then
        return 0
    fi

    if unit_is_awake "${APPLICATION}.service"; then
        return 0
    fi

    # A scheduled task still running may dispatch jobs that need a worker...
    if unit_is_active "${APPLICATION}-schedule.service"; then
        echo "The scheduler of ${APPLICATION} is still running."

        return 0
    fi

    for WORKER in "${WORKERS[@]}"; do
        if ! unit_is_active "${APPLICATION}-${WORKER}.service"; then
            continue
        fi

        if ! "${LPOD_PODMAN_BINARY:-podman}" exec "systemd-${APPLICATION}-${WORKER}" php -d variables_order=EGPCS /app/artisan podman:idle; then
            echo "${APPLICATION} has work in progress, keeping its workers running."

            return 0
        fi
    done

    # A request may have woken the app while "podman:idle" ran...
    if unit_is_awake "${APPLICATION}.service"; then
        return 0
    fi

    # Queue the stops without waiting for them, so a worker's graceful
    # shutdown (up to its TimeoutStopSec=) doesn't count against this run...
    for WORKER in "${WORKERS[@]}"; do
        if unit_is_active "${APPLICATION}-${WORKER}.service"; then
            "${SYSTEMCTL_CMD[@]}" stop --no-block "${APPLICATION}-${WORKER}.service"
        fi
    done

    if unit_is_active "${APPLICATION}-schedule.timer"; then
        "${SYSTEMCTL_CMD[@]}" stop --no-block "${APPLICATION}-schedule.timer"
    fi
}

# Re-runs the installer for this copy of lpod, so it upgrades in place
# (used by "lpod self-update [VERSION]"). The installer verifies the
# downloads against the release's SHA256SUMS...
function cmd_self_update {
    local TARGET="${1:-latest}"
    local INSTALLER="https://github.com/foxws/lpod/releases/latest/download/install.sh"
    local INSTALL_DIR
    INSTALL_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

    if [ "$TARGET" != "latest" ]; then
        INSTALLER="https://github.com/foxws/lpod/releases/download/v${TARGET#v}/install.sh"
    fi

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$INSTALLER" | LPOD_INSTALL_DIR="$INSTALL_DIR" LPOD_VERSION="$TARGET" bash
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$INSTALLER" | LPOD_INSTALL_DIR="$INSTALL_DIR" LPOD_VERSION="$TARGET" bash
    else
        echo "Neither curl nor wget is installed." >&2

        return 1
    fi
}

# Prints a doctor check's outcome, with how to fix it on the next line...
function doctor_report {
    local STATUS="$1"
    local MESSAGE="$2"
    local FIX="${3:-}"

    case "$STATUS" in
        ok) echo "  ${GREEN}✓${NC} ${MESSAGE}" ;;
        warn) echo "  ${YELLOW}!${NC} ${MESSAGE}"; DOCTOR_WARNINGS=$((DOCTOR_WARNINGS + 1)) ;;
        fail) echo "  ${RED}✗${NC} ${MESSAGE}"; DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)) ;;
    esac

    if [ -n "$FIX" ] && [ "$STATUS" != "ok" ]; then
        local LINE

        while IFS= read -r LINE; do
            echo "      ${LINE}"
        done <<< "$FIX"
    fi
}

# Checks the host for what the services need, and prints how to fix what's
# missing without changing anything itself, since most fixes need root
# (used by "lpod doctor"). Fails when something stops services from running...
function cmd_doctor {
    local PODMAN="${LPOD_PODMAN_BINARY:-podman}"
    local USER_NAME
    USER_NAME="$(id -un)"

    DOCTOR_WARNINGS=0
    DOCTOR_FAILURES=0

    echo "${BOLD}lpod ${LPOD_VERSION} doctor${NC}"
    echo

    # Podman with Quadlet...
    local VERSION

    if ! VERSION="$("$PODMAN" version --format '{{.Client.Version}}' 2>/dev/null)"; then
        doctor_report fail "Podman isn't installed, or doesn't run" "Install podman from your distribution's packages."
    elif ! "$PODMAN" quadlet --help >/dev/null 2>&1; then
        doctor_report fail "Podman ${VERSION} has no \"podman quadlet\" command" "Upgrade to Podman 5.6 or newer."
    else
        doctor_report ok "Podman ${VERSION} with Quadlet"
    fi

    # The systemd manager that runs the Quadlet units...
    if "${SYSTEMCTL_CMD[@]}" show-environment >/dev/null 2>&1; then
        doctor_report ok "The systemd ${SYSTEMD_SCOPE} manager is reachable"
    else
        doctor_report fail "The systemd ${SYSTEMD_SCOPE} manager isn't reachable" "Log in through a real session (not \"su\" or \"sudo -u\"), or use \"machinectl shell ${USER_NAME}@\"."
    fi

    if [ "$(id -u)" -ne 0 ]; then
        # Rootless services only start at boot, and keep running after logout, with linger...
        if [ "$(loginctl show-user "$USER_NAME" --property=Linger --value 2>/dev/null)" == "yes" ]; then
            doctor_report ok "Linger is on, so services start at boot"
        else
            doctor_report warn "Linger is off, so services stop when you log out and don't start at boot" "loginctl enable-linger ${USER_NAME}"
        fi

        # Rootless containers map their users onto subordinate IDs...
        local ID_FILE
        local MISSING_IDS=()

        for ID_FILE in /etc/subuid /etc/subgid; do
            if ! grep -qE "^(${USER_NAME}|$(id -u)):" "$ID_FILE" 2>/dev/null; then
                MISSING_IDS+=("$ID_FILE")
            fi
        done

        if [ ${#MISSING_IDS[@]} -eq 0 ]; then
            doctor_report ok "Subordinate user and group IDs are set up"
        else
            doctor_report fail "${USER_NAME} has no entry in ${MISSING_IDS[*]}" "sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 ${USER_NAME}
podman system migrate"
        fi

        # The proxy publishes ports 80 and 443, which are privileged by default...
        local PORT_START
        PORT_START="$(cat /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null)"

        if [ -z "$PORT_START" ] || [ "$PORT_START" -le 80 ]; then
            doctor_report ok "Rootless containers may publish ports 80 and 443"
        else
            doctor_report warn "Rootless containers can't publish ports below ${PORT_START}, which the proxy's 80 and 443 are" "echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/99-lpod.conf
sudo sysctl --system"
        fi
    fi

    # The idle check's templates, which the installer writes...
    if [ -f "${SYSTEMD_UNIT_PATH}/lpod-idle@.service" ] && [ -f "${SYSTEMD_UNIT_PATH}/lpod-idle@.timer" ]; then
        doctor_report ok "The idle check's systemd templates are installed"
    else
        doctor_report warn "The idle check's systemd templates are missing, so on-demand apps keep their workers running" "lpod idle setup"
    fi

    # The proxy's local CA, which browsers and the host only accept once trusted...
    if [ "$("$PODMAN" container inspect --format '{{.State.Running}}' systemd-proxy 2>/dev/null)" == "true" ] && command -v openssl >/dev/null 2>&1; then
        local CERTIFICATE
        CERTIFICATE="$(mktemp)"

        if "$PODMAN" cp systemd-proxy:/data/caddy/pki/authorities/local/root.crt "$CERTIFICATE" 2>/dev/null; then
            if openssl verify "$CERTIFICATE" >/dev/null 2>&1; then
                doctor_report ok "The proxy's local certificate is trusted"
            else
                doctor_report warn "The proxy's local certificate isn't trusted by this host" "lpod proxy export-cert, then add ~/proxy.crt to your trust store:
https://foxws.nl/laravel-podman/proxy#trusting-the-local-certificate"
            fi
        fi

        rm -f "$CERTIFICATE"
    fi

    # The app's host name, read from the ".env" in the current directory...
    local APP_HOST=""

    if [ -f .env ]; then
        APP_HOST="$(sed -nE 's/^APP_URL=["'\'']?([a-z]+:\/\/)?([^:\/"'\'']+).*/\2/p' .env | tail -n 1)"
    fi

    if [ -n "$APP_HOST" ]; then
        if getent hosts "$APP_HOST" >/dev/null 2>&1; then
            doctor_report ok "${APP_HOST} (APP_URL) resolves"
        else
            doctor_report warn "${APP_HOST} (APP_URL) doesn't resolve" "Add it, and its subdomains, to /etc/hosts:
https://foxws.nl/laravel-podman/proxy#dns"
        fi
    fi

    # Services that failed and stay down until someone looks...
    local FAILED
    FAILED="$("${SYSTEMCTL_CMD[@]}" list-units --failed --plain --no-legend --type=service 2>/dev/null | awk '{ print $1 }')"

    if [ -z "$FAILED" ]; then
        doctor_report ok "No services have failed"
    else
        doctor_report warn "These services have failed: $(echo "$FAILED" | paste -sd ' ')" "See why with: journalctl ${SYSTEMD_JOURNAL_SCOPE}-u SERVICE -e"
    fi

    echo

    if [ "$DOCTOR_FAILURES" -gt 0 ]; then
        echo "${DOCTOR_FAILURES} problem(s) and ${DOCTOR_WARNINGS} warning(s) found."

        return 1
    fi

    if [ "$DOCTOR_WARNINGS" -gt 0 ]; then
        echo "No problems, ${DOCTOR_WARNINGS} warning(s) found."
    else
        echo "Everything looks good."
    fi
}

# Where Quadlet looks for the units "podman quadlet install" installs, and
# their drop-ins...
function quadlet_unit_path {
    if [ "$(id -u)" -eq 0 ]; then
        echo "/etc/containers/systemd"
    else
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd"
    fi
}

# Turns Xdebug on (in MODE, default "debug") or off for a service's web
# requests and workers, with a Quadlet drop-in that sets XDEBUG_MODE, then
# restarts the service if it's running (used by "lpod SERVICE xdebug")...
function cmd_xdebug {
    local SERVICE="$1"
    local ACTION="${2:-status}"
    local MODE="${3:-debug}"
    local DROPIN_PATH
    DROPIN_PATH="$(quadlet_unit_path)/${SERVICE}.container.d"
    local DROPIN="${DROPIN_PATH}/lpod-xdebug.conf"

    case "$ACTION" in
        on)
            mkdir -p "$DROPIN_PATH" || return 1
            printf '[Container]\nEnvironment=XDEBUG_MODE=%s\n' "$MODE" > "$DROPIN" || return 1
            ;;

        off)
            rm -f "$DROPIN"
            rmdir "$DROPIN_PATH" 2>/dev/null
            ;;

        status)
            if [ -f "$DROPIN" ]; then
                echo "Xdebug is on for ${SERVICE} ($(sed -n 's/^Environment=XDEBUG_MODE=//p' "$DROPIN"))."
            else
                echo "Xdebug is off for ${SERVICE}."
            fi

            return 0
            ;;

        *)
            echo "Usage: lpod ${SERVICE} xdebug on [MODE]|off|status" >&2

            return 1
            ;;
    esac

    "${SYSTEMCTL_CMD[@]}" daemon-reload || return 1

    if unit_is_active "${SERVICE}.service"; then
        "${SYSTEMCTL_CMD[@]}" restart "${SERVICE}.service" || return 1
    fi

    if [ "$ACTION" == "off" ]; then
        echo "Xdebug is off for ${SERVICE}."

        return 0
    fi

    echo "Xdebug is on for ${SERVICE} (${MODE}). Add XDEBUG_TRIGGER (or XDEBUG_SESSION) to a request to start a session."

    if unit_is_active "${SERVICE}.service" && ! "${LPOD_PODMAN_BINARY:-podman}" exec "systemd-${SERVICE}" php -m 2>/dev/null | grep -qi '^xdebug$'; then
        echo "${YELLOW}The ${SERVICE} image has no Xdebug extension.${NC} Update its Containerfile to install it, and rebuild." >&2
    fi
}

# Dispatches "lpod idle setup|enable|disable|APPLICATION"...
function cmd_idle_dispatch {
    case "$1" in
        setup)
            cmd_idle_setup
            ;;

        enable|disable)
            if [ -z "$2" ]; then
                echo "Usage: lpod idle $1 APPLICATION" >&2

                return 1
            fi

            if [ "$1" == "enable" ] && [ ! -f "${SYSTEMD_UNIT_PATH}/lpod-idle@.service" ]; then
                cmd_idle_setup || return 1
            fi

            "${SYSTEMCTL_CMD[@]}" "$1" --now "lpod-idle@$2.timer"
            ;;

        ""|-h|--help)
            echo "Usage: lpod idle setup|enable APPLICATION|disable APPLICATION|APPLICATION" >&2

            return 1
            ;;

        *)
            cmd_idle "$1"
            ;;
    esac
}

# Where "podman:generate" wrote rendered ".quadlets" files, matching the
# "publish_path" config key (default "podman")...
export LPOD_PUBLISH_PATH=${LPOD_PUBLISH_PATH:-"podman"}

# Use the system-wide systemd manager when running as root, otherwise the
# per-user manager backing rootless Quadlet services...
if [ "$(id -u)" -eq 0 ]; then
    SYSTEMCTL_CMD=(systemctl)
    SYSTEMD_UNIT_PATH="/etc/systemd/system"
    SYSTEMD_SCOPE="system"
    SYSTEMD_JOURNAL_SCOPE=""
else
    SYSTEMCTL_CMD=(systemctl --user)
    SYSTEMD_UNIT_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    SYSTEMD_SCOPE="user"
    SYSTEMD_JOURNAL_SCOPE="--user "
fi

# Show help when no service, or an explicit help flag, is given...
if [ $# -eq 0 ] || [ "$1" == "help" ] || [ "$1" == "-h" ] || [ "$1" == "-help" ] || [ "$1" == "--help" ]; then
    display_help
fi

# Quadlet management commands operate on rendered files or installed unit
# names, not a running service, so they're handled before the SERVICE/COMMAND
# split below...
case "$1" in
    setup)
        shift
        exec "$(dirname "${BASH_SOURCE[0]}")/lpod-setup" "$@"
        ;;

    install)
        TARGET="$2"
        shift 2

        case "$TARGET" in
            *.socket|*.timer)
                cmd_install_unit "$TARGET" "$@"
                exit $?
                ;;
        esac

        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet install "${LPOD_PUBLISH_PATH}/${TARGET}" "$@"
        ;;

    remove)
        shift

        case "$1" in
            *.socket|*.timer)
                cmd_remove_unit "$1"
                exit $?
                ;;
        esac

        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet rm "$@"
        ;;

    uninstall)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet rm --recursive "$@"
        ;;

    list)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet list "$@"
        ;;

    print)
        shift
        exec "${LPOD_PODMAN_BINARY:-podman}" quadlet print "$@"
        ;;

    reload)
        shift
        exec "${SYSTEMCTL_CMD[@]}" daemon-reload "$@"
        ;;

    idle)
        shift
        cmd_idle_dispatch "$@"
        exit $?
        ;;

    doctor)
        cmd_doctor
        exit $?
        ;;

    self-update)
        shift
        cmd_self_update "$@"
        exit $?
        ;;
esac

SERVICE="$1"
shift

if [ $# -eq 0 ]; then
    echo "${BOLD}Missing command.${NC} Usage: lpod ${SERVICE} COMMAND [options] [arguments]" >&2

    exit 1
fi

# Source the ".env" file so Laravel's environment variables are available...
# shellcheck source=/dev/null
if [ -n "$APP_ENV" ] && [ -f ./.env."$APP_ENV" ]; then
  source ./.env."$APP_ENV";
elif [ -f ./.env ]; then
  source ./.env;
fi

# Define environment variables...
export APP_PORT=${APP_PORT:-80}
export APP_USER=${APP_USER-"$(id -u)"}
export LPOD_PODMAN_BINARY=${LPOD_PODMAN_BINARY:-"podman"}

# AI agent environment variables to forward into containers...
AGENT_ENV_VARS=(
    AI_AGENT
    CLAUDECODE
    CLAUDE_CODE
    CLAUDE_CODE_IS_COWORK
    CURSOR_TRACE_ID
    CURSOR_AGENT
    GEMINI_CLI
    CODEX_SANDBOX
    CODEX_CI
    CODEX_THREAD_ID
    AUGMENT_AGENT
    OPENCODE_CLIENT
    OPENCODE
    AMP_CURRENT_THREAD_ID
    REPL_ID
    ANTIGRAVITY_AGENT
    COPILOT_MODEL
    COPILOT_ALLOW_ALL
    COPILOT_GITHUB_TOKEN
    COPILOT_CLI
    PI_CODING_AGENT
    KIRO_AGENT_PATH
)

function forward_agent_env() {
    for VAR in "${AGENT_ENV_VARS[@]}"; do
        if [ -n "${!VAR:-}" ]; then
            ARGS+=(-e "${VAR}=${!VAR}")
        fi
    done
}

# Quadlet installs a Podman container named "systemd-<unit>" for every
# "<unit>.service" it manages, to avoid clashing with unmanaged containers...
CONTAINER="systemd-${SERVICE}"

# Determine whether to allocate a pseudo-tty for "podman exec"...
if test -t 0 && test -t 1; then
    TTY_ARGS=(-it)
else
    TTY_ARGS=(-i)
fi

# Only force a user with "-u" when APP_USER is set; otherwise let the image's
# own default user apply...
APP_USER_ARGS=()
if [ -n "$APP_USER" ]; then
    APP_USER_ARGS=(-u "$APP_USER")
fi

COMMAND="$1"
shift

ARGS=()

case "$COMMAND" in
    # Start, stop, restart, and inspect the Quadlet-managed systemd service...
    up)
        exec "${SYSTEMCTL_CMD[@]}" start "${SERVICE}.service"
        ;;

    down)
        exec "${SYSTEMCTL_CMD[@]}" stop "${SERVICE}.service"
        ;;

    restart)
        exec "${SYSTEMCTL_CMD[@]}" restart "${SERVICE}.service"
        ;;

    status)
        exec "${SYSTEMCTL_CMD[@]}" status "${SERVICE}.service"
        ;;

    # Parse and set the secrets an installed quadlet needs...
    secrets)
        cmd_secrets "$SERVICE" "$@"
        exit $?
        ;;

    # Proxy PHP commands to the "php" binary on the service container...
    php)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php)
        ;;

    # Proxy vendor binary commands on the service container...
    bin)
        CMD="$1"
        shift
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" "./vendor/bin/${CMD}")
        ;;

    # Proxy arbitrary commands on the service container...
    run)
        CMD="$1"
        shift
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" "$CMD")
        ;;

    # Proxy Composer commands to the "composer" binary on the service container...
    composer)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" composer)
        ;;

    # Proxy Artisan commands to the "artisan" binary on the service container...
    artisan|art|a)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan)
        ;;

    # Proxy the "debug" command to "php artisan" on the service container with xdebug enabled...
    debug)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "XDEBUG_MODE=${XDEBUG_MODE:-debug}" -e XDEBUG_TRIGGER=1 "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan)
        ;;

    # Turn Xdebug on or off for the service's requests and workers...
    xdebug)
        cmd_xdebug "$SERVICE" "$@"
        exit $?
        ;;

    # Proxy the "test" command to the "php artisan test" Artisan command...
    test)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan test)
        ;;

    # Proxy the "phpunit" command to "php vendor/bin/phpunit"...
    phpunit)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/phpunit)
        ;;

    # Proxy the "pest" command to "php vendor/bin/pest"...
    pest)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/pest)
        ;;

    # Proxy the "pint" command to "php vendor/bin/pint"...
    pint)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php vendor/bin/pint)
        ;;

    # Proxy the "dusk" command to the "php artisan dusk" Artisan command...
    dusk)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "APP_URL=http://${CONTAINER}" -e "DUSK_DRIVER_URL=http://selenium:4444/wd/hub" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan dusk)
        ;;

    # Proxy the "dusk:fails" command to the "php artisan dusk:fails" Artisan command...
    dusk:fails)
        ARGS+=(exec "${APP_USER_ARGS[@]}" -e "APP_URL=http://${CONTAINER}" -e "DUSK_DRIVER_URL=http://selenium:4444/wd/hub" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan dusk:fails)
        ;;

    # Initiate a Laravel Tinker session within the service container...
    tinker)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" php artisan tinker)
        ;;

    # Proxy Node commands to the "node" binary on the service container...
    node)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" node)
        ;;

    # Proxy NPM commands to the "npm" binary on the service container...
    npm)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" npm)
        ;;

    # Proxy NPX commands to the "npx" binary on the service container...
    npx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" npx)
        ;;

    # Proxy PNPM commands to the "pnpm" binary on the service container...
    pnpm)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" pnpm)
        ;;

    # Proxy PNPX commands to the "pnpx" binary on the service container...
    pnpx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" pnpx)
        ;;

    # Proxy Yarn commands to the "yarn" binary on the service container...
    yarn)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" yarn)
        ;;

    # Proxy Bun commands to the "bun" binary on the service container...
    bun)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bun)
        ;;

    # Proxy Bun X commands to the "bunx" binary on the service container...
    bunx)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bunx)
        ;;

    # Initiate a Bash shell within the service container...
    shell|bash)
        ARGS+=(exec "${APP_USER_ARGS[@]}" "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bash)
        ;;

    # Initiate a root user Bash shell within the service container...
    root-shell|root-bash)
        ARGS+=(exec -u root "${TTY_ARGS[@]}")
        forward_agent_env
        ARGS+=("$CONTAINER" bash)
        ;;

    # Open the application URL in the browser...
    open)
        if ! command -v xdg-open &>/dev/null; then
            echo "xdg-open is not available. Exiting." >&2

            exit 1
        fi

        if [[ -n "$APP_PORT" && "$APP_PORT" != "80" ]]; then
            FULL_URL="${APP_URL}:${APP_PORT}"
        else
            FULL_URL="$APP_URL"
        fi

        exec xdg-open "$FULL_URL"
        ;;

    # Export the proxy's local CA certificate for trusting on the host...
    export-cert)
        OUT="${1:-$HOME/${SERVICE}.crt}"
        exec "${LPOD_PODMAN_BINARY}" cp "${CONTAINER}:/data/caddy/pki/authorities/local/root.crt" "$OUT"
        ;;

    # Unknown commands are passed through to the podman binary...
    *)
        exec "${LPOD_PODMAN_BINARY}" "$COMMAND" "$@"
        ;;
esac

# Forward the host terminal's color capability to container commands...
if [ "${ARGS[0]:-}" == "exec" ] && [ -n "${COLORTERM:-}" ]; then
    ARGS=(exec -e "COLORTERM=${COLORTERM}" "${ARGS[@]:1}")
fi

exec "${LPOD_PODMAN_BINARY}" "${ARGS[@]}" "$@"
